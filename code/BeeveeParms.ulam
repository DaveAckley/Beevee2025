/** Beevee model parameters
    \symbol MP
    \color #0f0
*/
element BeeveeParms {
  /**
     Trace NAFI execution: 0: none, 1: atomnafi, 2:function, 3: both

     \unit debug
     \range 0..3
   */
  parameter Unsigned pNAFI_TRACING = 0u;

  /**
     Extra spins at end of turn (plus fifty).  Zero: Trim 50 spins; 50: no change; 100: add 50 spins

     \unit spins
     \range 0..100
   */
  constant Unsigned cEXTRA_SPINS50 = 25u; //< Sat Apr  5 00:17:21 2025 CHANGED TO CONSTANT

  /**
     Percent of max to hit.  How close to first max to trigger as second max. Default 90%.

     \unit percent
     \range 80..100
   */
  constant Unsigned cGREEN_MAX_FRAC = 90u; //< Sat Apr  5 00:16:44 2025 CHANGED TO CONSTANT

  /**
     Grey phase multiplier.  How hard to correct grey phase errors. Zero: No corrections

     \unit sigval
     \range 0..4
   */
  constant Unsigned cGREY_MULTIPLIER = 1u; //< Sat Apr  5 00:21:47 2025 CHANGED TO CONSTANT

  /** Flip correction on mismatched states */
  constant Bool cFLIP_STATES = false;

}
