transient Font11Inconsolata14 : Font {
  virtual String getFontInfo() {
    return fontInfo[0];
  }

  virtual String getCharInfo(ASCII b) {
    if (!charExists(b)) b = '?'; // DON'T FAIL ON ZEE WEIRD BYTEZ OKAYZ?
    else if (fontInfo[b - ' ' + 1u][0] == '\0') b = fontInfo.lengthof - 1u;
    return fontInfo[b - ' ' + 1u];
  }
}
