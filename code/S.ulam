    \symbol S
    \version 267
 */
element S + DTU + QDebugUtils {
  EventWindow ew;
  Unsigned(6) mDistance;
  Void behave() {
    pR("S")&&pR(mDistance);
    if (++mDistance < 12u) ew.swap(0u,3u);
    else {
      HelloWorld hw; // Pull in fonts/HellowWorld
      TileFinder t;
      ew[0] = t.atomof;
    }
  }
}


/////
element RootSpreader + DTU {
  EventWindow ew;
  Random random;
  SN mDir;
  Unsigned(6) mSteps = Unsigned(6).maxof;
  Void behave() {
    if (mSteps-- == 0u) {
      Tissue pg;
      ew[0] = pg.atomof; // deploy
    } else {
      SN trysn = mDir;
      if (random.oneIn(8))
        trysn = (SN) random.between(1,8);
      if (ew.isAccessible(trysn) &&
          ew.isEmpty(trysn)) 
        ew.swap(0u, trysn);
    }
  }
}

