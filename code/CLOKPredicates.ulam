transient CLOKPredicate + DTU { //< Default predicate is always false (that is: == NOTA)
  Unsigned(1) mEQ = 0u;                  //< mClokState must be different than (0u) or equal to (1u) current
  Unsigned(2) mCS = cXCLOK_NOTA;         //< cCLOK_TICK, cCLOK_TOCK, cCLOK_NONE, cXCLOK_NOTA
  Bool isTrue(ClokState cs) {
    return (mEQ == 0u && cs != mCS) || (mEQ == 1u && cs == mCS);
  }
}

transient CLOKPredicates + DTU + QDebugUtils {
  ASCII mXD = ASCII.maxof; //< maximum allowable abs front center grey deviation
  CLOKPredicate mFP;            //< Front predicate
  CLOKPredicate mRP;            //< Rear predicate

  Bool isAcceptableDeviation(GTCC & gtcc) {
    mD&&pR("CKPRISAD10")&&pR(gtcc);
    ASCII xd;
    if (!gtcc.getCenterGrey(xd)) return false;
    mD&&pR("CKPRISAD11")&&pR(xd);
    Unsigned dev = abs((Int) xd - 127);
    Bool ret = dev < mXD;
    mD&&pR("CKPRISAD12")&&pR(dev)&&pR(ret);
    return ret;
  }

  Bool isTrue(GTCC & gtcc) {
    takeDebug(gtcc);
    mD&&pR("CKPRIST10")&&pR(self);
    Bool ad = isAcceptableDeviation(gtcc);
    mD&&pR("CKPRIST11")&&pR(ad);
    Bool ret = ad &&
      mFP.isTrue(gtcc.mNewCloks[0]) && 
      mRP.isTrue(gtcc.mNewCloks[1]);
    mD&&pR("CKPRIST12")&&pR(ret);
    return ret;
  }

  Bool isFailed(GTCC & gtcc) { // XXXXX WRITEME
    return false;
  }
}

