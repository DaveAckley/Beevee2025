// New go for grip info for xblocks and perhaps beyond

quark Grips + DTU + Fail { //< grip map
  virtual Unsigned getGripsCount() ;
  virtual ClassId getGripRoutingClassIdFromIndex(Unsigned gripidx) ;

  //// Grips SERVICES
  Atom getGripRoutingInstance(Unsigned gripidx) {
    Unsigned cnt = getGripsCount();
    if (gripidx >= cnt) fail(__FILE__,__LINE__);
    ClassUtils cu;
    ClassId cid = getGripRoutingClassIdFromIndex(gripidx);
    if (!cu.isBase(cid, GripRouting.classidof)) 
      fail(__FILE__,__LINE__);
    Int etype = cu.getElementType(cid);
    if (etype < 0)
      fail(__FILE__,__LINE__);
    AtomUtils au;
    Atom a = au.new(etype);
    return a;
    
  }
}

quark GripRouting + DTU + Fail {
  virtual String getGripName() ;
  virtual Unsigned getDestCount(TapIdx src) ;
  virtual TapIdx getDest(TapIdx src, Unsigned idx) ;
  virtual Bool mapSig(TapIdx src, TapIdx dst, Int input, Int & output) {
    output = input;
    return true;
  }
  //XXX virtual Unsigned getSrcCount(TapIdx dest) ;
  //XXX virtual TapIdx getSrc(TapIdx dest, Unsigned idx) ;
  
  //// GripRouting SERVICES
  Bool switchSig(TapIdx src, TapIdx dest) {
    Unsigned dc = getDestCount(src);
    for (Unsigned idx = 0u; idx < dc; ++idx) {
      if (getDest(src,idx) == dest) return true;
    }
    return false;
  }
}

// 'element GripRouting_NORED' etc generated by
// makeBeeveeXBlockSources.py
/* ASPIRATIONAL CODE ONLY
element GripRouting_NORED : GripRouting {
  //// GripRouting API
  @Override String getGripName() { return "NORED"; }
  @Override Unsigned getDestCount(TapIdx src) {
    return cFIRST_DEST_INDEX[src+1u] - cFIRST_DEST_INDEX[src];
  }
  @Override TapIdx getDest(TapIdx src, Unsigned idx) {
    if (idx >= getDestCount(src)) fail(__FILE__,__LINE__);
    return cALL_DESTS[cFIRST_DEST_INDEX[src] + idx];
  }
  //@Override Unsigned getSrcCount(TapIdx dest) ;
  //@Override TapIdx getSrc(TapIdx dest, Unsigned idx) ;

  constant Unsigned cFIRST_DEST_INDEX[] = {
    0u, //< 0 start idx of dests for BVPITCH
    0u, //< 1 start idx of dests for BVROLL
    0u, //< 2 start idx of dests for SFLG
    2u, //< 3 start idx of dests for SFCG
    ..
    82u, //< 45 start idx of dests for GTCC
    82u, //< 46 start idx of dests for OCLK
    82u, // end of dests
  };
  constant TapIdx cALL_DESTS[] = {
    cTAPIDX_FOO1, //< 0 dest 0 for SFLG
    cTAPIDX_FOO2, //< 1 dest 1 for SFLG
    cTAPIDX_BARS, //< 2 dest 0 for SFCG
    ..
  };
}
*/
