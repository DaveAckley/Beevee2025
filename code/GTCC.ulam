/** single Grip Tile Clock Counter. Count tile edges while in current grip.
    \symbol GT
    \color #c3e
 */
element GTCC : HOpUnary + Grip + Fail {

  //SpikeLeft mStateMachine;
  //Corral mStateMachine;
  TRAKtor mStateMachine;
  typedef RXTimer(4u,15u,2u) SMTimer;
  SMTimer mTimerForStateMachine; 

  Void setSMTimer(Unsigned u) { mTimerForStateMachine.set((SMTimer.Counter) u); }
  Unsigned getSMTimer() { return mTimerForStateMachine.current(); }
  Bool isSMTimerDone() { return mTimerForStateMachine.alarm(); }
  Bool incrSMTimer() { return mTimerForStateMachine.countAlarm(); }

  typedef Unsigned(XBarSpace2D.cGRIPBITS) MyGripVal;
  MyGripVal mLastGrip = MyGripVal.maxof;

  typedef XTimer(2u,3u,2u) ChangeTimer; //< for debouncing edges
  ChangeTimer mEdgeTimer[2]; // [0] front, [1] back
  ChangeTimer mRegripTimer;

  typedef XTimer(2u,3u,20u) SlowChangeTimer; //< for giving up on tracking
  SlowChangeTimer mHardOfflineFrontTimer;

  typedef RXTimer(3u,6u,1u) GreyTimer; //< for invalidating center grey
  ASCII mCenterGrey;
  ChangeTimer mCenterGreyTimer;
  Void writeCenterGrey(ASCII val) {
    mCenterGrey = val;
    mCenterGreyTimer.reset();
  }
  Void ageCenterGrey() {
    mCenterGreyTimer.count();
  }
  Bool getCenterGrey(ASCII & value) {
    if (mCenterGreyTimer.alarm()) return false;
    value = mCenterGrey;
    return true;
  }

  constant ClokState cCLOK_NONE = GreyClok.cCLOK_NONE;
  ClokState mNewCloks[2] = {cCLOK_NONE, cCLOK_NONE}; // [0] front, [1] rear
  ClokState mLastCloks[2] = {cCLOK_NONE, cCLOK_NONE};

  typedef Unsigned(6u) TileCount;
  
  Void behave() {

    Int speed = Int.maxof;
    /// HACK CHECK FOR LOCZ
    {
      EventWindow ew;
      SN lsn = SN.maxof;
      for (SN sn = 1u; sn <= 40u; ++sn) {
        if (!ew.isAccessible(sn)) continue;
        if (ew[sn] is LOCZ) {
          lsn = sn;
          break;
        }
      }
      if (lsn != SN.maxof) {
        LOCZ & l = (LOCZ &) ew[lsn];
        if (l.mSpeed8Valid)
          speed = l.mSpeed8 - 8;
      }
    }

    /// RUN OFFLINE TIMER
    MotorCmd mc = mStateMachine.makeCurrentMotorCmd();
    if (!mc.mSpeedNotWheel || mLastCloks[0] != GreyClok.cCLOK_NONE) // if in wheel mode or on the line
      mHardOfflineFrontTimer.reset();                               // then no offline count
    else {
      if (speed == Int.maxof || speed < 0) speed = 1; // WTF? Assume super slow?
      Random random;
      Bool was = mHardOfflineFrontTimer.alarm();
      if (random.oddsOf(speed*speed,25*25)) // Slow the count at speeds<25
        mHardOfflineFrontTimer.count();
      if (was != mHardOfflineFrontTimer.alarm())
        pR("!!HARDOFFLINETIMER CHANGE!!")&&pR(speed);
    }

    /// RUN GRIP TIMER
    Unsigned gripnum = getGripNumber(); // our 'official' current grip
    if (gripnum == mLastGrip) mRegripTimer.reset();
    else if (mRegripTimer.countAlarm()) {
      mLastGrip = (MyGripVal) gripnum;
      mD&&pR("GTCCX12")&&pR(self);
      mStateMachine.reset();
    }

    /// RUN EDGE TIMERS
    ageCenterGrey();

    for (Unsigned i = 0u; i < 2u; ++i) {
      if (mNewCloks[i] == mLastCloks[i]) mEdgeTimer[i].reset();
      else if (mNewCloks[i] != GreyClok.cCLOK_NONE && mEdgeTimer[i].countAlarm()) {
        if (mLastCloks[i] != GreyClok.cCLOK_NONE)
          mStateMachine.clockEdge(self, i==0u, mNewCloks[i]);
        mLastCloks[i] = mNewCloks[i];
      }
    }

    /// LET MACHINE THINK 
    mStateMachine.step(self);

    /// SEND A SIGNAL IF WE CAN
    {
      ASCII sig = mStateMachine.makeSig();
      if (trySendSigViaTAP(sig,TRAKPD.classidof))
        mStateMachine.recordSigSent();
    }

    /// RECV A GREY SIGNAL IF WE CAN
    {
      SN tpdsn = findMatchingAxonEndWith(BeeveeBIMXBlock.cTAPIDX_TRAKPD);
      if (tpdsn != SN.maxof) {
        EventWindow ew;
        AxonEnd & ae = (AxonEnd&) ew[tpdsn];
        SlotSig sig;
        if (tryRecvSig(ae, sig)) {
          mD&&pR("GTCCGREYIN10")&&pR(sig);
          writeCenterGrey(sig.mValue);
        }
      }
    }
    /// AND DO NORMAL BUSINESS
    super.behave();
  }

  //// HOpArgsT API
  @Override
  virtual Int sigToSlot(SlotSig sig, Unsigned gripnum) {
    mD&&pR("GTCS2S10")&&pR(self);

    BeeveeBIMXBlock bim;
    TapIdx idx = sig.mSource;
    if (idx == bim.getTapIdxFromClassId(CLOK.classidof)) // clock edges
      return 0;             

    if (idx == bim.getTapIdxFromClassId(LOCZ.classidof)) // speed reports
      return 0;             
    
    return Int.maxof;           // or don't want
  }

  @Override
  virtual Bool execute(SlotSig & result) {
    mD&&pR("GTCCX10")&&pR(self);
    SlotSig & sig = getSlotSig(0);

    if (!sig.isOccupied()) return false;
    mD&&pR("GTCCX1010")&&pR(self);

    BeeveeBIMXBlock bim;
    TapIdx sigsrc = sig.mSource;

    if (sigsrc == bim.getTapIdxFromClassId(CLOK.classidof)) {
      /// PICK UP CLOCK SIG
      Unsigned val = sig.getValueRaw();
      for (Unsigned i = 0u; i < 2u; ++i) {
        mNewCloks[i] = (ClokState) (val%4u);
        val = val/4u;
      }
      return false;
    }

    { Bool oldmd = mD;
      mD = true;
      mD&&pR("GTCCX11")&&pR(self)&&pR(sig);
      mD = oldmd;
    }
    return false; 
  }
}

