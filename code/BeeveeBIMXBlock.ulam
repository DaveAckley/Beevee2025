  }; // cFIRST_DEST_INDEX

  Int sigFuncStalkMap (Int i) {
     Int o = i;
     { o = 1; }
     return o;
 }


  @Override Bool mapSig(TapIdx src, TapIdx dst, Int input, Int & output) {
    output = mapAllSigs(src,dst,input);
    return true;
  }

  Int mapAllSigs(TapIdx src, TapIdx dst, Int i) {
    Int o = i;
    
  if (src == BeeveeBIMXBlock.cTAPIDX_TOCK) {
    if (dst == BeeveeBIMXBlock.cTAPIDX_MLEY) {
      return sigFuncStalkMap(i);
    }

    if (dst == BeeveeBIMXBlock.cTAPIDX_MREY) {
      return sigFuncStalkMap(i);
    }
    return o;
  }
  return o;
  }

} // GripRouting_TRACK

quark CodeConstants + DTU + Fail + QDebugUtils {

  constant Int cRAM[89] = {
    oCALL,               //   0 fake for returning to top level
    oENTER,              //   1 fTRUE: always true
    1,                   //   2 
    oRETURN,             //   3 From: fTRUE
    oENTER,              //   4 fFALSE: always false
    0,                   //   5 
    oRETURN,             //   6 From: fFALSE
    oENTER,              //   7 fOFFLINE_FRONT: true on front not tick and not tock
    oCLOK_FRONT,         //   8 
    cCLOK_NONE,          //   9 
    oCMP_EQ,             //  10 
    oRETURN,             //  11 From: fOFFLINE_FRONT
    oENTER,              //  12 fHARD_OFFLINE_FRONT: true on front not tick and not tock for quite a consecutive while
    oHARD_OFFLINE_FRONT, //  13 
    oRETURN,             //  14 From: fHARD_OFFLINE_FRONT
    oENTER,              //  15 fCLOK_TICK_FRONT: true on front tick
    oCLOK_FRONT,         //  16 
    cCLOK_TICK,          //  17 
    oCMP_EQ,             //  18 
    oRETURN,             //  19 From: fCLOK_TICK_FRONT
    oENTER,              //  20 fCLOK_TOCK_FRONT: true on front tock
    oCLOK_FRONT,         //  21 
    cCLOK_TOCK,          //  22 
    oCMP_EQ,             //  23 
    oRETURN,             //  24 From: fCLOK_TOCK_FRONT
    oENTER,              //  25 fCLOK_EDGE_FRONT: true on front tick or front tock
    oCLOK_FRONT,         //  26 
    cCLOK_NONE,          //  27 
    oCMP_NE,             //  28 
    oRETURN,             //  29 From: fCLOK_EDGE_FRONT
    oENTER,              //  30 fCLOK_EDGE_REAR: true on rear tick or rear tock
    oCLOK_REAR,          //  31 
    cCLOK_NONE,          //  32 
    oCMP_NE,             //  33 
    oRETURN,             //  34 From: fCLOK_EDGE_REAR
    oENTER,              //  35 fSMALL_GREY_DEV: true on small deviation, meaning 128+-25 == 103..153
    oGREY_FCTR,          //  36 
    oDUP,                //  37 
    153,                 //  38 
    oCMP_LE,             //  39 
    oSWAP,               //  40 
    103,                 //  41 
    oCMP_GE,             //  42 
    oAND,                //  43 
    oRETURN,             //  44 From: fSMALL_GREY_DEV
    oENTER,              //  45 fCLOK_EDGE_TUNED: true on front edge and small deviation
    fCLOK_EDGE_FRONT,    //  46 
    oCALL,               //  47 
    fSMALL_GREY_DEV,     //  48 
    oCALL,               //  49 
    oAND,                //  50 
    oRETURN,             //  51 From: fCLOK_EDGE_TUNED
    oENTER,              //  52 fSAME_EDGE: true if front and back on tick or tock
    fCLOK_EDGE_FRONT,    //  53 
    oCALL,               //  54 
    oCLOK_REAR,          //  55 
    oCLOK_FRONT,         //  56 
    oCMP_EQ,             //  57 
    oAND,                //  58 
    oRETURN,             //  59 From: fSAME_EDGE
    oENTER,              //  60 fDIFF_EDGE: true if front and back on tick and tock or tock and tick
    fCLOK_EDGE_FRONT,    //  61 
    oCALL,               //  62 
    fCLOK_EDGE_REAR,     //  63 
    oCALL,               //  64 
    oAND,                //  65 
    oCLOK_REAR,          //  66 
    oCLOK_FRONT,         //  67 
    oCMP_NE,             //  68 
    oAND,                //  69 
    oRETURN,             //  70 From: fDIFF_EDGE
    oENTER,              //  71 fSTOPPED: true if valid speed is 0
    oVALID_SPEED,        //  72 
    oCUR_SPEED,          //  73 
    0,                   //  74 
    oCMP_EQ,             //  75 
    oAND,                //  76 
    oRETURN,             //  77 From: fSTOPPED
    oENTER,              //  78 fSTOP_DRIVE_SLOW: done if hard offline, or red warning
    oHARD_OFFLINE_FRONT, //  79 
    oRED_WARNING_TRACK,  //  80 
    oOR,                 //  81 
    oRETURN,             //  82 From: fSTOP_DRIVE_SLOW
    oENTER,              //  83 fSTOP_DRIVE_FAST: done if hard offline, or red prewarning, or red warning
    fSTOP_DRIVE_SLOW,    //  84 
    oCALL,               //  85 
    oRED_PRE_WARNING,    //  86 
    oOR,                 //  87 
    oRETURN,             //  88 From: fSTOP_DRIVE_FAST
  }; // constant Int cRAM[89]

  //// FUNCTION ADDRS
  constant Int fTRUE                =   1;   // always true
  constant Int fFALSE               =   4;   // always false
  constant Int fOFFLINE_FRONT       =   7;   // true on front not tick and not tock
  constant Int fHARD_OFFLINE_FRONT  =  12;   // true on front not tick and not tock for quite a consecutive while
  constant Int fCLOK_TICK_FRONT     =  15;   // true on front tick
  constant Int fCLOK_TOCK_FRONT     =  20;   // true on front tock
  constant Int fCLOK_EDGE_FRONT     =  25;   // true on front tick or front tock
  constant Int fCLOK_EDGE_REAR      =  30;   // true on rear tick or rear tock
  constant Int fSMALL_GREY_DEV      =  35;   // true on small deviation, meaning 128+-25 == 103..153
  constant Int fCLOK_EDGE_TUNED     =  45;   // true on front edge and small deviation
  constant Int fSAME_EDGE           =  52;   // true if front and back on tick or tock
  constant Int fDIFF_EDGE           =  60;   // true if front and back on tick and tock or tock and tick
  constant Int fSTOPPED             =  71;   // true if valid speed is 0
  constant Int fSTOP_DRIVE_SLOW     =  78;   // done if hard offline, or red warning
  constant Int fSTOP_DRIVE_FAST     =  83;   // done if hard offline, or red prewarning, or red warning
  //// END FUNCTION ADDRS

  String nameOfFunction(Int funcaddr) {
    String ret = nameOfFunctionOrNull(funcaddr);
    if (!(Bool) ret) ret = "<ENOMETH>";
    return ret;
  }
        
  String nameOfFunctionOrNull(Int funcaddr) {
    if (funcaddr == fTRUE) return "fTRUE";
    if (funcaddr == fFALSE) return "fFALSE";
    if (funcaddr == fOFFLINE_FRONT) return "fOFFLINE_FRONT";
    if (funcaddr == fHARD_OFFLINE_FRONT) return "fHARD_OFFLINE_FRONT";
    if (funcaddr == fCLOK_TICK_FRONT) return "fCLOK_TICK_FRONT";
    if (funcaddr == fCLOK_TOCK_FRONT) return "fCLOK_TOCK_FRONT";
    if (funcaddr == fCLOK_EDGE_FRONT) return "fCLOK_EDGE_FRONT";
    if (funcaddr == fCLOK_EDGE_REAR) return "fCLOK_EDGE_REAR";
    if (funcaddr == fSMALL_GREY_DEV) return "fSMALL_GREY_DEV";
    if (funcaddr == fCLOK_EDGE_TUNED) return "fCLOK_EDGE_TUNED";
    if (funcaddr == fSAME_EDGE) return "fSAME_EDGE";
    if (funcaddr == fDIFF_EDGE) return "fDIFF_EDGE";
    if (funcaddr == fSTOPPED) return "fSTOPPED";
    if (funcaddr == fSTOP_DRIVE_SLOW) return "fSTOP_DRIVE_SLOW";
    if (funcaddr == fSTOP_DRIVE_FAST) return "fSTOP_DRIVE_FAST";

    String null;
    return null;
  }

  //// OPERATORS
  constant Int cMIN_OP_VAL = -2000000000;
        
  constant Int oNOP                 = cMIN_OP_VAL + 1;    // 
  constant Int oDUP                 = oNOP + 1;           // 
  constant Int oDROP                = oDUP + 1;           // 
  constant Int oSWAP                = oDROP + 1;          // 
  constant Int oENTER               = oSWAP + 1;          // 
  constant Int oRETURN              = oENTER + 1;         // 
  constant Int oCALL                = oRETURN + 1;        // 
  constant Int oHARD_OFFLINE_FRONT  = oCALL + 1;          // 
  constant Int oCLOK_FRONT          = oHARD_OFFLINE_FRONT + 1;// 
  constant Int oCLOK_REAR           = oCLOK_FRONT + 1;    // 
  constant Int oGREY_FCTR           = oCLOK_REAR + 1;     // 
  constant Int oVALID_SPEED         = oGREY_FCTR + 1;     // 
  constant Int oCUR_SPEED           = oVALID_SPEED + 1;   // 
  constant Int oVALID_HEAD          = oCUR_SPEED + 1;     // 
  constant Int oCUR_HEAD            = oVALID_HEAD + 1;    // 
  constant Int oRED_WARNING_TRACK   = oCUR_HEAD + 1;      // 
  constant Int oRED_PRE_WARNING     = oRED_WARNING_TRACK + 1;// 
  constant Int oGREEN_LEVEL         = oRED_PRE_WARNING + 1;// 
  constant Int oCMP_EQ              = oGREEN_LEVEL + 1;   // 
  constant Int oCMP_NE              = oCMP_EQ + 1;        // 
  constant Int oCMP_LT              = oCMP_NE + 1;        // 
  constant Int oCMP_LE              = oCMP_LT + 1;        // 
  constant Int oCMP_GT              = oCMP_LE + 1;        // 
  constant Int oCMP_GE              = oCMP_GT + 1;        // 
  constant Int oMAX                 = oCMP_GE + 1;        // 
  constant Int oMIN                 = oMAX + 1;           // 
  constant Int oADD                 = oMIN + 1;           // 
  constant Int oSUB                 = oADD + 1;           // 
  constant Int oMUL                 = oSUB + 1;           // 
  constant Int oDIV                 = oMUL + 1;           // 
  constant Int oAND                 = oDIV + 1;           // 
  constant Int oOR                  = oAND + 1;           // 
  constant Int oNOT                 = oOR + 1;            // 
  constant Int oNEG                 = oNOT + 1;           // 
  constant Int oLAST_OP_USED = oNEG;
  //// END OPERATORS

  //// OPERATOR NAMES
  constant String cOPERATOR_NAMES[] = {
  "oNOP", // 
  "oDUP", // 
  "oDROP", // 
  "oSWAP", // 
  "oENTER", // 
  "oRETURN", // 
  "oCALL", // 
  "oHARD_OFFLINE_FRONT", // 
  "oCLOK_FRONT", // 
  "oCLOK_REAR", // 
  "oGREY_FCTR", // 
  "oVALID_SPEED", // 
  "oCUR_SPEED", // 
  "oVALID_HEAD", // 
  "oCUR_HEAD", // 
  "oRED_WARNING_TRACK", // 
  "oRED_PRE_WARNING", // 
  "oGREEN_LEVEL", // 
  "oCMP_EQ", // 
  "oCMP_NE", // 
  "oCMP_LT", // 
  "oCMP_LE", // 
  "oCMP_GT", // 
  "oCMP_GE", // 
  "oMAX", // 
  "oMIN", // 
  "oADD", // 
  "oSUB", // 
  "oMUL", // 
  "oDIV", // 
  "oAND", // 
  "oOR", // 
  "oNOT", // 
  "oNEG", // 

 };  //// END cOPERATOR_NAMES[]

  String nameOfOperatorOrNull(Int op) {
    Unsigned idx = (Unsigned) (op - cMIN_OP_VAL - 1);
    String ret; // null to start
    if (idx < cOPERATOR_NAMES.lengthof) ret = cOPERATOR_NAMES[idx];
    return ret;
 }
  String nameOfOperator(Int op) {
    String ret = nameOfOperatorOrNull(op);
    if (!(Bool) ret) ret = "#";
    return ret;
 }

  Bool readRAM(Int addr, Int & res) {
    if (addr < 0 || addr >= cRAM.lengthof) return false;
    res = cRAM[addr];
    return true;
  }

  Bool setPC(Int & pc, Int newval) {
    if (newval < 0 || newval >= cRAM.lengthof) return false;
    pc = newval;
    return true;
  }

  //// OPERATOR EVAL
  Bool evaluateThisOperatorOnly(Int o, Function & s, GTCC & g, LOCZ & l, TRAKtor & t) {
    mD&&pR("ETOPO10")&&pR(o);
    if (o >= cFOC_MIN_IMMEDIATE && o <= cFOC_MAX_IMMEDIATE) {
      Bool ret = s.push(o);
      mD&&s.pRStack("ETOPO11");
      return ret;
    }
    Int v[3]; // temps
    mD&&pR("ETOPO12")&&pR(nameOfOperator(o));
    mD&&s.pRStack("ETOPO13");
    which(o) {
    case oNOP: { return true; }
    case oDUP: { return s.pop(v[0]) && s.push(v[0]) && s.push(v[0]); }
    case oDROP: { return s.pop(v[0]); }
    case oSWAP: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[1]) && s.push(v[0]); }
    case oHARD_OFFLINE_FRONT: { return s.push(g.mHardOfflineFrontTimer.alarm() ? 1 : 0); }
    case oCLOK_FRONT: { return s.push(g.mNewCloks[0]); }
    case oCLOK_REAR: { return s.push(g.mNewCloks[1]); }
    case oGREY_FCTR: { return s.push(g.mCenterGrey); }
    case oVALID_SPEED: { return s.push(l.mSpeed8Valid ? 1 : 0); }
    case oCUR_SPEED: { return s.push(l.mSpeed8 - 8); }
    case oVALID_HEAD: { return s.push(l.mHeadingValid ? 1 : 0); }
    case oCUR_HEAD: { return s.push(l.mHeading); }
    case oRED_WARNING_TRACK: { return s.push(l.mWarningTrack); }
    case oRED_PRE_WARNING: { return s.push(l.mPreWarning); }
    case oGREEN_LEVEL: { return s.push(l.mGreenLevel); }
    case oCMP_EQ: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] == v[1]); }
    case oCMP_NE: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] != v[1]); }
    case oCMP_LT: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] < v[1]); }
    case oCMP_LE: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] <= v[1]); }
    case oCMP_GT: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] > v[1]); }
    case oCMP_GE: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] >= v[1]); }
    case oMAX: { return s.pop(v[1]) && s.pop(v[0]) && s.push(max(v[0],v[1])); }
    case oMIN: { return s.pop(v[1]) && s.pop(v[0]) && s.push(min(v[0],v[1])); }
    case oADD: { return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]+v[1])); }
    case oSUB: { return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]-v[1])); }
    case oMUL: { return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]*v[1])); }
    case oDIV: { return s.pop(v[1]) && s.pop(v[0]) && v[1] != 0 &&s.push(s.clampImmed(v[0]/v[1])); }
    case oAND: { return s.pop(v[1]) && s.pop(v[0]) &&s.push(v[0] != 0 && v[1] != 0 ? 1 : 0); }
    case oOR: { return s.pop(v[1]) && s.pop(v[0]) &&s.push(v[0] != 0 || v[1] != 0 ? 1 : 0); }
    case oNOT: { return s.pop(v[0]) && s.push(v[0] == 0 ? 1 : 0); }
    case oNEG: { return s.pop(v[0]) && s.push(s.clampImmed(-v[0])); }
    }
    s.pRStack("ETOPOMISS")&&pR(o)&&pR(nameOfOperator(o));
    fail(__FILE__,__LINE__); 
    return false; // NOT REACHED
  }

  Bool isSpecialOp(Int o) {
    return o == oCALL ||
           o == oENTER ||
           o == oRETURN;
  }

  Bool evaluateOperator(Int & pc, Function & s, GTCC & g, LOCZ & l, TRAKtor & t) {
    mD&&pR("EVLOP10")&&pR(pc);
    Int v[3]; // temps
    Int o;
    if (!readRAM(pc,o)) return false;
    pc++;
    mD&&s.pRStack("EVLOP12")&&pR(nameOfOperator(o));
    /// handle 'special ops' here
    which(o) {
    case oENTER: { return true; }
    case oRETURN: {  // FUNCTION RETURN: stack is [RETVAL RETADDR ...]
      return //s.pRStack("RET=") &&   // DEBUG
             s.pop(v[0])            // v0 <- retval
          && s.pop(v[1])            // v1 <- retaddr
          && readRAM(v[1] - 1,v[2]) // v2 <- cRAM[retaddr-1]
          && v[2] == oCALL          // [retaddr-1] is a call
          && s.push(v[0])           // restash retval
          && setPC(pc,v[1])         // jump to retaddr
  ; }
    case oCALL: {  // FUNCTION CALL: stack is [FUNCADDR ...]
      return s.pop(v[0])            // v0 <- funcaddr
          //&& s.pRStack(nameOfFunction(v[0])) // DEBUG
          && readRAM(v[0],v[1])     // v1 <- cRAM[funcaddr]
          && v[1] == oENTER         // calladdr is func entry point
          && s.push(pc)             // save retaddr
          && setPC(pc,v[0] + 1)     // jump to funcaddr + 1
  ; }

    /// else dish to general case
    otherwise: { return evaluateThisOperatorOnly(o, s, g, l, t); }
    }
    return false; // NOT REACHED
  } // OPERATOR EVAL


  typedef Unsigned(5) TRAKt; //< traktor act codes
  //// TRAKt CODE NUMBERS
  constant TRAKt cTRA_FIND_LINE_LEFT            =   0u;
  constant TRAKt cTRA_FIND_LINE_RIGHT           =   1u;
  constant TRAKt cTRA_TUNE_LINE                 =   2u;
  constant TRAKt cTRA_DRESS_LINE_FWD            =   3u;
  constant TRAKt cTRA_DRESS_LINE_REV            =   4u;
  constant TRAKt cTRA_TURN_LEFT_TO_TICK         =   5u;
  constant TRAKt cTRA_TURN_LEFT_TO_TOCK         =   6u;
  constant TRAKt cTRA_TURN_RIGHT_TO_TICK        =   7u;
  constant TRAKt cTRA_TURN_RIGHT_TO_TOCK        =   8u;
  constant TRAKt cTRA_FULL_STOP                 =   9u;
  constant TRAKt cTRA_DRIVE_SLOW                =  10u;
  constant TRAKt cTRA_DRIVE_FAST                =  11u;
  constant TRAKt cTRA_ROLLING_STOP              =  12u;
  constant TRAKt cTRA_EMERGENCY_STOP            =  13u;
  //// END TRAKt CODE NUMBERS
  constant Unsigned cTRA_TRAKTNUM_COUNT = 14u;

  //// TRAKt CODE NAMES       
  constant String cTRAKT_NAMES[cTRA_TRAKTNUM_COUNT] = {
    "cTRA_FIND_LINE_LEFT.0",       //   0
    "cTRA_FIND_LINE_RIGHT.1",      //   1
    "cTRA_TUNE_LINE.2",            //   2
    "cTRA_DRESS_LINE_FWD.3",       //   3
    "cTRA_DRESS_LINE_REV.4",       //   4
    "cTRA_TURN_LEFT_TO_TICK.5",    //   5
    "cTRA_TURN_LEFT_TO_TOCK.6",    //   6
    "cTRA_TURN_RIGHT_TO_TICK.7",   //   7
    "cTRA_TURN_RIGHT_TO_TOCK.8",   //   8
    "cTRA_FULL_STOP.9",            //   9
    "cTRA_DRIVE_SLOW.10",          //  10
    "cTRA_DRIVE_FAST.11",          //  11
    "cTRA_ROLLING_STOP.12",        //  12
    "cTRA_EMERGENCY_STOP.13",      //  13
  }; // cTRAKT_NAMES

  String nameOfTRAKtOrNull(TRAKt t) {
    String ret;
    if (t < cTRA_TRAKTNUM_COUNT) ret = cTRAKT_NAMES[t];
    return ret;
  }
  String nameOfTRAKt(TRAKt t) {
    String ret = nameOfTRAKtOrNull(t);
    if (!(Bool) ret) ret = "cTRAUNKNOWN";
    return ret;
  }

