  constant TRAKt tTURN_LEFT_TO_TOCK             =  14u;
  constant TRAKt tTURN_RIGHT_TO_TICK            =  15u;
  constant TRAKt tTURN_RIGHT_TO_TOCK            =  16u;
  constant TRAKt tFULL_STOP                     =  17u;
  constant TRAKt tROLLING_STOP                  =  18u;
  constant TRAKt tDRIVE_SLOW                    =  19u;
  constant TRAKt tDRIVE_FAST                    =  20u;
  constant TRAKt tFORWARD_TO_TICK               =  21u;
