  String nameOfOperatorOrNull(Int op) {
    Unsigned idx = (Unsigned) (op - cMIN_OP_VAL - 1);
    String ret; // null to start
    if (idx < cOPERATOR_NAMES.lengthof) ret = cOPERATOR_NAMES[idx];
    return ret;
 }
  String nameOfOperator(Int op) {
    String ret = nameOfOperatorOrNull(op);
    if (!(Bool) ret) ret = "#";
    return ret;
 }

  Bool readRAM(Int addr, Int & res) {
    if (addr < 0 || addr >= cRAM.lengthof) return false;
    res = cRAM[addr];
    return true;
  }

  typedef Unsigned(5) TRAKt; //< traktor act codes
  //// TRAKt CODE NUMBERS
  constant TRAKt tBLOCK_FOR_SMTIMER             =   0u;
  constant TRAKt tFIND_EAST_RIGHT               =   1u;
  constant TRAKt tFIND_EAST_LEFT                =   2u;
  constant TRAKt tFIND_LINE_LEFT                =   3u;
  constant TRAKt tFIND_LINE_RIGHT               =   4u;
  constant TRAKt tTUNE_LINE                     =   5u;
  constant TRAKt tDRESS_LINE_FWD                =   6u;
  constant TRAKt tDRESS_LINE_REV                =   7u;
  constant TRAKt tTURN_LEFT_TO_TICK             =   8u;
  constant TRAKt tTURN_LEFT_TO_TOCK             =   9u;
  constant TRAKt tTURN_RIGHT_TO_TICK            =  10u;
  constant TRAKt tTURN_RIGHT_TO_TOCK            =  11u;
  constant TRAKt tFULL_STOP                     =  12u;
  constant TRAKt tDRIVE_SLOW                    =  13u;
  constant TRAKt tDRIVE_FAST                    =  14u;
  constant TRAKt tROLLING_STOP                  =  15u;
  constant TRAKt tFORWARD_TO_TICK               =  16u;
  constant TRAKt tFORWARD_TO_TOCK               =  17u;
  constant TRAKt tEMERGENCY_STOP                =  18u;
  //// END TRAKt CODE NUMBERS
  constant Unsigned cTRA_TRAKTNUM_COUNT = 19u;

  //// TRAKt CODE NAMES       
  constant String cTRAKT_NAMES[cTRA_TRAKTNUM_COUNT] = {
    "tBLOCK_FOR_SMTIMER.0",        //   0
    "tFIND_EAST_RIGHT.1",          //   1
    "tFIND_EAST_LEFT.2",           //   2
    "tFIND_LINE_LEFT.3",           //   3
    "tFIND_LINE_RIGHT.4",          //   4
    "tTUNE_LINE.5",                //   5
    "tDRESS_LINE_FWD.6",           //   6
    "tDRESS_LINE_REV.7",           //   7
    "tTURN_LEFT_TO_TICK.8",        //   8
    "tTURN_LEFT_TO_TOCK.9",        //   9
    "tTURN_RIGHT_TO_TICK.10",      //  10
    "tTURN_RIGHT_TO_TOCK.11",      //  11
    "tFULL_STOP.12",               //  12
    "tDRIVE_SLOW.13",              //  13
    "tDRIVE_FAST.14",              //  14
    "tROLLING_STOP.15",            //  15
    "tFORWARD_TO_TICK.16",         //  16
    "tFORWARD_TO_TOCK.17",         //  17
    "tEMERGENCY_STOP.18",          //  18
  }; // cTRAKT_NAMES

  String nameOfTRAKtOrNull(TRAKt t) {
    String ret;
    if (t < cTRA_TRAKTNUM_COUNT) ret = cTRAKT_NAMES[t];
    return ret;
  }
  String nameOfTRAKt(TRAKt t) {
    String ret = nameOfTRAKtOrNull(t);
    if (!(Bool) ret) ret = "cTRAUNKNOWN";
    return ret;
  }


} // CodeConstants


quark CodeMethods : CodeConstants + QDebugUtils {
  //// CONSTANT MotorCmd DECLARATIONS
  constant MotorCmd cTRAKT_MOTORCMDS[cTRA_TRAKTNUM_COUNT] = {
   {  .mTRAKtName = "tBLOCK_FOR_SMTIMER",
      .mTRAKtNumber = 0u,
      .mSpeedNotWheel = false,
      .mSpeed1 = 0,                   // left
      .mSpeed2 = 0,                   // right
      .mFuncNotOp = true,
      .mDoneCode = fINCR_TIMER_CHECK,
   },
   {  .mTRAKtName = "tFIND_EAST_RIGHT",
      .mTRAKtNumber = 1u,
      .mSpeedNotWheel = false,
      .mSpeed1 = 3,                   // left
      .mSpeed2 = -4,                  // right
      .mFuncNotOp = true,
      .mDoneCode = fEAST_AND_ON_LINE,
   },
   {  .mTRAKtName = "tFIND_EAST_LEFT",
      .mTRAKtNumber = 2u,
      .mSpeedNotWheel = false,
      .mSpeed1 = -4,                  // left
      .mSpeed2 = 3,                   // right
      .mFuncNotOp = true,
      .mDoneCode = fEAST_AND_ON_LINE,
   },
   {  .mTRAKtName = "tFIND_LINE_LEFT",
