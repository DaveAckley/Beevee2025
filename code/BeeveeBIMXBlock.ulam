@Concrete
quark BeeveeGrips : Grips {
  constant Unsigned cGRIPIDX_HUNTR = 0u; 
  constant Unsigned cGRIPIDX_BV2BY = 1u; 
  constant Unsigned cGRIPIDX_NORED = 2u; 
  constant Unsigned cGRIPIDX_TRAVL = 3u; 
  constant Unsigned cGRIPIDX_TRACK = 4u; 

  constant ClassId cALL_GRIPS[] = {
    GripRouting_HUNTR.classidof,
    GripRouting_BV2BY.classidof,
    GripRouting_NORED.classidof,
    GripRouting_TRAVL.classidof,
    GripRouting_TRACK.classidof,
  };

  @Override Unsigned getGripsCount() { return cALL_GRIPS.lengthof; }
  @Override ClassId getGripRoutingClassIdFromIndex(Unsigned gripidx) {
    return cALL_GRIPS[gripidx];
  }
}

@Concrete
element GripRouting_HUNTR : GripRouting {
  //// GripRouting API
  @Override String getGripName() { return "HUNTR"; }
  @Override Unsigned getDestCount(TapIdx src) {
    return cFIRST_DEST_INDEX[src+1u] - cFIRST_DEST_INDEX[src];
  }
  @Override TapIdx getDest(TapIdx src, Unsigned idx) {
    if (idx >= getDestCount(src)) fail(__FILE__,__LINE__);
    return cALL_DESTS[cFIRST_DEST_INDEX[src] + idx];
  }
  //@Override Unsigned getSrcCount(TapIdx dest) ;
  //@Override TapIdx getSrc(TapIdx dest, Unsigned idx) ;

  constant TapIdx cALL_DESTS[] = {
    BeeveeBIMXBlock.cTAPIDX_TRAK,  //< dest 0 of SFLG
    BeeveeBIMXBlock.cTAPIDX_HFLG,  //< dest 1 of SFLG
    BeeveeBIMXBlock.cTAPIDX_CLOK,  //< dest 2 of SFLG
    BeeveeBIMXBlock.cTAPIDX_TRAK,  //< dest 0 of SFCG
    BeeveeBIMXBlock.cTAPIDX_TRAK,  //< dest 0 of SFRG
    BeeveeBIMXBlock.cTAPIDX_HFRG,  //< dest 1 of SFRG
    BeeveeBIMXBlock.cTAPIDX_CLOK,  //< dest 2 of SFRG
    BeeveeBIMXBlock.cTAPIDX_HRLG,  //< dest 0 of SRLG
    BeeveeBIMXBlock.cTAPIDX_CLOK,  //< dest 1 of SRLG
    BeeveeBIMXBlock.cTAPIDX_HRRG,  //< dest 0 of SRRG
    BeeveeBIMXBlock.cTAPIDX_CLOK,  //< dest 1 of SRRG
    BeeveeBIMXBlock.cTAPIDX_GRIP,  //< dest 0 of SLFR
    BeeveeBIMXBlock.cTAPIDX_WNTK,  //< dest 0 of SLRR
    BeeveeBIMXBlock.cTAPIDX_GRLN,  //< dest 0 of SLFG
    BeeveeBIMXBlock.cTAPIDX_MRRF,  //< dest 0 of SLFY
    BeeveeBIMXBlock.cTAPIDX_GRIP,  //< dest 1 of SLFY
    BeeveeBIMXBlock.cTAPIDX_MLEY,  //< dest 0 of SLLY
    BeeveeBIMXBlock.cTAPIDX_MLEY,  //< dest 0 of SLRY
    BeeveeBIMXBlock.cTAPIDX_GRIP,  //< dest 0 of SRFR
    BeeveeBIMXBlock.cTAPIDX_WNTK,  //< dest 0 of SRLR
    BeeveeBIMXBlock.cTAPIDX_GRLN,  //< dest 0 of SRFG
    BeeveeBIMXBlock.cTAPIDX_MLRF,  //< dest 0 of SRFY
    BeeveeBIMXBlock.cTAPIDX_GRIP,  //< dest 1 of SRFY
    BeeveeBIMXBlock.cTAPIDX_MREY,  //< dest 0 of SRLY
    BeeveeBIMXBlock.cTAPIDX_MREY,  //< dest 0 of SRRY
    BeeveeBIMXBlock.cTAPIDX_MRRF,  //< dest 0 of TOCK
    BeeveeBIMXBlock.cTAPIDX_MLRF,  //< dest 1 of TOCK
    BeeveeBIMXBlock.cTAPIDX_TRAKPD,  //< dest 0 of GTCC
    BeeveeBIMXBlock.cTAPIDX_GTCC,  //< dest 0 of CLOK
    BeeveeBIMXBlock.cTAPIDX_HPDF,  //< dest 0 of IFLG
    BeeveeBIMXBlock.cTAPIDX_HFQA,  //< dest 1 of IFLG
    BeeveeBIMXBlock.cTAPIDX_HPDF,  //< dest 0 of IFRG
    BeeveeBIMXBlock.cTAPIDX_HFQA,  //< dest 1 of IFRG
    BeeveeBIMXBlock.cTAPIDX_HPDR,  //< dest 0 of IRRG
    BeeveeBIMXBlock.cTAPIDX_HFQA,  //< dest 1 of IRRG
    BeeveeBIMXBlock.cTAPIDX_HPDR,  //< dest 0 of IRLG
    BeeveeBIMXBlock.cTAPIDX_HFQA,  //< dest 1 of IRLG
  }; // cALL_DESTS

  constant Unsigned cFIRST_DEST_INDEX[] = {
    0u,  //< start idx of BVPITCH Beevee Pitch
    0u,  //< start idx of BVROLL Beevee Roll
    0u,  //< start idx of SFLG Front Left Floor Grey Sensor
    3u,  //< start idx of SFCG Front Center Floor Grey Sensor
    4u,  //< start idx of SFRG Front Right Floor Grey Sensor
    7u,  //< start idx of SRLG Rear Left Floor Grey Sensor
    9u,  //< start idx of SRRG Rear Right Floor Grey Sensor
