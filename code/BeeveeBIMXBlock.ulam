    16u,  //< start idx of SLFY Left Front Yellow Detector
    17u,  //< start idx of SLLY Left Left-side Yellow Detector
    17u,  //< start idx of SLRY Left Right-side Yellow Detector
    17u,  //< start idx of SRFR Right Front Red Detector
    19u,  //< start idx of SRLR Right Left-side Red Detector
