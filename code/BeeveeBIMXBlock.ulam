    23u,  //< start idx of HEMP HEMP
    23u,  //< start idx of WNTK WNTK
    23u,  //< start idx of GTCC GTCC
    24u,  //< start idx of HTD8 HTD8
    24u,  //< start idx of LOCZ LOCZ
    24u,  //< start idx of HINFO HINFO
    24u,  //< start idx of GRLN GRLN
    24u,  //< start idx of GREG GREG
    24u,  //< start idx of HESR HESR
    24u,  //< start idx of HFLG HFLG
    24u,  //< start idx of HFRG HFRG
    24u,  //< start idx of HRRG HRRG
    24u,  //< start idx of HRLG HRLG
    24u,  //< start idx of TRAKPD TRAKPD
    24u,  //< start idx of TRAK TRAK
    24u,  //< start idx of CLOK CLOK
    25u,  //< start idx of IFLG IFLG
    27u,  //< start idx of IFRG IFRG
    29u,  //< start idx of IRRG IRRG
    31u,  //< start idx of IRLG IRLG
    33u,  //< start idx of HFQA HFQA
    33u,  //< start idx of HPDF HPDF
    33u,  //< start idx of HPDR HPDR
    33u,  //< start idx of LZRV LZRV
    33u,  //< start idx of DLRV DLRV
    33u,  //< start idx of GSRV GSRV
    33u,  //< start idx of DSTRV DSTRV
    33u,  //< start idx of final dummy for end of list
  }; // cFIRST_DEST_INDEX

  Int sigFuncRedCrossMap (Int i) {
     Int o = i;
     {   if (i < 2) o = 2*i;          // 0..1 -> 0..2
  else if (i < 4) o = 1+i;     // 2..3 -> 3..4
  else if (i < 8) o = 3+i/2;   // 4..7 -> 5..8
  else o = 8+i/8;              // 8..100 -> 9..20
  if (o > 14) o = 14;
  o = -o;
 }
     return o;
 }

  Int sigFuncStalkMap (Int i) {
     Int o = i;
     {   if (i > 0) {
    o = i*5;
    if (o > 63) o = 63;   // limit to 6 bits for EyePacket compat?
  }
 }
     return o;
 }


  @Override Bool mapSig(TapIdx src, TapIdx dst, Int input, Int & output) {
    output = mapAllSigs(src,dst,input);
    return true;
  }

  Int mapAllSigs(TapIdx src, TapIdx dst, Int i) {
    Int o = i;
    
  if (src == BeeveeBIMXBlock.cTAPIDX_SLFR) {
    if (dst == BeeveeBIMXBlock.cTAPIDX_MRRF) {
      return sigFuncRedCrossMap(i);
    }
    return o;
  }
  if (src == BeeveeBIMXBlock.cTAPIDX_SRFR) {
    if (dst == BeeveeBIMXBlock.cTAPIDX_MLRF) {
      return sigFuncRedCrossMap(i);
    }
    return o;
  }
  if (src == BeeveeBIMXBlock.cTAPIDX_SLLR) {
    if (dst == BeeveeBIMXBlock.cTAPIDX_MLEY) {
      return sigFuncStalkMap(i);
    }
    return o;
  }
  if (src == BeeveeBIMXBlock.cTAPIDX_SRRR) {
    if (dst == BeeveeBIMXBlock.cTAPIDX_MREY) {
      return sigFuncStalkMap(i);
    }
    return o;
  }
  return o;
  }

} // GripRouting_NORED

