    28u,  //< start idx of CLOK CLOK
    29u,  //< start idx of IFLG IFLG
    31u,  //< start idx of IFRG IFRG
    33u,  //< start idx of IRRG IRRG
    35u,  //< start idx of IRLG IRLG
    37u,  //< start idx of HFQA HFQA
    37u,  //< start idx of HPDF HPDF
    37u,  //< start idx of HPDR HPDR
    37u,  //< start idx of LZRV LZRV
    37u,  //< start idx of final dummy for end of list
  }; // cFIRST_DEST_INDEX


  @Override Bool mapSig(TapIdx src, TapIdx dst, Int input, Int & output) {
    output = mapAllSigs(src,dst,input);
    return true;
  }

  Int mapAllSigs(TapIdx src, TapIdx dst, Int i) {
    Int o = i;
    
  return o;
  }

} // GripRouting_HUNTR

