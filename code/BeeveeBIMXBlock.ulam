  constant Int oVALID_HEAD          = oCUR_SPEED + 1;     //  30/-1999999969 
  constant Int oCUR_HEAD            = oVALID_HEAD + 1;    //  31/-1999999968 
  constant Int oSET_HEAD            = oCUR_HEAD + 1;      //  32/-1999999967 
  constant Int oINCR_HEAD           = oSET_HEAD + 1;      //  33/-1999999966 {}
  constant Int oINCR_POS            = oINCR_HEAD + 1;     //  34/-1999999965 {}
  constant Int oSET_XPOS            = oINCR_POS + 1;      //  35/-1999999964 {}
  constant Int oSET_YPOS            = oSET_XPOS + 1;      //  36/-1999999963 {}
  constant Int oRED_WARNING_TRACK   = oSET_YPOS + 1;      //  37/-1999999962 {}
  constant Int oRED_PRE_WARNING     = oRED_WARNING_TRACK + 1;//  38/-1999999961 {}
  constant Int oGREEN_LEVEL         = oRED_PRE_WARNING + 1;//  39/-1999999960 {}
  constant Int oCMP_EQ              = oGREEN_LEVEL + 1;   //  40/-1999999959 {}
  constant Int oCMP_NE              = oCMP_EQ + 1;        //  41/-1999999958 {}
  constant Int oCMP_LT              = oCMP_NE + 1;        //  42/-1999999957 
  constant Int oCMP_LE              = oCMP_LT + 1;        //  43/-1999999956 {}
  constant Int oCMP_GT              = oCMP_LE + 1;        //  44/-1999999955 
  constant Int oCMP_GE              = oCMP_GT + 1;        //  45/-1999999954 {}
  constant Int oMAX                 = oCMP_GE + 1;        //  46/-1999999953 
  constant Int oMIN                 = oMAX + 1;           //  47/-1999999952 
  constant Int oADD                 = oMIN + 1;           //  48/-1999999951 
  constant Int oSUB                 = oADD + 1;           //  49/-1999999950 
  constant Int oMUL                 = oSUB + 1;           //  50/-1999999949 
  constant Int oDIV                 = oMUL + 1;           //  51/-1999999948 
  constant Int oAND                 = oDIV + 1;           //  52/-1999999947 {}
  constant Int oOR                  = oAND + 1;           //  53/-1999999946 {}
  constant Int oNOT                 = oOR + 1;            //  54/-1999999945 
