  Int sigFuncLeftStalkMap (Int i) {
     Int o = i;
     {  { MetroState ms; ms.setDebugOutputEnabled(false);
  EyePacket ep;
  ep.mData = (ASCII) (Bits(8)) i;
  ms.mD&&ms.pR("LSMLEFT10")&&ms.pR(i)&&ms.pR(ep);
  if (ep.mSignal.mSigFmt == EyeSignal.cISIGFMT_LEYE) {
    o = i;
    ms.mD&&ms.pR("LSMLEFT11")&&ms.pR(o);
  }
  else o = Int.maxof; // "don't route" flag
}  }
     return o;
 }

  Int sigFuncRightStalkMap (Int i) {
     Int o = i;
     {  { MetroState ms; ms.setDebugOutputEnabled(false);
  EyePacket ep;
  ep.mData = (ASCII) (Bits(8)) i;
  ms.mD&&ms.pR("RSMRIGHT10")&&ms.pR(i)&&ms.pR(ep);
  if (ep.mSignal.mSigFmt == EyeSignal.cISIGFMT_REYE) {
    o = i;
    ms.mD&&ms.pR("RSMRIGHT11")&&ms.pR(o);
  }    
  else o = Int.maxof; // "don't route" flag
}  }
     return o;
 }


  @Override Bool mapSig(TapIdx src, TapIdx dst, Int input, Int & output) {
    output = mapAllSigs(src,dst,input);
    return true;
  }

  Int mapAllSigs(TapIdx src, TapIdx dst, Int i) {
    Int o = i;
    
  if (src == BeeveeBIMXBlock.cTAPIDX_TOCK) {
    if (dst == BeeveeBIMXBlock.cTAPIDX_MLEY) {
      return sigFuncLeftStalkMap(i);
    }

    if (dst == BeeveeBIMXBlock.cTAPIDX_MREY) {
      return sigFuncRightStalkMap(i);
    }
    return o;
  }
  return o;
  }

} // GripRouting_TRACK

