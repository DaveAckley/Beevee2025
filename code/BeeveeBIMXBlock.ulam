    return cTAPIDX_NONE;
  }


  //// XBInfo API
  @Override ClassId getXBInfoXBlockClass() { return self.classidof; }
  @Override Bool getXBInfoFeedDir(C2D relc, AxialDir & feedad, Bool & isinput) {
     fail(__FILE__,__LINE__,"WHY DO I EXIST? #METOO");
     return false;
  }
        
  @Override
  virtual TapIdx getXBInfoSideTAP(C2D relc, AxialDir side) {
    Int c = -1;
    if (side == cW || side == cE) c = relc.getY();
    else if (side == cN || side == cS) c = relc.getX();
    if (c < 0 || ((Unsigned) c) >= cSIDE_LENGTHS[side]) return 0u;
    return cTAPS_BY_SIDE[cSIDE_TAPIDX[side]+(Unsigned) c];
  }

} // XBlock_LOCZLABEL

//NAME XBlock_DBGLINE IS {'stride': [2, 2], 'pos': [-5, 9], 'taps': {'S': ['DLRV'], 'E': ['_'], 'N': [], 'W': []}, 'number': 6, 'origin': 'NW', 'size': [1, 1], 'hc3size': [2, 2]}
/** XBlock_DBGLINE.
   \symbol DB
   \color #fff
 */
@Concrete
element XBlock_DBGLINE : XBlock_DBGLINE_BASE + FourWaySlots {
  typedef XBlockStgT(1u,1u,2u,2u) XBlock_DBGLINE_BASE;

  //// URSELF API  
  @Override Void behave() { pursueIntention(); }

  constant Unsigned cSIDE_LENGTHS[4] = { 1, 1, 1, 1 };

  // Starting indices in cTAPS_BY_SIDE for each side
  constant Unsigned cSIDE_TAPIDX[4] = {0, 1, 2, 3}; //< [0] W, [1] N, [2] S, [3] E
  constant TapIdx cTAPS_BY_SIDE[] = {
    BeeveeBIMXBlock.cTAPIDX_HEMP,  //  0: W #0
    BeeveeBIMXBlock.cTAPIDX_HEMP,  //  1: N #0
    BeeveeBIMXBlock.cTAPIDX_DLRV,  //  2: S #0
    BeeveeBIMXBlock.cTAPIDX_HEMP,  //  3: E #0
  }; // cTAPS_BY_SIDE

  constant Unsigned cXBLOCK_INDEX = 6u;
        
  constant PocketDir cXBI_ORIGIN = cQUAD_NW;

  constant C2D cXBI_GRID_SIZE = { .x = 1, .y = 1 }; //< INTERNAL GRID SIZE
  constant C2D cXBI_GRID_STRIDE = { .x = 2, .y = 2 }; //< GRID STRIDE

  constant C2D cXBI_POS = { .x = -5, .y = 9 }; //< HC3 POS
  constant C2D cXBI_SIZ = { .x = 2, .y = 2 }; //< HC3 SIZ

  //// Intender API
  @Override Unsigned getIntentionClass() { return DefaultXBlockState.classidof; }

  //// XBlock API
  @Override Unsigned getXBlockIndex() { return cXBLOCK_INDEX; }
  @Override C2D getXBlockSize() { return cXBI_GRID_SIZE; }
  @Override C2D getXBlockStride() { return cXBI_GRID_STRIDE; }
  @Override C2D getXBlockOrigin() { return getXBInfoPosition(); }
  @Override SN getOriginSN() { return 5u; }

  //// XBInfo API 
  @Override String getXBInfoName() { return "DBGLINE"; }
  @Override C2D getXBInfoPosition() { return cXBI_POS; }
  @Override C2D getXBInfoSize() { return cXBI_SIZ; }
  @Override PocketDir getXBInfoOrigin() { return cXBI_ORIGIN; }


// generateAxonTargetCode({'stride': [2, 2], 'pos': [-5, 9], 'taps': {'S': ['DLRV'], 'E': ['_'], 'N': [], 'W': []}, 'number': 6, 'origin': 'NW', 'size': [1, 1], 'hc3size': [2, 2]})
  @Override
  virtual TapIdx getXBInfoAxonTarget(TapIdx tapidx) {
    BeeveeBIMXBlock bim;
    ClassId fromid = bim.getTAPClassIdFromTapIdx(tapidx);
    return cTAPIDX_NONE;
  }


  //// XBInfo API
  @Override ClassId getXBInfoXBlockClass() { return self.classidof; }
  @Override Bool getXBInfoFeedDir(C2D relc, AxialDir & feedad, Bool & isinput) {
     fail(__FILE__,__LINE__,"WHY DO I EXIST? #METOO");
     return false;
  }
        
  @Override
  virtual TapIdx getXBInfoSideTAP(C2D relc, AxialDir side) {
    Int c = -1;
    if (side == cW || side == cE) c = relc.getY();
    else if (side == cN || side == cS) c = relc.getX();
    if (c < 0 || ((Unsigned) c) >= cSIDE_LENGTHS[side]) return 0u;
    return cTAPS_BY_SIDE[cSIDE_TAPIDX[side]+(Unsigned) c];
  }

} // XBlock_DBGLINE

@Concrete
quark BeeveeGrips : Grips {
  constant Unsigned cGRIPIDX_HUNTR = 0u; 
  constant Unsigned cGRIPIDX_BV2BY = 1u; 
  constant Unsigned cGRIPIDX_NORED = 2u; 
  constant Unsigned cGRIPIDX_TRAVL = 3u; 
  constant Unsigned cGRIPIDX_TRACK = 4u; 

  constant ClassId cALL_GRIPS[] = {
    GripRouting_HUNTR.classidof,
    GripRouting_BV2BY.classidof,
    GripRouting_NORED.classidof,
    GripRouting_TRAVL.classidof,
    GripRouting_TRACK.classidof,
  };

  @Override Unsigned getGripsCount() { return cALL_GRIPS.lengthof; }
  @Override ClassId getGripRoutingClassIdFromIndex(Unsigned gripidx) {
    return cALL_GRIPS[gripidx];
  }
}

