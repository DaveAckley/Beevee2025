  String nameOfOperatorOrNull(Int op) {
    Unsigned idx = (Unsigned) (op - cMIN_OP_VAL - 1);
    String ret; // null to start
    if (idx < cOPERATOR_NAMES.lengthof) ret = cOPERATOR_NAMES[idx];
    return ret;
 }
  String nameOfOperator(Int op) {
    String ret = nameOfOperatorOrNull(op);
    if (!(Bool) ret) ret = "#";
    return ret;
 }

  Bool readRAM(Int addr, Int & res) {
    if (addr < 0 || addr >= cTOTAL_CRAM_LEN) return false;
    Int block = addr/256;
    Int idx = addr%256;
    which (block) {
     case 0: { res = cRAM0[idx]; }
     case 1: { res = cRAM1[idx]; }
     case 2: { res = cRAM2[idx]; }
     otherwise: { return false; }
    }
    return true;
  }

  Bool readRAMSource(Int addr, String & res) {
    if (addr < 0 || addr >= cTOTAL_CRAM_LEN) return false;
    Int block = addr/256;
    Int idx = addr%256;
    which (block) {
     case 0: { res = cRAMSource0[idx]; }
     case 1: { res = cRAMSource1[idx]; }
     case 2: { res = cRAMSource2[idx]; }
 otherwise: { return false; }
    }
    return true;
  }

