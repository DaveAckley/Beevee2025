    31u,  //< start idx of final dummy for end of list
  }; // cFIRST_DEST_INDEX

  Int sigFuncStalkMap (Int i) {
     Int o = i;
     { o = 1; }
     return o;
 }


  @Override Bool mapSig(TapIdx src, TapIdx dst, Int input, Int & output) {
    output = mapAllSigs(src,dst,input);
    return true;
  }

  Int mapAllSigs(TapIdx src, TapIdx dst, Int i) {
    Int o = i;
    
  if (src == BeeveeBIMXBlock.cTAPIDX_TOCK) {
    if (dst == BeeveeBIMXBlock.cTAPIDX_MLEY) {
      return sigFuncStalkMap(i);
    }

    if (dst == BeeveeBIMXBlock.cTAPIDX_MREY) {
      return sigFuncStalkMap(i);
    }
    return o;
  }
  return o;
  }

} // GripRouting_TRACK

quark CodeConstants + DTU + Fail {

  constant Int cRAM[186] = {
    oCALL,               //   0 fake for returning to top level
    oENTER,              //   1 fTRUE: always true
    1,                   //   2 
    oRETURN,             //   3 From: fTRUE
    oENTER,              //   4 fFALSE: always false
    0,                   //   5 
    oRETURN,             //   6 From: fFALSE
    oENTER,              //   7 fOFFLINE_FRONT: true on front not tick and not tock
    oCLOK_FRONT,         //   8 
    cCLOK_NONE,          //   9 
    oCMP_EQ,             //  10 
    oRETURN,             //  11 From: fOFFLINE_FRONT
    oENTER,              //  12 fHARD_OFFLINE_FRONT: true on front not tick and not tock for quite a consecutive while
    oHARD_OFFLINE_FRONT, //  13 
    oRETURN,             //  14 From: fHARD_OFFLINE_FRONT
    oENTER,              //  15 fCLOK_TICK_FRONT: true on front tick
    oCLOK_FRONT,         //  16 
    cCLOK_TICK,          //  17 
    oCMP_EQ,             //  18 
    oRETURN,             //  19 From: fCLOK_TICK_FRONT
    oENTER,              //  20 fCLOK_TOCK_FRONT: true on front tock
    oCLOK_FRONT,         //  21 
    cCLOK_TOCK,          //  22 
    oCMP_EQ,             //  23 
    oRETURN,             //  24 From: fCLOK_TOCK_FRONT
    oENTER,              //  25 fCLOK_EDGE_FRONT: true on front tick or front tock
    oCLOK_FRONT,         //  26 
    cCLOK_NONE,          //  27 
    oCMP_NE,             //  28 
    oRETURN,             //  29 From: fCLOK_EDGE_FRONT
    oENTER,              //  30 fCLOK_EDGE_REAR: true on rear tick or rear tock
    oCLOK_REAR,          //  31 
    cCLOK_NONE,          //  32 
    oCMP_NE,             //  33 
    oRETURN,             //  34 From: fCLOK_EDGE_REAR
    oENTER,              //  35 fSMALL_GREY_DEV: true on small deviation, meaning 128+-25 == 103..153
    oGREY_FCTR,          //  36 
    oDUP,                //  37 
    153,                 //  38 
    oCMP_LE,             //  39 
    oSWAP,               //  40 
    103,                 //  41 
    oCMP_GE,             //  42 
    oAND,                //  43 
    oRETURN,             //  44 From: fSMALL_GREY_DEV
    oENTER,              //  45 fCLOK_EDGE_TUNED: true on front edge and small deviation
    fCLOK_EDGE_FRONT,    //  46 
    oCALL,               //  47 
    fSMALL_GREY_DEV,     //  48 
    oCALL,               //  49 
    oAND,                //  50 
    oRETURN,             //  51 From: fCLOK_EDGE_TUNED
    oENTER,              //  52 fSAME_EDGE: true if front and back on tick or tock
    fCLOK_EDGE_FRONT,    //  53 
    oCALL,               //  54 
    oCLOK_REAR,          //  55 
    oCLOK_FRONT,         //  56 
    oCMP_EQ,             //  57 
    oAND,                //  58 
    oRETURN,             //  59 From: fSAME_EDGE
    oENTER,              //  60 fDIFF_EDGE: true if front and back on tick and tock or tock and tick
    fCLOK_EDGE_FRONT,    //  61 
    oCALL,               //  62 
    fCLOK_EDGE_REAR,     //  63 
    oCALL,               //  64 
    oAND,                //  65 
    oCLOK_REAR,          //  66 
    oCLOK_FRONT,         //  67 
    oCMP_NE,             //  68 
    oAND,                //  69 
    oRETURN,             //  70 From: fDIFF_EDGE
    oENTER,              //  71 fSTOPPED: true if valid speed is 0
    oVALID_SPEED,        //  72 
    oCUR_SPEED,          //  73 
    0,                   //  74 
    oCMP_EQ,             //  75 
    oAND,                //  76 
    oRETURN,             //  77 From: fSTOPPED
    oENTER,              //  78 fSTOP_DRIVE_SLOW: done if hard offline, or red warning
    oHARD_OFFLINE_FRONT, //  79 
    oRED_WARNING_TRACK,  //  80 
    oOR,                 //  81 
    oRETURN,             //  82 From: fSTOP_DRIVE_SLOW
    oENTER,              //  83 fSTOP_DRIVE_FAST: done if hard offline, or red prewarning, or red warning
    fSTOP_DRIVE_SLOW,    //  84 
    oCALL,               //  85 
    oRED_PRE_WARNING,    //  86 
    oOR,                 //  87 
    oRETURN,             //  88 From: fSTOP_DRIVE_FAST
    oENTER,              //  89 fFACE_EAST: Turn until big green
    fTURN_RIGHT_TICK,    //  90 
    oCALL,               //  91 
    oGREEN_LEVEL,        //  92 
    2,                   //  93 
    oCMP_GE,             //  94 
    fFACE_EAST,          //  95 
    oGOTOZ,              //  96 
    3,                   //  97 
    oSET_HEAD,           //  98 
    oRETURN,             //  99 From: fFACE_EAST
    oENTER,              // 100 fFACE_EAST_SPIKE: loop to test/demo FACE_EAST
    fFACE_EAST,          // 101 
    oCALL,               // 102 
    tDRIVE_SLOW,         // 103 
    oRUN_TRAKT,          // 104 
    fTURN_LEFT_TICK,     // 105 
    oCALL,               // 106 
    tDRESS_LINE_FWD,     // 107 
    oRUN_TRAKT,          // 108 
    fTURN_LEFT_TICK,     // 109 
    oCALL,               // 110 
    tDRIVE_SLOW,         // 111 
    oRUN_TRAKT,          // 112 
    fFACE_EAST_SPIKE,    // 113 
    oGOTO,               // 114 
    oRETURN,             // 115 From: fFACE_EAST_SPIKE
    oENTER,              // 116 fTURN_RIGHT_TICK: Turn right, maintaining heading if set
    tFORWARD_TO_TICK,    // 117 
    oRUN_TRAKT,          // 118 
    tDRESS_LINE_FWD,     // 119 
    oRUN_TRAKT,          // 120 
    tTURN_RIGHT_TO_TOCK, // 121 
    oRUN_TRAKT,          // 122 
    1,                   // 123 
    oINCR_HEAD,          // 124 
    oRETURN,             // 125 From: fTURN_RIGHT_TICK
    oENTER,              // 126 fTURN_LEFT_TICK: Turn left, maintaining heading if set
    tFORWARD_TO_TICK,    // 127 
    oRUN_TRAKT,          // 128 
    tDRESS_LINE_FWD,     // 129 
    oRUN_TRAKT,          // 130 
    tTURN_LEFT_TO_TOCK,  // 131 
    oRUN_TRAKT,          // 132 
    -1,                  // 133 
    oINCR_HEAD,          // 134 
    oRETURN,             // 135 From: fTURN_LEFT_TICK
    oENTER,              // 136 fDRIVE_TO_ORIGIN: Find SE 'corner' to declare a grid origin
    fFACE_EAST,          // 137 
    oCALL,               // 138 
    tDRIVE_SLOW,         // 139 
    oRUN_TRAKT,          // 140 
    0,                   // 141 
    oSET_XPOS,           // 142 
    fTURN_RIGHT_TICK,    // 143 
    oCALL,               // 144 
    tDRIVE_SLOW,         // 145 
    oRUN_TRAKT,          // 146 
    0,                   // 147 
    oSET_YPOS,           // 148 
    oRETURN,             // 149 From: fDRIVE_TO_ORIGIN
    oENTER,              // 150 fDRIVE_BOX_SPIKE: 'infinite' loop making a clockwise box
    tFORWARD_TO_TICK,    // 151 
    oRUN_TRAKT,          // 152 
    tDRESS_LINE_FWD,     // 153 
    oRUN_TRAKT,          // 154 
    tTURN_RIGHT_TO_TOCK, // 155 
    oRUN_TRAKT,          // 156 
    fDRIVE_BOX_SPIKE,    // 157 
    oGOTO,               // 158 
    oRETURN,             // 159 From: fDRIVE_BOX_SPIKE
    oENTER,              // 160 fDRIVE_BOX_SPIKE2: 'infinite' loop making a bigger clockwise box
    tFORWARD_TO_TICK,    // 161 
    oRUN_TRAKT,          // 162 
    tFORWARD_TO_TOCK,    // 163 
    oRUN_TRAKT,          // 164 
    tFORWARD_TO_TICK,    // 165 
    oRUN_TRAKT,          // 166 
    tDRESS_LINE_FWD,     // 167 
    oRUN_TRAKT,          // 168 
    tTURN_RIGHT_TO_TOCK, // 169 
    oRUN_TRAKT,          // 170 
    fDRIVE_BOX_SPIKE2,   // 171 
    oGOTO,               // 172 
    oRETURN,             // 173 From: fDRIVE_BOX_SPIKE2
    oENTER,              // 174 fDRIVE_BORDER_RIGHT: 'infinite' loop making a clockwise box at the border
    tDRIVE_SLOW,         // 175 
    oRUN_TRAKT,          // 176 
    tDRESS_LINE_FWD,     // 177 
    oRUN_TRAKT,          // 178 
    tFORWARD_TO_TICK,    // 179 
    oRUN_TRAKT,          // 180 
    tTURN_RIGHT_TO_TOCK, // 181 
    oRUN_TRAKT,          // 182 
    fDRIVE_BORDER_RIGHT, // 183 
    oGOTO,               // 184 
    oRETURN,             // 185 From: fDRIVE_BORDER_RIGHT
  }; // constant Int cRAM[186]

  //// FUNCTION ADDRS
  constant Int fTRUE                =   1;   // always true
  constant Int fFALSE               =   4;   // always false
  constant Int fOFFLINE_FRONT       =   7;   // true on front not tick and not tock
  constant Int fHARD_OFFLINE_FRONT  =  12;   // true on front not tick and not tock for quite a consecutive while
  constant Int fCLOK_TICK_FRONT     =  15;   // true on front tick
  constant Int fCLOK_TOCK_FRONT     =  20;   // true on front tock
  constant Int fCLOK_EDGE_FRONT     =  25;   // true on front tick or front tock
  constant Int fCLOK_EDGE_REAR      =  30;   // true on rear tick or rear tock
  constant Int fSMALL_GREY_DEV      =  35;   // true on small deviation, meaning 128+-25 == 103..153
  constant Int fCLOK_EDGE_TUNED     =  45;   // true on front edge and small deviation
  constant Int fSAME_EDGE           =  52;   // true if front and back on tick or tock
  constant Int fDIFF_EDGE           =  60;   // true if front and back on tick and tock or tock and tick
  constant Int fSTOPPED             =  71;   // true if valid speed is 0
  constant Int fSTOP_DRIVE_SLOW     =  78;   // done if hard offline, or red warning
  constant Int fSTOP_DRIVE_FAST     =  83;   // done if hard offline, or red prewarning, or red warning
  constant Int fFACE_EAST           =  89;   // Turn until big green
  constant Int fTURN_RIGHT_TICK     = 116;   // Turn right, maintaining heading if set
  constant Int fFACE_EAST_SPIKE     = 100;   // loop to test/demo FACE_EAST
  constant Int fTURN_LEFT_TICK      = 126;   // Turn left, maintaining heading if set
  constant Int fDRIVE_TO_ORIGIN     = 136;   // Find SE 'corner' to declare a grid origin
  constant Int fDRIVE_BOX_SPIKE     = 150;   // 'infinite' loop making a clockwise box
  constant Int fDRIVE_BOX_SPIKE2    = 160;   // 'infinite' loop making a bigger clockwise box
  constant Int fDRIVE_BORDER_RIGHT  = 174;   // 'infinite' loop making a clockwise box at the border
  //// END FUNCTION ADDRS

  String nameOfFunction(Int funcaddr) {
    String ret = nameOfFunctionOrNull(funcaddr);
    if (!(Bool) ret) ret = "<ENOMETH>";
    return ret;
  }
        
  String nameOfFunctionOrNull(Int funcaddr) {
    if (funcaddr == fTRUE) return "fTRUE";
    if (funcaddr == fFALSE) return "fFALSE";
    if (funcaddr == fOFFLINE_FRONT) return "fOFFLINE_FRONT";
    if (funcaddr == fHARD_OFFLINE_FRONT) return "fHARD_OFFLINE_FRONT";
    if (funcaddr == fCLOK_TICK_FRONT) return "fCLOK_TICK_FRONT";
    if (funcaddr == fCLOK_TOCK_FRONT) return "fCLOK_TOCK_FRONT";
    if (funcaddr == fCLOK_EDGE_FRONT) return "fCLOK_EDGE_FRONT";
    if (funcaddr == fCLOK_EDGE_REAR) return "fCLOK_EDGE_REAR";
    if (funcaddr == fSMALL_GREY_DEV) return "fSMALL_GREY_DEV";
    if (funcaddr == fCLOK_EDGE_TUNED) return "fCLOK_EDGE_TUNED";
    if (funcaddr == fSAME_EDGE) return "fSAME_EDGE";
    if (funcaddr == fDIFF_EDGE) return "fDIFF_EDGE";
    if (funcaddr == fSTOPPED) return "fSTOPPED";
    if (funcaddr == fSTOP_DRIVE_SLOW) return "fSTOP_DRIVE_SLOW";
    if (funcaddr == fSTOP_DRIVE_FAST) return "fSTOP_DRIVE_FAST";
    if (funcaddr == fFACE_EAST) return "fFACE_EAST";
    if (funcaddr == fTURN_RIGHT_TICK) return "fTURN_RIGHT_TICK";
    if (funcaddr == fFACE_EAST_SPIKE) return "fFACE_EAST_SPIKE";
    if (funcaddr == fTURN_LEFT_TICK) return "fTURN_LEFT_TICK";
    if (funcaddr == fDRIVE_TO_ORIGIN) return "fDRIVE_TO_ORIGIN";
    if (funcaddr == fDRIVE_BOX_SPIKE) return "fDRIVE_BOX_SPIKE";
    if (funcaddr == fDRIVE_BOX_SPIKE2) return "fDRIVE_BOX_SPIKE2";
    if (funcaddr == fDRIVE_BORDER_RIGHT) return "fDRIVE_BORDER_RIGHT";

    String null;
    return null;
  }

  //// OPERATORS
  constant Int cMIN_OP_VAL = -2000000000;
        
  constant Int oNOP                 = cMIN_OP_VAL + 1;    //   0/-1999999999 
  constant Int oDUP                 = oNOP + 1;           //   1/-1999999998 {}
  constant Int oDROP                = oDUP + 1;           //   2/-1999999997 
  constant Int oSWAP                = oDROP + 1;          //   3/-1999999996 {}
  constant Int oENTER               = oSWAP + 1;          //   4/-1999999995 {}
  constant Int oGOTO                = oENTER + 1;         //   5/-1999999994 {}
  constant Int oGOTOZ               = oGOTO + 1;          //   6/-1999999993 {}
  constant Int oJUMPZ               = oGOTOZ + 1;         //   7/-1999999992 
  constant Int oRETURN              = oJUMPZ + 1;         //   8/-1999999991 {}
  constant Int oCALL                = oRETURN + 1;        //   9/-1999999990 {}
  constant Int oRUN_TRAKT           = oCALL + 1;          //  10/-1999999989 {}
  constant Int oHARD_OFFLINE_FRONT  = oRUN_TRAKT + 1;     //  11/-1999999988 {}
  constant Int oCLOK_FRONT          = oHARD_OFFLINE_FRONT + 1;//  12/-1999999987 {}
  constant Int oCLOK_REAR           = oCLOK_FRONT + 1;    //  13/-1999999986 {}
  constant Int oGREY_FCTR           = oCLOK_REAR + 1;     //  14/-1999999985 {}
  constant Int oVALID_SPEED         = oGREY_FCTR + 1;     //  15/-1999999984 {}
  constant Int oCUR_SPEED           = oVALID_SPEED + 1;   //  16/-1999999983 {}
  constant Int oVALID_HEAD          = oCUR_SPEED + 1;     //  17/-1999999982 
  constant Int oCUR_HEAD            = oVALID_HEAD + 1;    //  18/-1999999981 
  constant Int oSET_HEAD            = oCUR_HEAD + 1;      //  19/-1999999980 {}
  constant Int oINCR_HEAD           = oSET_HEAD + 1;      //  20/-1999999979 {}
  constant Int oSET_XPOS            = oINCR_HEAD + 1;     //  21/-1999999978 {}
  constant Int oSET_YPOS            = oSET_XPOS + 1;      //  22/-1999999977 {}
  constant Int oRED_WARNING_TRACK   = oSET_YPOS + 1;      //  23/-1999999976 {}
  constant Int oRED_PRE_WARNING     = oRED_WARNING_TRACK + 1;//  24/-1999999975 {}
  constant Int oGREEN_LEVEL         = oRED_PRE_WARNING + 1;//  25/-1999999974 {}
  constant Int oCMP_EQ              = oGREEN_LEVEL + 1;   //  26/-1999999973 {}
  constant Int oCMP_NE              = oCMP_EQ + 1;        //  27/-1999999972 {}
  constant Int oCMP_LT              = oCMP_NE + 1;        //  28/-1999999971 
  constant Int oCMP_LE              = oCMP_LT + 1;        //  29/-1999999970 {}
  constant Int oCMP_GT              = oCMP_LE + 1;        //  30/-1999999969 
  constant Int oCMP_GE              = oCMP_GT + 1;        //  31/-1999999968 {}
  constant Int oMAX                 = oCMP_GE + 1;        //  32/-1999999967 
  constant Int oMIN                 = oMAX + 1;           //  33/-1999999966 
  constant Int oADD                 = oMIN + 1;           //  34/-1999999965 
  constant Int oSUB                 = oADD + 1;           //  35/-1999999964 
  constant Int oMUL                 = oSUB + 1;           //  36/-1999999963 
  constant Int oDIV                 = oMUL + 1;           //  37/-1999999962 
  constant Int oAND                 = oDIV + 1;           //  38/-1999999961 {}
  constant Int oOR                  = oAND + 1;           //  39/-1999999960 {}
  constant Int oNOT                 = oOR + 1;            //  40/-1999999959 
  constant Int oNEG                 = oNOT + 1;           //  41/-1999999958 
  constant Int oLAST_OP_USED = oNEG;
  //// END OPERATORS

  //// OPERATOR NAMES
  constant String cOPERATOR_NAMES[] = {
  "oNOP", // 
  "oDUP", // {}
  "oDROP", // 
  "oSWAP", // {}
  "oENTER", // {}
  "oGOTO", // {}
  "oGOTOZ", // {}
  "oJUMPZ", // 
  "oRETURN", // {}
  "oCALL", // {}
  "oRUN_TRAKT", // {}
  "oHARD_OFFLINE_FRONT", // {}
  "oCLOK_FRONT", // {}
  "oCLOK_REAR", // {}
  "oGREY_FCTR", // {}
  "oVALID_SPEED", // {}
  "oCUR_SPEED", // {}
  "oVALID_HEAD", // 
  "oCUR_HEAD", // 
  "oSET_HEAD", // {}
  "oINCR_HEAD", // {}
  "oSET_XPOS", // {}
  "oSET_YPOS", // {}
  "oRED_WARNING_TRACK", // {}
  "oRED_PRE_WARNING", // {}
  "oGREEN_LEVEL", // {}
  "oCMP_EQ", // {}
  "oCMP_NE", // {}
  "oCMP_LT", // 
  "oCMP_LE", // {}
  "oCMP_GT", // 
  "oCMP_GE", // {}
  "oMAX", // 
  "oMIN", // 
  "oADD", // 
  "oSUB", // 
  "oMUL", // 
  "oDIV", // 
  "oAND", // {}
  "oOR", // {}
  "oNOT", // 
  "oNEG", // 

 };  //// END cOPERATOR_NAMES[]

  String nameOfOperatorOrNull(Int op) {
    Unsigned idx = (Unsigned) (op - cMIN_OP_VAL - 1);
    String ret; // null to start
    if (idx < cOPERATOR_NAMES.lengthof) ret = cOPERATOR_NAMES[idx];
    return ret;
 }
  String nameOfOperator(Int op) {
    String ret = nameOfOperatorOrNull(op);
    if (!(Bool) ret) ret = "#";
    return ret;
 }

  Bool readRAM(Int addr, Int & res) {
    if (addr < 0 || addr >= cRAM.lengthof) return false;
    res = cRAM[addr];
    return true;
  }

  typedef Unsigned(5) TRAKt; //< traktor act codes
  //// TRAKt CODE NUMBERS
  constant TRAKt tFIND_LINE_LEFT                =   0u;
  constant TRAKt tFIND_LINE_RIGHT               =   1u;
  constant TRAKt tTUNE_LINE                     =   2u;
  constant TRAKt tDRESS_LINE_FWD                =   3u;
  constant TRAKt tDRESS_LINE_REV                =   4u;
  constant TRAKt tTURN_LEFT_TO_TICK             =   5u;
  constant TRAKt tTURN_LEFT_TO_TOCK             =   6u;
  constant TRAKt tTURN_RIGHT_TO_TICK            =   7u;
  constant TRAKt tTURN_RIGHT_TO_TOCK            =   8u;
  constant TRAKt tFULL_STOP                     =   9u;
  constant TRAKt tDRIVE_SLOW                    =  10u;
  constant TRAKt tDRIVE_FAST                    =  11u;
  constant TRAKt tROLLING_STOP                  =  12u;
  constant TRAKt tFORWARD_TO_TICK               =  13u;
  constant TRAKt tFORWARD_TO_TOCK               =  14u;
  constant TRAKt tEMERGENCY_STOP                =  15u;
  //// END TRAKt CODE NUMBERS
  constant Unsigned cTRA_TRAKTNUM_COUNT = 16u;

  //// TRAKt CODE NAMES       
  constant String cTRAKT_NAMES[cTRA_TRAKTNUM_COUNT] = {
    "tFIND_LINE_LEFT.0",           //   0
    "tFIND_LINE_RIGHT.1",          //   1
    "tTUNE_LINE.2",                //   2
    "tDRESS_LINE_FWD.3",           //   3
    "tDRESS_LINE_REV.4",           //   4
    "tTURN_LEFT_TO_TICK.5",        //   5
    "tTURN_LEFT_TO_TOCK.6",        //   6
    "tTURN_RIGHT_TO_TICK.7",       //   7
    "tTURN_RIGHT_TO_TOCK.8",       //   8
    "tFULL_STOP.9",                //   9
    "tDRIVE_SLOW.10",              //  10
    "tDRIVE_FAST.11",              //  11
    "tROLLING_STOP.12",            //  12
    "tFORWARD_TO_TICK.13",         //  13
    "tFORWARD_TO_TOCK.14",         //  14
    "tEMERGENCY_STOP.15",          //  15
  }; // cTRAKT_NAMES

  String nameOfTRAKtOrNull(TRAKt t) {
    String ret;
    if (t < cTRA_TRAKTNUM_COUNT) ret = cTRAKT_NAMES[t];
    return ret;
  }
  String nameOfTRAKt(TRAKt t) {
    String ret = nameOfTRAKtOrNull(t);
    if (!(Bool) ret) ret = "cTRAUNKNOWN";
    return ret;
  }


} // CodeConstants


quark CodeMethods : CodeConstants + QDebugUtils {
