    25u,  //< start idx of MLEY Left Eyestalk Angle
    25u,  //< start idx of MREY Right Eyestalk Angle
    25u,  //< start idx of MDBG10 Debug motor 10
    25u,  //< start idx of TOCK TOCK
    27u,  //< start idx of HEMP HEMP
    27u,  //< start idx of WNTK WNTK
    27u,  //< start idx of GTCC GTCC
    28u,  //< start idx of HTD8 HTD8
    28u,  //< start idx of LOCZ LOCZ
    28u,  //< start idx of GRLN GRLN
    28u,  //< start idx of GREG GREG
    28u,  //< start idx of HFLG HFLG
    28u,  //< start idx of HFRG HFRG
