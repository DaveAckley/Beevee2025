/** XBlock_HOTBOX.
   \symbol HO
   \color #f40
 */
@Concrete
element XBlock_HOTBOX : XBlock_HOTBOX_BASE + FourWaySlots {
  typedef XBlockStgT(7u,4u,2u,3u) XBlock_HOTBOX_BASE;

  //// URSELF API  
  @Override Void behave() { pursueIntention(); }

  constant Unsigned cSIDE_LENGTHS[4] = { 4, 7, 7, 4 };

  // Starting indices in cTAPS_BY_SIDE for each side
  constant Unsigned cSIDE_TAPIDX[4] = {0, 4, 11, 18}; //< [0] W, [1] N, [2] S, [3] E
  constant TapIdx cTAPS_BY_SIDE[] = {
    BeeveeBIMXBlock.cTAPIDX_MRRF,  //  0: W #0
    BeeveeBIMXBlock.cTAPIDX_MLRF,  //  1: W #1
    BeeveeBIMXBlock.cTAPIDX_WNTK,  //  2: W #2
    BeeveeBIMXBlock.cTAPIDX_HEMP,  //  3: W #3
    BeeveeBIMXBlock.cTAPIDX_SRFR,  //  4: N #0
    BeeveeBIMXBlock.cTAPIDX_SRFY,  //  5: N #1
    BeeveeBIMXBlock.cTAPIDX_SLFR,  //  6: N #2
    BeeveeBIMXBlock.cTAPIDX_SLFY,  //  7: N #3
    BeeveeBIMXBlock.cTAPIDX_TOCK,  //  8: N #4
    BeeveeBIMXBlock.cTAPIDX_SRLR,  //  9: N #5
    BeeveeBIMXBlock.cTAPIDX_SLRR,  // 10: N #6
    BeeveeBIMXBlock.cTAPIDX_SLRY,  // 11: S #0
    BeeveeBIMXBlock.cTAPIDX_SLLY,  // 12: S #1
    BeeveeBIMXBlock.cTAPIDX_SRRY,  // 13: S #2
    BeeveeBIMXBlock.cTAPIDX_SRLY,  // 14: S #3
    BeeveeBIMXBlock.cTAPIDX_SRRR,  // 15: S #4
    BeeveeBIMXBlock.cTAPIDX_SLLR,  // 16: S #5
    BeeveeBIMXBlock.cTAPIDX_HEMP,  // 17: S #6
    BeeveeBIMXBlock.cTAPIDX_HEMP,  // 18: E #0
    BeeveeBIMXBlock.cTAPIDX_MREY,  // 19: E #1
    BeeveeBIMXBlock.cTAPIDX_MLEY,  // 20: E #2
    BeeveeBIMXBlock.cTAPIDX_GRIP,  // 21: E #3
  }; // cTAPS_BY_SIDE

  constant Unsigned cXBLOCK_INDEX = 0u;
        
  constant PocketDir cXBI_ORIGIN = cQUAD_NW;

  constant C2D cXBI_GRID_SIZE = { .x = 7, .y = 4 }; //< INTERNAL GRID SIZE
  constant C2D cXBI_GRID_STRIDE = { .x = 2, .y = 3 }; //< GRID STRIDE

  constant C2D cXBI_POS = { .x = -5, .y = 0 }; //< HC3 POS
  constant C2D cXBI_SIZ = { .x = 6, .y = 5 }; //< HC3 SIZ

  //// Intender API
  @Override Unsigned getIntentionClass() { return DefaultXBlockState.classidof; }

  //// XBlock API
  @Override Unsigned getXBlockIndex() { return cXBLOCK_INDEX; }
  @Override C2D getXBlockSize() { return cXBI_GRID_SIZE; }
  @Override C2D getXBlockStride() { return cXBI_GRID_STRIDE; }
  @Override C2D getXBlockOrigin() { return getXBInfoPosition(); }
  @Override SN getOriginSN() { return 18u; }

  //// XBInfo API 
  @Override String getXBInfoName() { return "HOTBOX"; }
  @Override C2D getXBInfoPosition() { return cXBI_POS; }
  @Override C2D getXBInfoSize() { return cXBI_SIZ; }
  @Override PocketDir getXBInfoOrigin() { return cXBI_ORIGIN; }


// generateAxonTargetCode({'intentionClass': 'DefaultXBlockState', 'stride': [2, 3], 'pos': [-5, 0], 'originSN': 18, 'color': '#f40', 'taps': {'N': ['SRFR', 'SRFY', 'SLFR', 'SLFY', 'TOCK', 'SRLR', 'SLRR'], 'S': ['SLRY', 'SLLY', 'SRRY', 'SRLY', 'SRRR', 'SLLR'], 'W': ['MRRF', 'MLRF', 'WNTK', '_'], 'E': ['_', 'MREY', 'MLEY', 'GRIP']}, 'axons': [['WNTK', 'LOCZ']], 'number': 0, 'origin': 'NW', 'size': [7, 4], 'hc3size': [6, 5]})
  @Override
  virtual TapIdx getXBInfoAxonTarget(TapIdx tapidx) {
    BeeveeBIMXBlock bim;
    ClassId fromid = bim.getTAPClassIdFromTapIdx(tapidx);
    if (fromid == WNTK.classidof) return (TapIdx) bim.getTapIdxFromClassId(LOCZ.classidof);
    return cTAPIDX_NONE;
  }


  //// XBInfo API
  @Override ClassId getXBInfoXBlockClass() { return self.classidof; }
  @Override Bool getXBInfoFeedDir(C2D relc, AxialDir & feedad, Bool & isinput) {
     fail(__FILE__,__LINE__,"WHY DO I EXIST? #METOO");
     return false;
  }
        
  @Override
  virtual TapIdx getXBInfoSideTAP(C2D relc, AxialDir side) {
    Int c = -1;
    if (side == cW || side == cE) c = relc.getY();
    else if (side == cN || side == cS) c = relc.getX();
    if (c < 0 || ((Unsigned) c) >= cSIDE_LENGTHS[side]) return 0u;
    return cTAPS_BY_SIDE[cSIDE_TAPIDX[side]+(Unsigned) c];
