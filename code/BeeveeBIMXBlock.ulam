  constant Int oSET_SMTIMER         = oSET_GSCOUNTER + 1; //   5/-1999999994 
  constant Int oGET_SMTIMER         = oSET_SMTIMER + 1;   //   6/-1999999993 
  constant Int oIS_SMTIMER_DONE     = oGET_SMTIMER + 1;   //   7/-1999999992 {}
  constant Int oINCR_SMTIMER        = oIS_SMTIMER_DONE + 1;//   8/-1999999991 {}
  constant Int oIS_EVENT_FRONT_EDGE = oINCR_SMTIMER + 1;  //   9/-1999999990 {}
  constant Int oNOP                 = oIS_EVENT_FRONT_EDGE + 1;//  10/-1999999989 
  constant Int oDUP                 = oNOP + 1;           //  11/-1999999988 {}
  constant Int oDROP                = oDUP + 1;           //  12/-1999999987 
  constant Int oSWAP                = oDROP + 1;          //  13/-1999999986 {}
  constant Int oENTER0              = oSWAP + 1;          //  14/-1999999985 {}
  constant Int oENTER1              = oENTER0 + 1;        //  15/-1999999984 {}
  constant Int oENTER2              = oENTER1 + 1;        //  16/-1999999983 
  constant Int oENTER3              = oENTER2 + 1;        //  17/-1999999982 
  constant Int oGOTO                = oENTER3 + 1;        //  18/-1999999981 {}
  constant Int oGOTOZ               = oGOTO + 1;          //  19/-1999999980 {}
  constant Int oGOTON               = oGOTOZ + 1;         //  20/-1999999979 {}
  constant Int oJUMP                = oGOTON + 1;         //  21/-1999999978 
  constant Int oJUMPZ               = oJUMP + 1;          //  22/-1999999977 
  constant Int oRETURN0             = oJUMPZ + 1;         //  23/-1999999976 {}
  constant Int oRETURN1             = oRETURN0 + 1;       //  24/-1999999975 {}
  constant Int oRETURN2             = oRETURN1 + 1;       //  25/-1999999974 
  constant Int oCALL0               = oRETURN2 + 1;       //  26/-1999999973 {}
  constant Int oCALL1               = oCALL0 + 1;         //  27/-1999999972 {}
  constant Int oCALL2               = oCALL1 + 1;         //  28/-1999999971 
  constant Int oSTART_TRAKT         = oCALL2 + 1;         //  29/-1999999970 {}
  constant Int oWAIT_READY          = oSTART_TRAKT + 1;   //  30/-1999999969 {}
  constant Int oALLRED              = oWAIT_READY + 1;    //  31/-1999999968 {}
  constant Int oHARD_OFFLINE_FRONT  = oALLRED + 1;        //  32/-1999999967 {}
  constant Int oCLOK_FRONT          = oHARD_OFFLINE_FRONT + 1;//  33/-1999999966 {}
  constant Int oCLOK_REAR           = oCLOK_FRONT + 1;    //  34/-1999999965 {}
  constant Int oGREY_FCTR           = oCLOK_REAR + 1;     //  35/-1999999964 {}
  constant Int oVALID_SPEED         = oGREY_FCTR + 1;     //  36/-1999999963 {}
  constant Int oCUR_SPEED           = oVALID_SPEED + 1;   //  37/-1999999962 {}
  constant Int oVALID_HEAD          = oCUR_SPEED + 1;     //  38/-1999999961 
  constant Int oCUR_HEAD            = oVALID_HEAD + 1;    //  39/-1999999960 {}
  constant Int oRESET_HEAD          = oCUR_HEAD + 1;      //  40/-1999999959 {}
  constant Int oSET_HEAD            = oRESET_HEAD + 1;    //  41/-1999999958 
  constant Int oINCR_HEAD           = oSET_HEAD + 1;      //  42/-1999999957 {}
  constant Int oINCR_POS            = oINCR_HEAD + 1;     //  43/-1999999956 {}
  constant Int oGET_XPOS            = oINCR_POS + 1;      //  44/-1999999955 {}
  constant Int oGET_YPOS            = oGET_XPOS + 1;      //  45/-1999999954 {}
  constant Int oSET_XPOS            = oGET_YPOS + 1;      //  46/-1999999953 {}
  constant Int oSET_YPOS            = oSET_XPOS + 1;      //  47/-1999999952 {}
  constant Int oSET_GRID_WIDTH      = oSET_YPOS + 1;      //  48/-1999999951 {}
  constant Int oSET_GRID_HEIGHT     = oSET_GRID_WIDTH + 1;//  49/-1999999950 {}
  constant Int oGET_GRID_WIDTH      = oSET_GRID_HEIGHT + 1;//  50/-1999999949 {}
  constant Int oGET_GRID_HEIGHT     = oGET_GRID_WIDTH + 1;//  51/-1999999948 {}
  constant Int oGET_DEST_EXISTS     = oGET_GRID_HEIGHT + 1;//  52/-1999999947 {}
  constant Int oSET_DEST_EXISTS     = oGET_DEST_EXISTS + 1;//  53/-1999999946 {}
  constant Int oGET_DEST_X          = oSET_DEST_EXISTS + 1;//  54/-1999999945 {}
  constant Int oGET_DEST_Y          = oGET_DEST_X + 1;    //  55/-1999999944 {}
  constant Int oSET_DEST_X          = oGET_DEST_Y + 1;    //  56/-1999999943 {}
