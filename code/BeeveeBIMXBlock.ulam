  constant Int oRED_WARNING_TRACK   = oSET_DEST_Y + 1;    //  58/-1999999941 {}
  constant Int oRED_PRE_WARNING     = oRED_WARNING_TRACK + 1;//  59/-1999999940 {}
  constant Int oGREEN_LEVEL         = oRED_PRE_WARNING + 1;//  60/-1999999939 {}
  constant Int oCMP_EQ              = oGREEN_LEVEL + 1;   //  61/-1999999938 {}
  constant Int oCMP_NE              = oCMP_EQ + 1;        //  62/-1999999937 {}
