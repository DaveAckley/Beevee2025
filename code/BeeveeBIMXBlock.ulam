quark CodeConstants + DTU + Fail {

  //// FUNCTION ADDRS
  constant Int fTIME_EXPIRED        =   1;   // 
  constant Int fTIME_OR_NOTALLRED   =   4;   // 
  constant Int fTIME_OR_ALLRED      =  15;   // 
  constant Int fEAST_AND_ON_LINE    =  26;   // 
  constant Int fCLOK_EDGE_FRONT     =  82;   // true on front tick or front tock
  constant Int fTIMER_DONE          =  34;   // 
  constant Int fINCR_TIMER_CHECK    =  37;   // 
  constant Int fTIME_OR_GREEN       =  40;   // 
  constant Int fEF_COUNT_TILE       =  47;   // EVENT FUNCTION: increment pos on front tick/tock events
  constant Int fTRUE                =  58;   // always true
  constant Int fFALSE               =  61;   // always false
  constant Int fOFFLINE_FRONT       =  64;   // true on front not tick and not tock
  constant Int fHARD_OFFLINE_FRONT  =  69;   // true on front not tick and not tock for quite a consecutive while
  constant Int fCLOK_TICK_FRONT     =  72;   // true on front tick
  constant Int fCLOK_TOCK_FRONT     =  77;   // true on front tock
  constant Int fCLOK_EDGE_REAR      =  87;   // true on rear tick or rear tock
  constant Int fSMALL_GREY_DEV      =  92;   // true on small deviation, meaning 128+-25 == 103..153
  constant Int fCLOK_EDGE_TUNED     = 102;   // true on front edge and small deviation
  constant Int fSAME_EDGE           = 109;   // true if front and back on tick or tock
  constant Int fDIFF_EDGE           = 117;   // true if front and back on tick and tock or tock and tick
  constant Int fSTOPPED             = 128;   // true if valid speed is 0
  constant Int fROLLING_STOPPED     = 135;   // true if over an edge and valid speed is at most 4
  constant Int fSTOP_DRIVE_SLOW     = 145;   // done if hard offline, or red warning
  constant Int fSTOP_DRIVE_FAST     = 150;   // done if hard offline, or red prewarning, or red warning
  constant Int fWAIT_A_WHILE        = 156;   // delay for some time
  constant Int fRED_APPROACH        = 165;   // 
  constant Int fRED_RETREAT         = 187;   // 
  constant Int fTURN_RIGHT_XI       = 578;   // Minimal right turn from tick to tock or vv with XI
  constant Int fTURN_RIGHT          = 596;   // Turn right from tick to tock or vv
  constant Int fFWD_1SQ_ONLY        = 462;   // Go forward from tick to tock or vv
  constant Int fDRIVE_TO_ORIGIN14   = 207;   // nth**nth attempt to drive to origin
  constant Int fFWD_1SQ             = 455;   // Go forward from tick to tock or vv, then get onto that square
  constant Int fTURN_LEFT           = 543;   // Turn left from tick to tock or vv
  // FUNCTION fDRIVE_TO_DEST
  //   Reduce distance between XYPOS and XYDEST to zero ho ho. Theory of
  //   operation, version 0: See if moving on the current heading will
  //   reduce total distance. If so, go forward a square, if not, turn
  //   left. Repeat until distance is zero, then clear dest exists.
  //   
  constant Int fDRIVE_TO_DEST       = 316;
  constant Int fFWD_1SQ_ONLY_SLO    = 516;   // Go forward from tick to tock or vv at up to slow speed
  constant Int fFWD_1SQ_ONLY_MED    = 489;   // Go forward from tick to tock or vv at up to medium speed
  constant Int fTURN_RIGHT_FROM_TICK = 631;   // Turn right from tick to tock, maintaining heading if set
  constant Int fTURN_RIGHT_FROM_TOCK = 638;   // Turn right from tock to tick, maintaining heading if set
  constant Int fTURN_LEFT_FROM_TICK = 645;   // Turn left from tick to tock, maintaining heading if set
  constant Int fTURN_LEFT_FROM_TOCK = 652;   // Turn left tock to tick, maintaining heading if set
  //// END FUNCTION ADDRS

  String nameOfFunction(Int funcaddr) {
    String ret = nameOfFunctionOrNull(funcaddr);
    if (!(Bool) ret) ret = "<ENOMETH>";
    return ret;
  }
        
  String nameOfFunctionOrNull(Int funcaddr) {
    if (funcaddr == fTIME_EXPIRED) return "fTIME_EXPIRED";
    if (funcaddr == fTIME_OR_NOTALLRED) return "fTIME_OR_NOTALLRED";
    if (funcaddr == fTIME_OR_ALLRED) return "fTIME_OR_ALLRED";
    if (funcaddr == fEAST_AND_ON_LINE) return "fEAST_AND_ON_LINE";
    if (funcaddr == fCLOK_EDGE_FRONT) return "fCLOK_EDGE_FRONT";
    if (funcaddr == fTIMER_DONE) return "fTIMER_DONE";
    if (funcaddr == fINCR_TIMER_CHECK) return "fINCR_TIMER_CHECK";
    if (funcaddr == fTIME_OR_GREEN) return "fTIME_OR_GREEN";
    if (funcaddr == fEF_COUNT_TILE) return "fEF_COUNT_TILE";
    if (funcaddr == fTRUE) return "fTRUE";
    if (funcaddr == fFALSE) return "fFALSE";
    if (funcaddr == fOFFLINE_FRONT) return "fOFFLINE_FRONT";
    if (funcaddr == fHARD_OFFLINE_FRONT) return "fHARD_OFFLINE_FRONT";
    if (funcaddr == fCLOK_TICK_FRONT) return "fCLOK_TICK_FRONT";
    if (funcaddr == fCLOK_TOCK_FRONT) return "fCLOK_TOCK_FRONT";
    if (funcaddr == fCLOK_EDGE_REAR) return "fCLOK_EDGE_REAR";
    if (funcaddr == fSMALL_GREY_DEV) return "fSMALL_GREY_DEV";
    if (funcaddr == fCLOK_EDGE_TUNED) return "fCLOK_EDGE_TUNED";
    if (funcaddr == fSAME_EDGE) return "fSAME_EDGE";
    if (funcaddr == fDIFF_EDGE) return "fDIFF_EDGE";
    if (funcaddr == fSTOPPED) return "fSTOPPED";
    if (funcaddr == fROLLING_STOPPED) return "fROLLING_STOPPED";
    if (funcaddr == fSTOP_DRIVE_SLOW) return "fSTOP_DRIVE_SLOW";
    if (funcaddr == fSTOP_DRIVE_FAST) return "fSTOP_DRIVE_FAST";
    if (funcaddr == fWAIT_A_WHILE) return "fWAIT_A_WHILE";
    if (funcaddr == fRED_APPROACH) return "fRED_APPROACH";
    if (funcaddr == fRED_RETREAT) return "fRED_RETREAT";
    if (funcaddr == fTURN_RIGHT_XI) return "fTURN_RIGHT_XI";
    if (funcaddr == fTURN_RIGHT) return "fTURN_RIGHT";
    if (funcaddr == fFWD_1SQ_ONLY) return "fFWD_1SQ_ONLY";
    if (funcaddr == fDRIVE_TO_ORIGIN14) return "fDRIVE_TO_ORIGIN14";
    if (funcaddr == fFWD_1SQ) return "fFWD_1SQ";
    if (funcaddr == fTURN_LEFT) return "fTURN_LEFT";
    if (funcaddr == fDRIVE_TO_DEST) return "fDRIVE_TO_DEST";
    if (funcaddr == fFWD_1SQ_ONLY_SLO) return "fFWD_1SQ_ONLY_SLO";
    if (funcaddr == fFWD_1SQ_ONLY_MED) return "fFWD_1SQ_ONLY_MED";
    if (funcaddr == fTURN_RIGHT_FROM_TICK) return "fTURN_RIGHT_FROM_TICK";
    if (funcaddr == fTURN_RIGHT_FROM_TOCK) return "fTURN_RIGHT_FROM_TOCK";
    if (funcaddr == fTURN_LEFT_FROM_TICK) return "fTURN_LEFT_FROM_TICK";
    if (funcaddr == fTURN_LEFT_FROM_TOCK) return "fTURN_LEFT_FROM_TOCK";

    String nullString;
    return nullString;
  }

