  MotorCmd makeMotorCmdForTRAKt(TRAKt t) {
    if (t >= cTRAKT_MOTORCMDS.lengthof) fail(__FILE__,__LINE__,"bad motorcmd code");
    return cTRAKT_MOTORCMDS[t];
  }

  String nameOfMotorCmd(Unsigned motorcmdidx) {
    String ret = nameOfMotorCmdOrNull(motorcmdidx);
    if (!(Bool) ret) ret = "<ENOMOTC>";
    return ret;
  }
        
  String nameOfMotorCmdOrNull(Unsigned motorcmdidx) {
    String ret;
    if (motorcmdidx < cTRAKT_MOTORCMDS.lengthof)
      ret = cTRAKT_MOTORCMDS[motorcmdidx].mTRAKtName;
    return ret;      
  }

  //// OPERATOR EVAL
  Bool evaluateThisOperatorOnly(Int o, MetroState & ms) {
    mD&&pR("ETOPO10")&&pR(o);
    NAFI & s = ms.getNAFI();
    GTCC & g = ms.getGTCC();
    LOCZ & l = ms.getLOCZ();
    ELOCZ & z = ms.getELOCZ();
    TRAKtor & t = g.mStateMachine;
    HINFO & h = ms.getHINFO();
    TRAKtorEvent e = ms.mTRAKtorEvent;
        
    if (o >= cFOC_MIN_IMMEDIATE && o <= cFOC_MAX_IMMEDIATE) {
      Bool ret = s.push(o);
      mD&&s.pRStack("ETOPO11");
      return ret;
    }
    Int v[10]; // temps 0..9
    mD&&pR("ETOPO12")&&pR(nameOfOperator(o));
    mD&&s.pRStack("ETOPO13");
    which(o) {
    case oRAND_BETWEEN: {  // stack is [... LO HI ]
      if (!s.pop(v[0])) return false;   // v[0] <- HI or fail, stack [ ... LO ]
      if (!s.pop(v[1])) return false;   // v[1] <- LO or fail, stack [ ... ]
      {
        Random random;
        v[2] = (Int) random.between(v[1],v[0]);
      }
      if (!s.push(v[2])) return false;  // stack [ ... RAND# ]
      return true
; }
    case oIS_EVENT_AN_EDGE: {  // EVENT OPERATOR
      // stack is [ stuff.. ]
      return
        s.push((e == cTKTR_FRONT_TICK ||
                e == cTKTR_FRONT_TOCK ||
                e == cTKTR_REAR_TICK ||
                e == cTKTR_REAR_TOCK) ? 1 : 0)  // stack [ stuff.. EVENTISEDGE ]
; }
    case oGET_GSCOUNTER: {       // stack is [ ... ]
      v[0] = (Int) l.mGeneralStateCounter;    // v[0] <- general state counter
      /*mD&&*/s.pRStack("oGET_GSCOUNTER=")&&pR(v[0]);  // DEBUG
      if (!s.push(v[0])) return false;  // stack [ ..., GSCOUNTER ]
      return true
; }
    case oDECR_GSCOUNTER: {       // stack is [ ... ]
      v[0] = (Int) --l.mGeneralStateCounter;    // v[0] <- --general state counter
      /*mD&&*/s.pRStack("oDECR_GSCOUNTER=")&&pR(l);  // DEBUG
      if (!s.push(v[0])) return false;  // stack [ ..., GSCOUNTER ]
      return true
; }
    case oSET_GSCOUNTER: {       // stack is [ ..., NEWGSCOUNTER ]
      if (!s.pop(v[0])) return false;   // v[0] <- NEWGS or fail, stack [ ... ]
      if (v[0] < 0) return false;       // Need non-neg!
      l.mGeneralStateCounter = (LOCZ.GSCounter) v[0];
      /*mD&&*/s.pRStack("oSET_GSCOUNTER=")&&pR(l);  // DEBUG
      return true
; }
    case oSET_SMTIMER: {       // stack is [ ..., COUNT ]
      if (!s.pop(v[0])) return false;   // v[0] <- COUNT or fail, stack [ ... ]
      mD&&s.pRStack("oSET_SMTIMER10=")&&pR(v[0]);  // DEBUG
      if (v[0] < 0) return false;       // Need non-neg!
      g.setSMTimer((Unsigned) v[0]);
      return true
; }
    case oGET_SMTIMER: {       // stack is [ stuff.. ]
      v[0] = (Int) g.getSMTimer();    // v[0] <- SMCOUNTER
      mD&&s.pRStack("oGET_SMTIMER10=")&&pR(v[0]);  // DEBUG
      if (!s.push(v[0])) return false;  // stack [ SMCOUNTER, stuff.. ]
      return true
; }
    case oIS_SMTIMER_DONE: {       // stack is [ stuff.. ]
      return s.push(g.isSMTimerDone() ? 1 : 0)  // stack [ SMTIMERDONE, stuff.. ]
; }
    case oINCR_SMTIMER: {       // stack is [ stuff.. ]
      return s.push(g.incrSMTimer() ? 1 : 0) /*&& s.pRStack("oINSMT")*/ // stack [ SMTIMERDONE, stuff.. ]
; }
    case oIS_EVENT_FRONT_EDGE: {  // EVENT OPERATOR
      // stack is [ stuff.. ]
      return
        s.push((e == cTKTR_FRONT_TICK ||
                e == cTKTR_FRONT_TOCK) ? 1 : 0)  // stack [ stuff.. EVENTISFRONTEDGE ]
; }
    case oNOP: { return true; }
    case oDUP: { return s.pop(v[0]) && s.push(v[0]) && s.push(v[0]); }
    case oDROP: { return s.pop(v[0]); }
    case oSWAP: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[1]) && s.push(v[0]); }
    case oALLRED: { return s.push(g.mAllRed ? 1 : 0); }
    case oHARD_OFFLINE_FRONT: { return s.push(g.mHardOfflineFrontTimer.alarm() ? 1 : 0); }
    case oCLOK_FRONT: { return s.push((Int) g.mNewCloks[0]); }
    case oCLOK_REAR: { return s.push((Int) g.mNewCloks[1]); }
    case oGREY_FCTR: { return s.push(g.mCenterGrey); }
    case oVALID_SPEED: { return s.push(l.mSpeed8Valid ? 1 : 0); }
    case oCUR_SPEED: { return s.push(l.mSpeed8 - 8); }
    case oVALID_HEAD: { return s.push(z.mHeadingValid ? 1 : 0); }
    case oCUR_HEAD: { return s.push(z.mHeading); }
    case oRESET_HEAD: {      z.mHeadingValid = false;
     z.mPosValid[0] = false;
     z.mPosValid[1] = false;
     return true    
  ; }
    case oSET_HEAD: {      if (!s.pop(v[0])) return false;
     if (v[0] > 3) return false;
     z.mHeadingValid = (v[0] >= 0); // negative heading means invalidate ugh
     z.mHeading = (AxialDir) v[0];
     return true
  ; }
    case oINCR_HEAD: {      s.pRStack("IN oINCR_HEAD",z.mHeadingValid ? "(valid)" : "(invalid)");
     if (!s.pop(v[0])) return false;
     if (z.mHeadingValid) {
       C2D fromc = beeveeAxisCoord(z.mHeading);
       z.mHeading = adjacentAxialDir(z.mHeading, v[0] > 0);
       C2D toc = beeveeAxisCoord(z.mHeading);
       C2D netc = toc-fromc;
       if (z.mPosValid[0]) z.mPosH[0] = (ELOCZ.TileCount) (z.mPosH[0] + netc.getX());
       if (z.mPosValid[1]) z.mPosH[1] = (ELOCZ.TileCount) (z.mPosH[1] + netc.getY());
     }
     C2D atc(z.mPosH[0],z.mPosH[1]);
     s.pR(getAxialDirName(z.mHeading))&&s.pR(atc);
     return true
  ; }
    case oINCR_POS: {      if (!s.pop(v[0])) return false;
     s.mD&&s.pRStack("IN oINCR_POS valid=",
       z.mHeadingValid ? "+h" : "-h",
       z.mPosValid[1] ? "+p" : "-p");
     if (!z.mHeadingValid) {
       z.mPosValid[0] = false;
       z.mPosValid[1] = false;
       return true;   // Nothing to do
     }
     AxialDir head = z.mHeading;
     if (v[0] < 0) {
       head = oppositeAxialDir(head);
       v[0] = -v[0];
     }
     // v[0] >= 0
     ELOCZ.TileCount incr = (ELOCZ.TileCount) v[0];
     if (head == cW) {
       if (z.mPosValid[0]) z.mPosH[0] += incr;
     } else if (head == cN) {
       if (z.mPosValid[1]) z.mPosH[1] += incr;
     } else if (head == cS) {
       if (z.mPosValid[1]) z.mPosH[1] -= incr;
     } else if (head == cE) {
       if (z.mPosValid[0]) z.mPosH[0] -= incr;
     }
     return true
  ; }
    case oGET_XPOS: {      if (z.mPosValid[0]) v[0] = (Int) z.mPosH[0]/2; ///XXXRECHECK
     else v[0] = 0;
     if (!s.push(v[0])) return false;   // get x
     return true
  ; }
    case oGET_YPOS: {      if (z.mPosValid[1]) v[0] = (Int) z.mPosH[1]/2; ///XXXRECHECK
     else v[0] = 0;
     if (!s.push(v[0])) return false;   // get y
     return true
  ; }
    case oSET_XPOS: {      if (!s.pop(v[0])) return false;     // get x
     z.mPosValid[0] = (v[0] >= 0);
     if (z.mPosValid[0]) z.mPosH[0] = (ELOCZ.TileCount) (2*v[0]);
     return true
  ; }
    case oSET_YPOS: {      if (!s.pop(v[0])) return false;     // get y
     z.mPosValid[1] = (v[0] >= 0);
     if (z.mPosValid[1]) z.mPosH[1] = (ELOCZ.TileCount) (2*v[0]);
     return true
  ; }
    case oSET_GRID_WIDTH: {      if (!s.pop(v[0])) return false;     // get w
     h.mGridSize[0] = (ASCII) v[0];
     return true
  ; }
    case oSET_GRID_HEIGHT: {      if (!s.pop(v[0])) return false;     // get h
     h.mGridSize[1] = (ASCII) v[0];
     return true
  ; }
    case oGET_GRID_WIDTH: { return s.push((Int) h.mGridSize[0]); }
    case oGET_GRID_HEIGHT: { return s.push((Int) h.mGridSize[1]); }
    case oGET_DEST_EXISTS: { return s.push(h.mDestinationExists ? 1 : 0); }
    case oSET_DEST_EXISTS: {      if (!s.pop(v[0])) return false;     // get bool
     h.mDestinationExists = (v[0] != 0);
     return true
; }
    case oGET_DEST_X: { return s.push((Int) (h.mDestinationExists ? h.mDestination[0] : ASCII.maxof)); }
    case oGET_DEST_Y: { return s.push((Int) (h.mDestinationExists ? h.mDestination[1] : ASCII.maxof)); }
    case oSET_DEST_X: {      if (!s.pop(v[0])) return false;     // get bool
     h.mDestination[0] = (ASCII) v[0];
     return true
; }
    case oSET_DEST_Y: {      if (!s.pop(v[0])) return false;     // get bool
     h.mDestination[1] = (ASCII) v[0];
     return true
; }
    case oRED_WARNING_TRACK: { return s.push(l.mWarningTrack); }
    case oRED_PRE_WARNING: { return s.push(l.mPreWarning); }
    case oGREEN_LEVEL: { return s.push(l.mGreenLevel); }
    case oCMP_EQ: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] == v[1]); }
    case oCMP_NE: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] != v[1]); }
    case oCMP_LT: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] < v[1]); }
    case oCMP_LE: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] <= v[1]); }
    case oCMP_GT: { return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] > v[1]); }
    case oCMP_GE: { return /*s.pRStack("IN oCMP_GE") &&*/ s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] >= v[1]) /*&& s.pRStack("OUT oCMP_GE")*/ ; }
    case oMAX: { return s.pop(v[1]) && s.pop(v[0]) && s.push(max(v[0],v[1])); }
    case oMIN: { return s.pop(v[1]) && s.pop(v[0]) && s.push(min(v[0],v[1])); }
    case oADD: { return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]+v[1])); }
    case oSUB: { return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]-v[1])); }
    case oMUL: { return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]*v[1])); }
    case oDIV: { return s.pop(v[1]) && s.pop(v[0]) && v[1] != 0 &&s.push(s.clampImmed(v[0]/v[1])); }
    case oAND: { return s.pop(v[1]) && s.pop(v[0]) &&s.push(v[0] != 0 && v[1] != 0 ? 1 : 0); }
    case oOR: { return s.pop(v[1]) && s.pop(v[0]) &&s.push(v[0] != 0 || v[1] != 0 ? 1 : 0); }
    case oNOT: { return s.pop(v[0]) && s.push(v[0] == 0 ? 1 : 0); }
    case oNEG: { return s.pop(v[0]) && s.push(s.clampImmed(-v[0])); }
    case oSET_DEBUG: {      //if (!s.pRStack("SET_DEBUG")) return false;
     if (!s.pop(v[0])) return false;
     s.setDebugOutputEnabled(v[0]!=0);
     l.setDebugOutputEnabled(v[0]!=0);
     g.setDebugOutputEnabled(v[0]!=0);
     return true
; }
    }
    s.pRStack("ETOPOMISS")&&pR(o)&&pR(nameOfOperator(o));
    fail(__FILE__,__LINE__); 
    return false; // NOT REACHED
  }

  Bool isSpecialOp(Int o) {
    return 
         o == oENTER0
      || o == oENTER1
      || o == oENTER2
      || o == oENTER3
      || o == oGOTO
      || o == oGOTOZ
      || o == oGOTON
      || o == oJUMP
      || o == oJUMPZ
      || o == oRETURN0
      || o == oRETURN1
      || o == oRETURN2
      || o == oCALL0
      || o == oCALL1
      || o == oCALL2
      || o == oSTART_TRAKT
      || o == oWAIT_READY
      ;
  }

  Bool evaluateOperator(MetroState & ms) {
    NAFI & s = ms.getNAFI();
    GTCC & g = ms.getGTCC();
    LOCZ & l = ms.getLOCZ();
    ELOCZ & z = ms.getELOCZ();
    TRAKtor & t = g.mStateMachine;
    HINFO & h = ms.getHINFO();
    TRAKtorEvent e = ms.mTRAKtorEvent;

    Unsigned curpc;
    if (!s.getPC(curpc)) return false;
    mD&&pR("EVLOP10")&&pR(curpc);
    Int v[10]; // temps 0..9
    Int o;
    if (!readRAM((Int) curpc,o)) return false;
    (BeeveeParms.pNAFI_TRACING%2u == 1u)&&s.pRStack(nameOfOperator(o));
    if (!s.setPC(curpc + 1u)) return false;

    mD&&s.pRStack("EVLOP12")&&pR(nameOfOperator(o));
    /// handle 'special ops' here
    which(o) {
    case oENTER0: { return true; }
    case oENTER1: { return true; }
    case oENTER2: { return true; }
    case oENTER3: { return true; }
    case oGOTO: {  // UNCONDITIONAL ABSOLUTE GOTO: stack is [..., NEXTPC]
      return //s.pRStack("RET=") && // DEBUG
             s.pop(v[0])            // v0 <- nextpc
          && s.setPC(v[0])          // jump there
  ; }
    case oGOTOZ: {  // CONDITIONAL ABSOLUTE GOTO: stack is [..., IFZ, NEXTPC]
      return //bs.pRStack("IN oGOTOZ=") &&   // DEBUG
             s.pop(v[0])              // v0 <- NEXTPC  [..., IFZ]
          && s.pop(v[1])              // v1 <- IFZ  [...]
          && s.getPC(v[2])            // v2 <- .+1
          && ( ((v[1] != 0)             // done if IFZ non-zero
          //       && s.pRStack("NO JUMP OUT oGOTOZ=")
          )
             || (s.setPC(v[0])         // or jump to NEXTPC
          //       && s.pRStack("JUMP OUT oGOTOZ=")
          )
             )
  ; }
    case oGOTON: {  // CONDITIONAL ABSOLUTE GOTO: stack is [..., IFNZ, NEXTPC]
      return //s.pRStack("IN oGOTON=") &&   // DEBUG
             s.pop(v[0])              // v0 <- NEXTPC  [..., IFNZ]
          && s.pop(v[1])              // v1 <- IFNZ  [...]
          && s.getPC(v[2])            // v2 <- .+1
          && (  ((v[1] == 0)          // done if IFNZ zero
          //   && s.pRStack("NO JUMP OUT oGOTON=")
          )
             || (s.setPC(v[0])         // or jump to NEXTPC
          //  && s.pRStack("JUMP OUT oGOTON=")
          )
             )
  ; }
    case oJUMP: {  // UNCONDITIONAL RELATIVE GOTO: stack is [..., PCOFFSET]
      return s.pRStack("oJUMP=") &&   // DEBUG
             s.pop(v[0])              // v0 <- PCOFFSET  [...]
          && s.getPC(v[1])            // v2 <- .+1
          && s.setPC(v[1]+v[0]-1)  // jump to .+offset
  ; }
    case oJUMPZ: {  // CONDITIONAL RELATIVE GOTO: stack is [PCOFFSET IFZ ...]
      return s.pRStack("oJUMPZ=") &&   // DEBUG
             s.pop(v[0])              // v0 <- PCOFFSET  [IFZ ...]
          && s.pop(v[1])              // v1 <- condition  [...]
          && s.getPC(v[2])            // v2 <- .+1
          && (  v[1] != 0             // done if IFZ non-zero
             || s.setPC(v[2]+v[0]-1)  // jump to .+offset
             )
  ; }
    case oRETURN0: {  // FUNCTION RETURN0: stack is [RETADDR ...]
      return //s.pRStack("RET0=") &&   // DEBUG
             s.pop(v[0])            // v0 <- retaddr
          && s.setPC(v[0])          // jump to retaddr 
  ; }
    case oRETURN1: {  // FUNCTION RETURN1: stack is [RETVAL RETADDR ...]
      return //s.pRStack("RET1=") &&   // DEBUG
             s.pop(v[0])            // v0 <- retval
          && s.pop(v[1])            // v1 <- retaddr
          && s.push(v[0])           // restash retval
          && s.setPC(v[1])          // jump to retaddr 
  ; }
    case oRETURN2: {  // FUNCTION RETURN2: stack is [RETVAL2 RETVAL1 RETADDR ...]
      return s.pRStack("RET2=") &&   // DEBUG
             s.pop(v[0])            // v0 <- retval2
          && s.pop(v[1])            // v1 <- retval1
          && s.pop(v[2])            // v2 <- retaddr
          && s.push(v[1])           // restash retval1
          && s.push(v[0])           // restash retval2
          && s.setPC(v[1])          // jump to retaddr 
  ; }
    case oCALL0: {  // FUNCTION CALL: stack is [FUNCADDR ...]
      return s.pop(v[0])            // v0 <- funcaddr
          //&& s.pRStack(nameOfFunction(v[0])) // DEBUG
          && readRAM(v[0],v[1])     // v1 <- cRAM[funcaddr]
          && v[1] == oENTER0        // calladdr is func entry point
          && s.push(s.getPCOrDie()) // save retaddr
          && s.setPC(v[0] + 1)      // jump to funcaddr + 1, stack [RETADDR ...]
  ; }
    case oCALL1: {  // FUNCTION CALL: stack is [FUNCADDR ARG ...]
      return s.pop(v[0])            // v0 <- funcaddr
          //&& s.pRStack(nameOfFunction(v[0])) // DEBUG
          && readRAM(v[0],v[1])     // v1 <- cRAM[funcaddr]
          && v[1] == oENTER1        // calladdr is func entry point
          && s.pop(v[2])            // v2 <- ARG
          && s.push(s.getPCOrDie()) // push RETADDR
          && s.push(v[2])           // push ARG
          && s.setPC(v[0] + 1)      // jump to FUNCADDR + 1, stack [ARG RETADDR ...]
  ; }
    case oCALL2: {  // FUNCTION CALL: stack is [FUNCADDR ARG2 ARG1 ...]
      return s.pop(v[0])            // v0 <- funcaddr
          //&& s.pRStack(nameOfFunction(v[0])) // DEBUG
          && readRAM(v[0],v[1])     // v1 <- cRAM[funcaddr]
          && v[1] == oENTER2        // calladdr is func entry point
          && s.pop(v[2])            // v2 <- ARG2
          && s.pop(v[3])            // v2 <- ARG1
          && s.push(s.getPCOrDie()) // push RETADDR
          && s.push(v[3])           // push ARG1
          && s.push(v[2])           // push ARG2
          && s.setPC(v[0] + 1)      // jump to FUNCADDR + 1, stack [ARG2 ARG1 RETADDR ...]
  ; }
    case oSTART_TRAKT: {  // START TRAKT: stack is [TRAKT_NUM stuff.. ]
      if (!s.getPC(v[0])) return false; // getpc or fail
      if (!s.pop(v[1])) return false;   // pop TN or fail stack [ stuff.. ]
      if (v[1] < 0) return false;       // TN unsigned or fail

      if (t.startTRAKt(ms, (TRAKt) v[1])) { // try to start our trakt
        (BeeveeParms.pNAFI_TRACING%2u == 1u)&&pR("NATR/oSTART_TRAKT:started")&&s.pRStack(nameOfTRAKt((TRAKt) v[1]));
        s.pRStack("TRAKt ",nameOfTRAKt((TRAKt) v[1])," started");
        return true;                    // MOVE ON (PC incrd; stack popped)
      }
      // TRAKtor not ready: Block here
      (BeeveeParms.pNAFI_TRACING%2u == 1u)&&pR("NATR/oSTART_TRAKT:blocking")&&s.pRStack(nameOfTRAKt((TRAKt) v[1]));      
      if (!s.push(v[1])) return false;  // restore stack [ TN stuff.. ]
      if (s.setPC(v[0] - 1)) return false;  // back up PC (implying BLOCKED)
      return true;                      // TRY AGAIN (PC--; no stack change)
  ; }
    case oWAIT_READY: {  // WAIT READY: stack is [stuff.. ]
      if (t.isReady()) { // check if trakor is ready
        (BeeveeParms.pNAFI_TRACING%2u == 1u)&&s.pRStack("NATR/oWAIT_READY:done");
        return true;                    // MOVE ON (PC incrd)
      }
      // TRAKtor not ready: Block here
      if (!s.getPC(v[0])) return false; // getpc or fail
      if (s.setPC(v[0] - 1)) return false;  // back up PC (implying BLOCKED)
      (BeeveeParms.pNAFI_TRACING%2u == 1u)&&s.pRStack("NATR/oWAIT_READY:block");
      return true;                      // TRY AGAIN (PC--; no stack change)
  ; }

    /// else dish to general case
    otherwise: { return evaluateThisOperatorOnly(o, ms); }
    }
    return false; // NOT REACHED
  } // OPERATOR EVAL


  Bool isTRAKtDone(Int tn, MetroState & ms) {
    if (tn < 0) fail(__FILE__,__LINE__);
    MotorCmd mc = makeMotorCmdForTRAKt((TRAKt) tn);
    Int result;
    if (!mc.evalDoneCode(result,ms)) fail(__FILE__,__LINE__);
    return result != 0;
  } // isTRAKtDone


} // CodeMethods

