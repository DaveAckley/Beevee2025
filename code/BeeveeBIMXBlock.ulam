quark CodeConstants + DTU + Fail {

  //// FUNCTION ADDRS
  constant Int fTIME_OR_NOTALLRED   =   1;   // 
  constant Int fTIME_OR_ALLRED      =  12;   // 
  constant Int fEAST_AND_ON_LINE    =  23;   // 
  constant Int fCLOK_EDGE_FRONT     =  78;   // true on front tick or front tock
  constant Int fTIMER_DONE          =  31;   // 
  constant Int fINCR_TIMER_CHECK    =  34;   // 
  constant Int fTIME_OR_GREEN       =  37;   // 
  constant Int fEF_COUNT_TILE       =  44;   // EVENT FUNCTION: increment pos on front tick/tock events
  constant Int fTRUE                =  54;   // always true
  constant Int fFALSE               =  57;   // always false
  constant Int fOFFLINE_FRONT       =  60;   // true on front not tick and not tock
  constant Int fHARD_OFFLINE_FRONT  =  65;   // true on front not tick and not tock for quite a consecutive while
  constant Int fCLOK_TICK_FRONT     =  68;   // true on front tick
  constant Int fCLOK_TOCK_FRONT     =  73;   // true on front tock
  constant Int fCLOK_EDGE_REAR      =  83;   // true on rear tick or rear tock
  constant Int fSMALL_GREY_DEV      =  88;   // true on small deviation, meaning 128+-25 == 103..153
  constant Int fCLOK_EDGE_TUNED     =  98;   // true on front edge and small deviation
  constant Int fSAME_EDGE           = 105;   // true if front and back on tick or tock
  constant Int fDIFF_EDGE           = 113;   // true if front and back on tick and tock or tock and tick
  constant Int fSTOPPED             = 124;   // true if valid speed is 0
  constant Int fROLLING_STOPPED     = 131;   // true if over an edge and valid speed is at most 4
  constant Int fSTOP_DRIVE_SLOW     = 141;   // done if hard offline, or red warning
  constant Int fSTOP_DRIVE_FAST     = 146;   // done if hard offline, or red prewarning, or red warning
  constant Int fWAIT_A_WHILE        = 152;   // delay for some time
  constant Int fDRIVE_TO_ORIGIN14   = 161;   // nth**nth attempt to drive to origin
  constant Int fFWD_ONE_SQUARE      = 402;   // Go forward from tick to tock or vv, then get onto that square
  constant Int fTURN_LEFT           = 431;   // Turn left from tick to tock or vv
  constant Int fTURN_RIGHT_XI       = 466;   // Minimal right turn from tick to tock or vv with XI
  constant Int fTURN_RIGHT          = 484;   // Turn right from tick to tock or vv
  constant Int fFWD_ONE_SQUARE_ONLY = 409;   // Go forward from tick to tock or vv
  // FUNCTION fDRIVE_TO_DEST
  //   Reduce distance between XYPOS and XYDEST to zero ho ho. Theory of
  //   operation, version 0: See if moving on the current heading will
  //   reduce total distance. If so, go forward a square, if not, turn
  //   left. Repeat until distance is zero, then clear dest exists.
  //   
  constant Int fDRIVE_TO_DEST       = 294;
  constant Int fFAST_FWD_TO_TOCK    = 543;   // Go forward, maintaining pos if heading is set
  constant Int fFAST_FWD_TO_TICK    = 537;   // Go forward, maintaining pos if heading is set
  constant Int fFWD_TO_TICK         = 519;   // Go forward, maintaining pos if heading is set
  constant Int fFWD_TO_TOCK         = 528;   // Go forward, maintaining pos if heading is set
  constant Int fTURN_RIGHT_FROM_TICK = 549;   // Turn right from tick to tock, maintaining heading if set
  constant Int fTURN_RIGHT_FROM_TOCK = 556;   // Turn right from tock to tick, maintaining heading if set
  constant Int fTURN_LEFT_FROM_TICK = 563;   // Turn left from tick to tock, maintaining heading if set
  constant Int fTURN_LEFT_FROM_TOCK = 570;   // Turn left tock to tick, maintaining heading if set
  //// END FUNCTION ADDRS

  String nameOfFunction(Int funcaddr) {
    String ret = nameOfFunctionOrNull(funcaddr);
    if (!(Bool) ret) ret = "<ENOMETH>";
    return ret;
  }
        
  String nameOfFunctionOrNull(Int funcaddr) {
    if (funcaddr == fTIME_OR_NOTALLRED) return "fTIME_OR_NOTALLRED";
    if (funcaddr == fTIME_OR_ALLRED) return "fTIME_OR_ALLRED";
    if (funcaddr == fEAST_AND_ON_LINE) return "fEAST_AND_ON_LINE";
    if (funcaddr == fCLOK_EDGE_FRONT) return "fCLOK_EDGE_FRONT";
    if (funcaddr == fTIMER_DONE) return "fTIMER_DONE";
    if (funcaddr == fINCR_TIMER_CHECK) return "fINCR_TIMER_CHECK";
    if (funcaddr == fTIME_OR_GREEN) return "fTIME_OR_GREEN";
    if (funcaddr == fEF_COUNT_TILE) return "fEF_COUNT_TILE";
    if (funcaddr == fTRUE) return "fTRUE";
    if (funcaddr == fFALSE) return "fFALSE";
    if (funcaddr == fOFFLINE_FRONT) return "fOFFLINE_FRONT";
    if (funcaddr == fHARD_OFFLINE_FRONT) return "fHARD_OFFLINE_FRONT";
    if (funcaddr == fCLOK_TICK_FRONT) return "fCLOK_TICK_FRONT";
    if (funcaddr == fCLOK_TOCK_FRONT) return "fCLOK_TOCK_FRONT";
    if (funcaddr == fCLOK_EDGE_REAR) return "fCLOK_EDGE_REAR";
    if (funcaddr == fSMALL_GREY_DEV) return "fSMALL_GREY_DEV";
    if (funcaddr == fCLOK_EDGE_TUNED) return "fCLOK_EDGE_TUNED";
    if (funcaddr == fSAME_EDGE) return "fSAME_EDGE";
    if (funcaddr == fDIFF_EDGE) return "fDIFF_EDGE";
    if (funcaddr == fSTOPPED) return "fSTOPPED";
    if (funcaddr == fROLLING_STOPPED) return "fROLLING_STOPPED";
    if (funcaddr == fSTOP_DRIVE_SLOW) return "fSTOP_DRIVE_SLOW";
    if (funcaddr == fSTOP_DRIVE_FAST) return "fSTOP_DRIVE_FAST";
    if (funcaddr == fWAIT_A_WHILE) return "fWAIT_A_WHILE";
    if (funcaddr == fDRIVE_TO_ORIGIN14) return "fDRIVE_TO_ORIGIN14";
    if (funcaddr == fFWD_ONE_SQUARE) return "fFWD_ONE_SQUARE";
    if (funcaddr == fTURN_LEFT) return "fTURN_LEFT";
    if (funcaddr == fTURN_RIGHT_XI) return "fTURN_RIGHT_XI";
    if (funcaddr == fTURN_RIGHT) return "fTURN_RIGHT";
    if (funcaddr == fFWD_ONE_SQUARE_ONLY) return "fFWD_ONE_SQUARE_ONLY";
    if (funcaddr == fDRIVE_TO_DEST) return "fDRIVE_TO_DEST";
    if (funcaddr == fFAST_FWD_TO_TOCK) return "fFAST_FWD_TO_TOCK";
    if (funcaddr == fFAST_FWD_TO_TICK) return "fFAST_FWD_TO_TICK";
    if (funcaddr == fFWD_TO_TICK) return "fFWD_TO_TICK";
    if (funcaddr == fFWD_TO_TOCK) return "fFWD_TO_TOCK";
    if (funcaddr == fTURN_RIGHT_FROM_TICK) return "fTURN_RIGHT_FROM_TICK";
    if (funcaddr == fTURN_RIGHT_FROM_TOCK) return "fTURN_RIGHT_FROM_TOCK";
    if (funcaddr == fTURN_LEFT_FROM_TICK) return "fTURN_LEFT_FROM_TICK";
    if (funcaddr == fTURN_LEFT_FROM_TOCK) return "fTURN_LEFT_FROM_TOCK";

    String nullString;
    return nullString;
  }

  //// OPERATORS
  constant Int cMIN_OP_VAL = -2000000000;
        
  constant Int oRAND_BETWEEN        = cMIN_OP_VAL + 1;    //   0/-1999999999 {}
  constant Int oIS_EVENT_AN_EDGE    = oRAND_BETWEEN + 1;  //   1/-1999999998 
  constant Int oGET_GSCOUNTER       = oIS_EVENT_AN_EDGE + 1;//   2/-1999999997 
  constant Int oDECR_GSCOUNTER      = oGET_GSCOUNTER + 1; //   3/-1999999996 {}
