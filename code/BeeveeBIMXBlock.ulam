      .mSpeedNotWheel = false,
      .mSpeed1 = 1,                   // left
      .mSpeed2 = 3,                   // right
      .mFuncNotOp = true,
      .mDoneCode = fCLOK_EDGE_FRONT,
   },
   {  .mTRAKtName = "cTRA_FIND_LINE_RIGHT",
      .mTRAKtNumber = 1u,
      .mSpeedNotWheel = false,
      .mSpeed1 = 3,                   // left
      .mSpeed2 = 1,                   // right
      .mFuncNotOp = true,
      .mDoneCode = fCLOK_EDGE_FRONT,
   },
   {  .mTRAKtName = "cTRA_TUNE_LINE",
      .mTRAKtNumber = 2u,
      .mSpeedNotWheel = true,
      .mSpeed1 = 1,                   // min
      .mSpeed2 = 2,                   // max
      .mFuncNotOp = true,
      .mDoneCode = fCLOK_EDGE_TUNED,
   },
   {  .mTRAKtName = "cTRA_DRESS_LINE_FWD",
      .mTRAKtNumber = 3u,
      .mSpeedNotWheel = true,
      .mSpeed1 = 1,                   // min
      .mSpeed2 = 3,                   // max
      .mFuncNotOp = true,
