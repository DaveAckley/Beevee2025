    21u,  //< start idx of SRFG Right Front Green Detector
    22u,  //< start idx of SRFY Right Front Yellow Detector
    23u,  //< start idx of SRLY Right Left-side Yellow Detector
    23u,  //< start idx of SRRY Right Right-side Yellow Detector
    23u,  //< start idx of SDBG10 Debug sensor 10
