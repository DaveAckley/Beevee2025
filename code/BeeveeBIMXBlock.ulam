  }; // constant Int cRAM[226]

  //// FUNCTION ADDRS
  constant Int fEAST_AND_ON_LINE    =   1;   // None
  constant Int fCLOK_EDGE_FRONT     =  40;   // true on front tick or front tock
  constant Int fDO_TRAKT            =   9;   // run a trakt and wait till it's done
  constant Int fINCR_TIMER_CHECK    =  13;   // None
  constant Int fTRUE                =  16;   // always true
  constant Int fFALSE               =  19;   // always false
  constant Int fOFFLINE_FRONT       =  22;   // true on front not tick and not tock
  constant Int fHARD_OFFLINE_FRONT  =  27;   // true on front not tick and not tock for quite a consecutive while
  constant Int fCLOK_TICK_FRONT     =  30;   // true on front tick
  constant Int fCLOK_TOCK_FRONT     =  35;   // true on front tock
  constant Int fCLOK_EDGE_REAR      =  45;   // true on rear tick or rear tock
  constant Int fSMALL_GREY_DEV      =  50;   // true on small deviation, meaning 128+-25 == 103..153
  constant Int fCLOK_EDGE_TUNED     =  60;   // true on front edge and small deviation
  constant Int fSAME_EDGE           =  67;   // true if front and back on tick or tock
  constant Int fDIFF_EDGE           =  75;   // true if front and back on tick and tock or tock and tick
  constant Int fSTOPPED             =  86;   // true if valid speed is 0
  constant Int fSTOP_DRIVE_SLOW     =  93;   // done if hard offline, or red warning
  constant Int fSTOP_DRIVE_FAST     =  98;   // done if hard offline, or red prewarning, or red warning
  constant Int fWAIT_A_WHILE        = 104;   // delay for rxtimer ARG time
  constant Int fDRIVE_TO_ORIGIN11   = 110;   // second attempt to drive to origin
  constant Int fFWD_TO_TICK         = 164;   // Go forward, maintaining pos if heading is set
  constant Int fTURN_RIGHT_TICK     = 172;   // Turn right, maintaining heading if set
  constant Int fTURN_LEFT_TICK      = 181;   // Turn left, maintaining heading if set
  constant Int fDRIVE_BOX_SPIKE     = 190;   // 'infinite' loop making a clockwise box
  constant Int fDRIVE_BOX_SPIKE2    = 200;   // 'infinite' loop making a bigger clockwise box
  constant Int fDRIVE_BORDER_RIGHT  = 214;   // 'infinite' loop making a clockwise box at the border
  //// END FUNCTION ADDRS

  String nameOfFunction(Int funcaddr) {
    String ret = nameOfFunctionOrNull(funcaddr);
    if (!(Bool) ret) ret = "<ENOMETH>";
    return ret;
  }
        
  String nameOfFunctionOrNull(Int funcaddr) {
    if (funcaddr == fEAST_AND_ON_LINE) return "fEAST_AND_ON_LINE";
    if (funcaddr == fCLOK_EDGE_FRONT) return "fCLOK_EDGE_FRONT";
    if (funcaddr == fDO_TRAKT) return "fDO_TRAKT";
    if (funcaddr == fINCR_TIMER_CHECK) return "fINCR_TIMER_CHECK";
    if (funcaddr == fTRUE) return "fTRUE";
    if (funcaddr == fFALSE) return "fFALSE";
    if (funcaddr == fOFFLINE_FRONT) return "fOFFLINE_FRONT";
    if (funcaddr == fHARD_OFFLINE_FRONT) return "fHARD_OFFLINE_FRONT";
    if (funcaddr == fCLOK_TICK_FRONT) return "fCLOK_TICK_FRONT";
    if (funcaddr == fCLOK_TOCK_FRONT) return "fCLOK_TOCK_FRONT";
    if (funcaddr == fCLOK_EDGE_REAR) return "fCLOK_EDGE_REAR";
    if (funcaddr == fSMALL_GREY_DEV) return "fSMALL_GREY_DEV";
    if (funcaddr == fCLOK_EDGE_TUNED) return "fCLOK_EDGE_TUNED";
    if (funcaddr == fSAME_EDGE) return "fSAME_EDGE";
    if (funcaddr == fDIFF_EDGE) return "fDIFF_EDGE";
    if (funcaddr == fSTOPPED) return "fSTOPPED";
    if (funcaddr == fSTOP_DRIVE_SLOW) return "fSTOP_DRIVE_SLOW";
    if (funcaddr == fSTOP_DRIVE_FAST) return "fSTOP_DRIVE_FAST";
    if (funcaddr == fWAIT_A_WHILE) return "fWAIT_A_WHILE";
    if (funcaddr == fDRIVE_TO_ORIGIN11) return "fDRIVE_TO_ORIGIN11";
    if (funcaddr == fFWD_TO_TICK) return "fFWD_TO_TICK";
    if (funcaddr == fTURN_RIGHT_TICK) return "fTURN_RIGHT_TICK";
    if (funcaddr == fTURN_LEFT_TICK) return "fTURN_LEFT_TICK";
    if (funcaddr == fDRIVE_BOX_SPIKE) return "fDRIVE_BOX_SPIKE";
    if (funcaddr == fDRIVE_BOX_SPIKE2) return "fDRIVE_BOX_SPIKE2";
    if (funcaddr == fDRIVE_BORDER_RIGHT) return "fDRIVE_BORDER_RIGHT";

    String nullString;
    return nullString;
  }

  //// OPERATORS
  constant Int cMIN_OP_VAL = -2000000000;
        
  constant Int oSET_SMTIMER         = cMIN_OP_VAL + 1;    //   0/-1999999999 {}
  constant Int oGET_SMTIMER         = oSET_SMTIMER + 1;   //   1/-1999999998 
  constant Int oIS_SMTIMER_DONE     = oGET_SMTIMER + 1;   //   2/-1999999997 
  constant Int oINCR_SMTIMER        = oIS_SMTIMER_DONE + 1;//   3/-1999999996 {}
  constant Int oNOP                 = oINCR_SMTIMER + 1;  //   4/-1999999995 
  constant Int oDUP                 = oNOP + 1;           //   5/-1999999994 {}
  constant Int oDROP                = oDUP + 1;           //   6/-1999999993 
  constant Int oSWAP                = oDROP + 1;          //   7/-1999999992 {}
  constant Int oENTER0              = oSWAP + 1;          //   8/-1999999991 {}
  constant Int oENTER1              = oENTER0 + 1;        //   9/-1999999990 {}
  constant Int oENTER2              = oENTER1 + 1;        //  10/-1999999989 
  constant Int oENTER3              = oENTER2 + 1;        //  11/-1999999988 
  constant Int oGOTO                = oENTER3 + 1;        //  12/-1999999987 {}
  constant Int oGOTOZ               = oGOTO + 1;          //  13/-1999999986 
  constant Int oJUMP                = oGOTOZ + 1;         //  14/-1999999985 
  constant Int oJUMPZ               = oJUMP + 1;          //  15/-1999999984 
  constant Int oRETURN0             = oJUMPZ + 1;         //  16/-1999999983 {}
  constant Int oRETURN1             = oRETURN0 + 1;       //  17/-1999999982 {}
  constant Int oRETURN2             = oRETURN1 + 1;       //  18/-1999999981 
  constant Int oCALL0               = oRETURN2 + 1;       //  19/-1999999980 {}
  constant Int oCALL1               = oCALL0 + 1;         //  20/-1999999979 {}
  constant Int oCALL2               = oCALL1 + 1;         //  21/-1999999978 
  constant Int oSTART_TRAKT         = oCALL2 + 1;         //  22/-1999999977 {}
