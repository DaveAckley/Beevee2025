  typedef XBlockStgT(2u,1u,2u,1u) XBlock_TILES_BASE;

  //// URSELF API  
  @Override Void behave() { pursueIntention(); }

  constant Unsigned cSIDE_LENGTHS[4] = { 1, 2, 2, 1 };

  // Starting indices in cTAPS_BY_SIDE for each side
  constant Unsigned cSIDE_TAPIDX[4] = {0, 1, 3, 5}; //< [0] W, [1] N, [2] S, [3] E
  constant TapIdx cTAPS_BY_SIDE[] = {
    BeeveeBIMXBlock.cTAPIDX_HEMP,  //  0: W #0
    BeeveeBIMXBlock.cTAPIDX_GTCC,  //  1: N #0
    BeeveeBIMXBlock.cTAPIDX_HTD8,  //  2: N #1
    BeeveeBIMXBlock.cTAPIDX_HEMP,  //  3: S #0
    BeeveeBIMXBlock.cTAPIDX_HEMP,  //  4: S #1
    BeeveeBIMXBlock.cTAPIDX_LOCZ,  //  5: E #0
  }; // cTAPS_BY_SIDE

  constant Unsigned cXBLOCK_INDEX = 1u;
        
  constant PocketDir cXBI_ORIGIN = cQUAD_NW;

  constant C2D cXBI_GRID_SIZE = { .x = 2, .y = 1 }; //< INTERNAL GRID SIZE
  constant C2D cXBI_GRID_STRIDE = { .x = 2, .y = 1 }; //< GRID STRIDE

  constant C2D cXBI_POS = { .x = -5, .y = -1 }; //< HC3 POS
  constant C2D cXBI_SIZ = { .x = 2, .y = 1 }; //< HC3 SIZ

  //// Intender API
  @Override Unsigned getIntentionClass() { return DefaultXBlockState.classidof; }

  //// XBlock API
  @Override Unsigned getXBlockIndex() { return cXBLOCK_INDEX; }
  @Override C2D getXBlockSize() { return cXBI_GRID_SIZE; }
  @Override C2D getXBlockStride() { return cXBI_GRID_STRIDE; }
  @Override C2D getXBlockOrigin() { return getXBInfoPosition(); }
  @Override SN getOriginSN() { return 8u; }

  //// XBInfo API 
  @Override String getXBInfoName() { return "TILES"; }
  @Override C2D getXBInfoPosition() { return cXBI_POS; }
  @Override C2D getXBInfoSize() { return cXBI_SIZ; }
  @Override PocketDir getXBInfoOrigin() { return cXBI_ORIGIN; }


// generateAxonTargetCode({'stride': [2, 1], 'pos': [-5, -1], 'originSN': 8, 'color': '#04f', 'taps': {'N': ['GTCC', 'HTD8'], 'E': ['LOCZ'], 'S': [], 'W': []}, 'axons': [['GTCC', 'TRAKPD'], ['LOCZ', 'LZRV']], 'number': 1, 'origin': 'NW', 'size': [2, 1], 'hc3size': [2, 1]})
  @Override
  virtual TapIdx getXBInfoAxonTarget(TapIdx tapidx) {
    BeeveeBIMXBlock bim;
    ClassId fromid = bim.getTAPClassIdFromTapIdx(tapidx);
    if (fromid == GTCC.classidof) return (TapIdx) bim.getTapIdxFromClassId(TRAKPD.classidof);
    if (fromid == LOCZ.classidof) return (TapIdx) bim.getTapIdxFromClassId(LZRV.classidof);
    return cTAPIDX_NONE;
  }


  //// XBInfo API
  @Override ClassId getXBInfoXBlockClass() { return self.classidof; }
  @Override Bool getXBInfoFeedDir(C2D relc, AxialDir & feedad, Bool & isinput) {
     fail(__FILE__,__LINE__,"WHY DO I EXIST? #METOO");
     return false;
  }
        
  @Override
  virtual TapIdx getXBInfoSideTAP(C2D relc, AxialDir side) {
    Int c = -1;
    if (side == cW || side == cE) c = relc.getY();
    else if (side == cN || side == cS) c = relc.getX();
    if (c < 0 || ((Unsigned) c) >= cSIDE_LENGTHS[side]) return 0u;
    return cTAPS_BY_SIDE[cSIDE_TAPIDX[side]+(Unsigned) c];
  }

} // XBlock_TILES

