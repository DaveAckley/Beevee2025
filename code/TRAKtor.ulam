transient TRAKtorState : Intention + DTU + QDebugUtils + Fail {
  SN mTRAKtorDriverSN = SN.maxof;
}

/** Simple-but-compound TRAK-grip action driver.
 */
quark TRAKtor + DTU + CodeMethods {

  //// TRAKtor AYNCHRONOUS EXTERNAL SERVICES

  Void step(GTCC & gtcc) {      // main entry point for single ew processing
    EventWindow ew;
    SN locsn, tdsn;
    if (!findOtherSNs(locsn,tdsn)) return; // not today
    LOCZ & locz = (LOCZ&) ew[locsn];
    TRAKtorDriver & td = (TRAKtorDriver&) ew[tdsn];
    update(gtcc, td, locz);
  }

  typedef Unsigned(5) TRAKt; //< traktor act codes
  // /** FIND_LINE_(LEFT|RIGHT)
