  // /** DRIVE FAST
  //     GOAL: Follow line as fast as possible
  //     PRE: on the line
  //     STATE: 
  //     POST: Wheel speeds are in (8,50)
  //     FAIL:
  // */
  // constant TRAKt tDRIVE_FAST = 11u;

  // /** EMERGENCY STOP
  //     GOAL: Stop the wheels
  //     PRE: Panic
  //     STATE: Unsettled
  //     POST: Wheels are (0,0)
  //     FAIL:
  // */
  // constant TRAKt tEMERGENCY_STOP = 12u; // MUST BE LAST/HIGHEST # DEFINED

  // BASE MOTOR COMMANDS PER TRAKT
