  MotorCmd makeCurrentMotorCmd() {
    MotorCmd mc = makeMotorCmdForTRAKt(mTRAKt);
    mc.takeDebug(self);
    return mc;
  }

  Bool isTRAKtDone(GTCC & g, LOCZ & l) {
    return isThisTRAKtDone(g,l,mTRAKt);
  }

  Bool isThisTRAKtDone(GTCC & g, LOCZ & l, TRAKt trakt) {
    TRAKtor & t = self;
    MotorCmd mc = makeMotorCmdForTRAKt(trakt);
    mc.takeDebug(self);
    Int result;
    if (mc.evalDoneCode(result,g,l,t)) return result != 0;
    fail(__FILE__,__LINE__);
    return false; // NOT REACHED
  }

  Bool pR(Self & s) {
    return pR(nameOfTRAKtorState(mTRAKtorState));
  }

  Bool reset() {
    if (mTRAKtorState != cTKST_FAIL)
      pR("TRAKtion reset from")&&pR(self);
    mTRAKtorState = cTKST_RESET;
    return true;
  }

  Bool takeTRAKt(TRAKt act) {
    if (mTRAKtorState != cTKST_READY) return false;
    mTRAKt = act;
    mTRAKtorState = cTKST_RUN;
    return true;
  }

  Bool isReset() { return mTRAKtorState == cTKST_RESET; }
  Bool isReady() { return mTRAKtorState == cTKST_READY; }
  Bool isRunning() { return mTRAKtorState == cTKST_RUN; }
  Bool isFailed() { return mTRAKtorState == cTKST_FAIL; }

  Bool clockEdge(GTCC & gtcc, Bool frontNotBack, ClokState newstate) { //< incoming clock edge
    EventWindow ew;
    SN locsn, tdsn;
    if (!findOtherSNs(locsn,tdsn)) return false; // not today
    LOCZ & locz = (LOCZ&) ew[locsn];
    TRAKtorDriver & td = (TRAKtorDriver&) ew[tdsn];
    TRAKtorDriver.TRAKtorEvent te;
    which (newstate) {
    case cCLOK_TICK: { te = frontNotBack ? TRAKtorDriver.cTKTR_FRONT_TICK : TRAKtorDriver.cTKTR_REAR_TICK; }
    case cCLOK_TOCK: { te = frontNotBack ? TRAKtorDriver.cTKTR_FRONT_TOCK : TRAKtorDriver.cTKTR_REAR_TOCK; }
    case cCLOK_NONE: { te = frontNotBack ? TRAKtorDriver.cTKTR_FRONT_NONE : TRAKtorDriver.cTKTR_REAR_NONE; }
    otherwise: { fail(__FILE__,__LINE__,"'NOT REACHED'"); }
    }
    td.notify(gtcc, locz, self, te);
    return true;
  }

  ASCII makeSig() {
    mD&&pR("TKTRMSIG10");
    MotorCmd cmd = makeCurrentMotorCmd();
    mD&&pR("TKTRMSIG11")&&pR(cmd);
    SpeedO spo;
    SpeedO.SpeedOp op = cmd.mSpeedNotWheel ?
      (mSecondSignal ? SpeedO.cSO_SET_MAX : SpeedO.cSO_SET_MIN) : // want a speed
      (mSecondSignal ? SpeedO.cSO_SET_RIGHT : SpeedO.cSO_SET_LEFT); // want a wheel
    SpeedO.SpeedCode sc =
      spo.getNoLarger( mSecondSignal ? cmd.mSpeed2 : cmd.mSpeed1 );
    mD&&pR("TKTRMSIG12")&&pR(op)&&pR(sc)&&pR(mSecondSignal);
    ASCII a = spo.packSpeedO(op,sc);
    mD&&pR("TKTRMSIG13")&&pR(a);
    return a;
  }
  Void recordSigSent() {
    mSecondSignal = !mSecondSignal;
  }

  //// TRAKtor INTERNAL EVENT SERVICES
  Bool isFrontInputValid(GTCC & gtcc) { return isGreyClockSettled(gtcc,0u); }
  Bool isRearInputValid(GTCC & gtcc) { return isGreyClockSettled(gtcc,1u); }
  Bool isGreyClockSettled(GTCC & gtcc, Unsigned idx) { return gtcc.mLastCloks[idx] != cCLOK_NONE; }
  Bool isGreyClockUnsettled(GTCC & gtcc, Unsigned idx) { return gtcc.mLastCloks[idx] == cCLOK_NONE; }

  typedef Unsigned(2) TRAKtorState;
  TRAKtorState mTRAKtorState;

  constant TRAKtorState cTKST_RESET = 0u; //< clear internal state and go to READY
  constant TRAKtorState cTKST_READY = 1u; //< ready to do a TRAKt
  constant TRAKtorState cTKST_RUN = 2u; //< a TRAKt is in progress
  constant TRAKtorState cTKST_FAIL = 3u; //< current TRAKt failed, RESET needed
  constant String cTKST_NAMES[] = { "RESET", "READY", "RUN", "FAIL" };

  String nameOfTRAKtorState(TRAKtorState stn) {
    return cTKST_NAMES[stn];
  }

  Bool findOtherSNs(SN &locsn, SN &tdsn) {
    EventWindow ew;
    MinXPick locpick;
    MinXPick tdpick;
    for (SN sn = 1u; sn <= 40u; ++sn) {
      if (!ew.isAccessible(sn)) continue;
      if (ew[sn] is LOCZ) 
        locpick.update(sn,sn);
      if (ew[sn] is TRAKtorDriver)
        tdpick.update(sn,sn);
    }
    if (locpick.hasPick() && tdpick.hasPick()) {
      locsn = locpick.getIdxSN();
      tdsn = tdpick.getIdxSN();
      return true;
    }
    return false;
  }

  Void update(GTCC& gtcc, TRAKtorDriver & td, LOCZ & lz) {
    takeDebug(gtcc);
    which (mTRAKtorState) {
    case cTKST_RESET: { return updateReset(gtcc,td,lz); }
    case cTKST_READY: { return updateReady(gtcc,td,lz); }
    case cTKST_RUN:   { return updateRun(gtcc,td,lz); }
    case cTKST_FAIL:  { return updateFail(gtcc,td,lz); }
    }
  }

  Void updateReset(GTCC &gtcc, TRAKtorDriver & td, LOCZ & lz) {
    mStartTick = false; // really: don't know, but just to settle it
    mSecondSignal = false;
    td.resetTD();               // let driver reset
    setTRAKtState(mTRAKt, cTKST_READY, __FILE__,__LINE__);
  }

  Void updateReady(GTCC &gtcc, TRAKtorDriver & td, LOCZ & lz) {
    // TOO NOISY & MISLEADING: setTRAKtState(tFULL_STOP, cTKST_READY, __FILE__,__LINE__); // if needed / unless overridden
    td.notify(gtcc, lz, self, TRAKtorDriver.cTKTR_READY);
  }

  Bool setTRAKtState(TRAKt t, TRAKtorState ts, String f, Unsigned l) {
    if (t >= cTRAKT_MOTORCMDS.lengthof)
      fail(f,l,"Illegal TRAKt Number");

    Bool ret = false;
    TRAKt oldt = mTRAKt;
    TRAKtorState oldts = mTRAKtorState;
    if (mTRAKt != t) {
      mTRAKt = t;
      ret = true;
    }
    if (mTRAKtorState != ts) {
      mTRAKtorState = ts;
      ret = true;
    }
    if (ret) {
      ByteStreamLogger log;
      log.printf("%s:%d: %s/%s => %s/%s\n",
                 f,l,
                 nameOfTRAKtorState(oldts),
                 nameOfTRAKt(oldt),
                 nameOfTRAKtorState(mTRAKtorState),
                 nameOfTRAKt(t)
                 );
    }
    return ret;
  }

  Bool startTRAKt(TRAKt t) {
    if (mTRAKtorState != cTKST_READY) return false;
    setTRAKtState(t, cTKST_RUN, __FILE__, __LINE__);
    return true;
  }

  Bool switchTRAKt(TRAKt fromt, TRAKt to) {
    mD&&pR("SWTCTKt10")&&pR(nameOfCurrentTRAKt());
    if (mTRAKt == fromt) {
      mD&&pR("SWTCTKt11")&&pR(nameOfTRAKt(fromt))&&pR(nameOfTRAKt(to))&&pR("&RUN");
      setTRAKtState(to, cTKST_RUN, __FILE__, __LINE__);
      return true;
    }
    mD&&pR("SWTCTKt12")&&pR(nameOfTRAKt(fromt))&&pR(nameOfTRAKt(to));
    return false;
  }

  Void updateRun(GTCC &g, TRAKtorDriver & td, LOCZ & l) {
    if (isTRAKtDone(g,l)) {
      mD&&pR("TKUR11")&&pR(nameOfCurrentTRAKt());
      setTRAKtState(mTRAKt, cTKST_READY, __FILE__, __LINE__);
    }
    else if (false /*isTRAKtFailed(gtcc)*/)
      setTRAKtState(mTRAKt, cTKST_FAIL, __FILE__, __LINE__);
  }

  Void updateFail(GTCC &gtcc, TRAKtorDriver & td, LOCZ & lz) {
    // Just wait?
  }

  Bool isCurrentTRAKt(Int tn) { // original customer: oRUN_TRAKT
    if (tn < 0) return false;
    return mTRAKt == (Unsigned) tn;
  }

  TRAKt mTRAKt;                 //< current TRAKt if _RUN or _FAIL
  Bool mStartTick;              //< what we started this action on
  Bool mSecondSignal;           //< what signal we're due to send
}
