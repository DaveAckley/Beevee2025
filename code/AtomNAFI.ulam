@Concrete
//element AtomNAFI : IndexableSoftStackT(9u,100u,6u) // XXX ITEMZ TOO SMALL!
element AtomNAFI : NAFI + ProgramCounter {
  typedef Unsigned(10) MyPC;
  MyPC mPC;

  ENAFI & getENAFI() {
    MDist md;
    EventWindow ew;
    SN mysn = ew.getSiteNumber(self);
    if (!ew.isAccessible(mysn)) fail(__FILE__,__LINE__,"ENAFI NO SELF");

    C2D myc = md.getSiteCoord(mysn);
    C2D enc = myc + C2D.instanceof(-1,0);

    SN ensn = md.getSiteNumber(enc);
    if (!ew.isAccessible(ensn)) fail(__FILE__,__LINE__,"NO ENAFI");

    if (!(ew[ensn] is ENAFI))
      ew[ensn] = ENAFI.instanceof;
    
    ENAFI & a = (ENAFI&) ew[ensn];
    return a;
  }

  @Override Void behave() {
    getENAFI();                 // ensure sidekick is up
    return super.behave();
  }

  //// PROGRAMCOUNTER API
  @Override Bool getPC(Unsigned & curpc) {
    curpc = mPC;
    //// WARNING! CANNOT CALL pRStack inside getPC! pRStack calls getPC!
    //    (BeeveeParms.pNAFI_TRACING%2u==1u)&&pR("aNATR/getPC")&&pR(curpc);
    return true;
  }

  @Override Bool setPC(Unsigned newpc) {
    if (newpc <= mPC.maxof) {
      (BeeveeParms.pNAFI_TRACING%2u==1u)&&pRStack("aNATR/setPC")&&pR(mPC)&&pR(newpc);
      mPC = (MyPC) newpc;
      return true;
    }
      (BeeveeParms.pNAFI_TRACING%2u==1u)&&pRStack("aNATR/setPC failed")&&pR(mPC)&&pR(newpc);
    return false;
  }

  //// NAFI API
  @Override Void reset() {
    mPC = 0u;
    ENAFI & en = getENAFI();
    en.reset();
  }

  @Override Bool canBlock() { return true; }
  @Override Unsigned stackSize() { return getENAFI().stackSize(); }
  @Override Bool isEmpty() { return getENAFI().isEmpty(); }
  @Override Bool isFull() { return getENAFI().isFull(); }
  @Override Bool push(FOC op) { return getENAFI().push(op); }
  @Override Bool pop(FOC & op) { return getENAFI().pop(op); }
  @Override Bool printStackTo(ByteStreamWriter & bsw) { return getENAFI().printStackTo(bsw); }


  //// ATOMNAFI SERVICES
  Bool evalTilBlocked(MetroState & ms) {
    ENAFI & at = getENAFI();
    Unsigned count = 0u;
    while (true) {
      Int lastpc;
      if (!getPC(lastpc)) return false;
      //      fail(__FILE__,__LINE__,"XXXFIZIMME");
      if (!evaluateOperator(ms)) return false;
      Int nextpc;
      if (!getPC(nextpc)) return false;
      if (lastpc == nextpc) break; // SPIKE: no pc change -> blocked
      ++count;
    }
    //fail(__FILE__,__LINE__,"XXXFIZIMMEMORE");
    if (count > 0u) at.pRStack("EVTIBL")&&pR(count);
    return true;
  }
}

