transient HTD8State + DTU {
  SN mGTCCSN = SN.maxof;
  SN mLOCZSN = SN.maxof;
  SN mNAFISN = SN.maxof;
  SN mEMPSN = SN.maxof;

  Bool findComponents() {
    EventWindow ew;
    MinXPick gsnpick, lsnpick, nsnpick, emppick;
    for (SN sn = 1u; sn <= 40u; ++sn) {
      if (!ew.isAccessible(sn)) continue;
      Atom & a = ew[sn];
      if (a is Empty) emppick.update(sn);
      else if (a is GTCC) gsnpick.update(sn);
      else if (a is LOCZ) lsnpick.update(sn);
      else if (a is AtomNAFI) nsnpick.update(sn);
    }
    if (gsnpick.hasPick()) mGTCCSN = gsnpick.getIdxSN();
    if (lsnpick.hasPick()) mLOCZSN = lsnpick.getIdxSN();
    if (nsnpick.hasPick()) mNAFISN = nsnpick.getIdxSN();
    if (emppick.hasPick()) mEMPSN = emppick.getIdxSN();
    return
      mGTCCSN != SN.maxof &&
      mLOCZSN != SN.maxof &&
      mNAFISN != SN.maxof &&
      mEMPSN != SN.maxof;
  }

}

/** spike traktor driver test: CW border patrol
   \symbol D8
   \color #0d8
 */
@Concrete
element HTD8 : TermHiddenIO + CodeConstants + TRAKtorDriver {
  Bool mResetRequested = false;
  
  // TRAKtorDriver API
  @Override Void resetTD() {
    pR("!HTD8 RESET REQUEST!");
    mResetRequested = true;
  }

  ASCII mLastSig;

  Bool runCode() {
    HTD8State d8s;
    if (!d8s.findComponents()) return false;
    EventWindow ew;
    GTCC & g = (GTCC &) ew[d8s.mGTCCSN];
    LOCZ & l = (LOCZ &) ew[d8s.mLOCZSN];
    TRAKtor & t = (TRAKtor &) g.mStateMachine;
    AtomNAFI & n = (AtomNAFI &) ew[d8s.mNAFISN];

    Bool ret = n.evalTilBlocked(g,l,t,d8s.mEMPSN);

    {
      DLRVUnion u;
      u.mDLRVSignal.mDLRVFmt = DLRVSignal.cDLRVFMT_TRAKT;
      u.mDLRVSignal.mDLRVData = (DLRVSignal.DLRVData) t.mTRAKt;
      ASCII sig = u.mASCII;
      Random random;
      if (mLastSig != sig || random.oneIn(25)) {
        mLastSig = sig;
        trySendSigViaTAPIdxs(sig, BeeveeBIMXBlock.cTAPIDX_HTD8, BeeveeBIMXBlock.cTAPIDX_DLRV);
      }
    }    

    return ret;
  }
  @Override Void behave() {
    mD&&pR("HTD8BEHAVE10");

    if (mResetRequested) {
      mResetRequested = false; // whether we find components or not?
      HTD8State d8s;
      if (d8s.findComponents()) {
        EventWindow ew;
        pR(">>>SELL THE HOUSE SELL THE CAR SELL THE KIDS");
        ew[d8s.mNAFISN] = Empty.instanceof; // reboot mind
        mLastSig = 0u;
      }
      return;
    }

    //// SPIKE BUILD AN ATOMNAFI TO PLAY WITH
    mD&&pR("HTD8BEHAVE11");

    EventWindow ew;
    constant SN asn = 5u; // above and btwn GTCC and HTD8
    if (ew.isAccessible(asn)) {
      if (!ew[asn] is AtomNAFI) {
        AtomNAFI an;
        //        an.setPC(fDRIVE_BOX_SPIKE); // MAKE A BOX DEMO
        //        an.setPC(fDRIVE_TO_ORIGIN); // WAHOO LOCALIZATION BEGIN!
        //        an.setPC(fFACE_EAST_SPIKE); // run face east demo
        constant Int cSPIKE_DEMO = fDRIVE_TO_ORIGIN11;
        an.setPC(cSPIKE_DEMO); // another localization spike
        pR("HTD8BEHAVE12")&&an.pRStack(nameOfFunction(cSPIKE_DEMO));
        ew[asn] = an;
        return;
      }
    }
    
    if (runCode()) {
      fail(__FILE__,__LINE__,"RUNCODE FAILED");
    }

    return super.behave();
  }

  @Override RouteDir getHiddenRouteDir(XBlock & gs) {
    return cNONE_TO_NONE;
  }

  @Override Void notify(GTCC & g, LOCZ & l, TRAKtor & t, TRAKtorEvent te) {
    TRAKtor.TRAKtorState tstate = t.mTRAKtorState;
    mD&&pR("D8NTFY10")&&pR(t.nameOfTRAKtorState(tstate))&&pR(nameOfTRAKtorEvent(te));
    which (tstate) {
      case TRAKtor.cTKST_RESET: { return; } // not our business
      case TRAKtor.cTKST_READY: { return notifyReady(g,l,t,te); } 
      case TRAKtor.cTKST_RUN:   { return notifyRun(g,l,t,te); } 
      case TRAKtor.cTKST_FAIL:  {
        pR("D8NTFY11FAIL")&&pR(nameOfTRAKtorEvent(te));
        t.reset();
        return;
      } 
    }
    pR("D8NTFY12NOTREACHED")&&pR(self);
  }

  /*
  Void notifyReadySPIKE(GTCC & g, LOCZ & l, TRAKtor & t, TRAKtorEvent te) {

    mD&&pR("notifyReadySPIKE11");
    AtomNAFI & an = (AtomNAFI&) ew[asn];
    if (an.getPCOrDie() == 0u) {
      Bool old = mD;
      mD = true;

      mD&&pR(__FUNC__)&&pR(nameOfTRAKtorEvent(te))&&pR(an);

      mD&&an.pRStack("notifyReadySPIKE12");
      Int result;
      Bool ef = an.evalFunction(fDRIVE_BOX_SPIKE, result, g, l, t); // SPIKE

      mD&&an.pRStack("notifyReadySPIKE13")&&pR(ef)&&pR(result);
      mD = false;
      //fail(__FILE__,__LINE__,"MY GOD WHAT HAVE I DONE?");
    }
    mD&&an.pRStack("notifyReadySPIKE14");
  }
  */

  Void notifyReady(GTCC & g, LOCZ & l, TRAKtor & t, TRAKtorEvent te) {
  }

  Unsigned(6) mTileCountSpike;

  Void notifyRun(GTCC & g, LOCZ & l, TRAKtor & t, TRAKtorEvent te) {
    pR("D8NFRUN10")&&pR(nameOfTRAKtorEvent(te));
    /*
    if (te == cTKTR_FRONT_TICK || te == cTKTR_FRONT_TOCK) {
      l.mPos[0]++;     // XXX SPIKE
    }
    */

    /*
    if (te == cTKTR_RED_PREWARN_SET) {
      pR("D8NFRUN11");
      if (t.switchTRAKt(tDRIVE_FAST,tDRIVE_SLOW))
        return;
      pR("D8NFRUN12");
    } else if (te == cTKTR_RED_WARN_SET) {
      pR("D8NFRUN13");
      if (!mTurnInProgress) {
        pR("D8NFRUN14");
        mTurnInProgress = true;
        t.switchTRAKt(tDRIVE_SLOW,tDRESS_LINE_FWD);
        return;
      } //else ignore
      pR("D8NFRUN15");
    }
    */
    pR("D8NFRUN16");
  }
}
