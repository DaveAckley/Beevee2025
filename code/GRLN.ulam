/** GReen LanterN - green signal for orientation during tracking
    \symbol GL
    \color #4e2
*/
element GRLN : TermHiddenIO + Fail {
  typedef FixedPoint(20u,10u) Frac;
  Frac mGreenLevel;
  Frac mEyeStalkDeviation;

  //// TERMHIDDENIO API
  @Override RouteDir getHiddenRouteDir(XBlock & xb) {
    return cXBAR_TO_AXON;
  }

  @Override TapIdx getAxonTapIdx(SlotSig & forsig) {
    BeeveeBIMXBlock bim;
    Unsigned t = bim.getTapIdxFromClassId(LOCZ.classidof);
    if (t == t.maxof) fail(__FILE__,__LINE__);
    return (TapIdx) t;
  }

  @Override Bool transshipSigHook(SlotSig & iss, XBlock & xb) {
    BeeveeBIMXBlock bim;
    TapIdx idx = iss.mSource;
    if (idx == bim.cTAPIDX_SLFG || idx == bim.cTAPIDX_SRFG) { // receive green info
      Frac fval((Int) iss.mValue);
      mGreenLevel = mGreenLevel*Frac.instanceof(7,8) + fval*Frac.instanceof(1,8);
      mD&&pR("GRLN10")&&pR(iss)&&pR(fval)&&pR(mGreenLevel);
      if (mEyeStalkDeviation.randomRound() < 16) 
        iss.mValue = (ASCII) mGreenLevel.getInt();
      else
        iss.mValue = (ASCII) 0; // turned eyes see no green! so mote it be!
      return true;
    }

    if (idx == bim.cTAPIDX_HESR) {
      Int val = signedAsciiToInt(iss.mValue);
      Frac fval(val);
      mEyeStalkDeviation = mEyeStalkDeviation*Frac.instanceof(7,8) + fval*Frac.instanceof(1,8);
      mD&&pR("GRLN11")&&pR(iss)&&pR(val)&&pR(mEyeStalkDeviation);
      // we consumed this, just fall out, don't fwd
    }
    return false;
  }
}
