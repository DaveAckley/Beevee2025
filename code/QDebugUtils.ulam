quark QDebugUtils {
  Bool mD = false;

  Bool isDebugOutputEnabled() { return mD; }

  Void setDebugOutputEnabled(Bool enabled) {
    mD = enabled;
  }

  Bool takeDebug(QDebugUtils & other) {
    Bool ret = other.isDebugOutputEnabled();
    setDebugOutputEnabled(ret);
    return ret;
  }

  Bool pRContext() {
    DebugUtils du;
    du.printContext();
    return true;
  }

  Bool pRContextV() {
    DebugUtils du;
    du.printContext(DebugUtils.cPRINT_ALL_MEMBERS);
    return true;
  }

  Bool pRContext(Bits flags) {
    DebugUtils du;
    du.printContext(flags);
    return true;
  }

  Bool pR(UrSelf & ur) {
    DebugUtils du;
    du.print(ur);
    return true;
  }

  Bool pR(String s) {
    DebugUtils du;
    du.print(s);
    return true;
  }

  Bool pR(String file, Unsigned line) {
    ByteStreamArray1K bsa;
    bsa.printf("LOCATION TAG:\n%s:%d:<HERE>", file, line);
    DebugUtils du;
    du.print((ByteStreamReader&) bsa);
    return true;
  }

  Bool pR(String file, Unsigned line, String message) {
    ByteStreamArray1K bsa;
    bsa.printf("LOCATION TAG:\n%s:%d:%s", file, line, message);
    DebugUtils du;
    du.print((ByteStreamReader&) bsa);
    return true;
  }

  Bool pR(Int s) {
    DebugUtils du;
    du.print(s);
    return true;
  }

  Bool pR(Unsigned s) {
    DebugUtils du;
    du.print(s);
    return true;
  }
  
  Bool pR(Bool s) {
    DebugUtils du;
    du.print(s);
    return true;
  }

  Bool pR(Bits s) {
    DebugUtils du;
    du.print((Unsigned) s);
    return true;    
  }

  Bool pR(Atom & s) {
    DebugUtils du;
    du.print(s);
    return true;        
  }

  Bool pR(ByteStreamReader& a, Bool reread) {
    if (reread && a.canReread()) a.reread();
    pR(a);
    return true;    
  }

  Bool pR(ByteStreamReader & bs) {
    DebugUtils du;
    du.print(bs);
    return true;    
  }

  Bool dieTrue(String msg) {
    mD&&pR(msg);
    return dieTrue();
  }

  Bool dieTrue() {
    EventWindow ew;             // maybe don't trust our dm now
    ew[0] = Empty.instanceof;
    return true;
  }

  Void die(String msg) { dieTrue(msg); }

  Void die() { dieTrue(); }

}

quark QDebugUtilsEnabler + DTU {
  Bool setEnablingOnOne(Bool enable) {
    EventWindow ew;
    for (SN sn = 0u; sn <= 8u; ++sn) {
      if (!ew.isAccessible(sn)) continue;
      Atom & a = ew[sn];
      if (a as QDebugUtils) {
        if (a.isDebugOutputEnabled() != enable) {
          a.setDebugOutputEnabled(enable);
          return true;
        }
      }
    }
    return false;
  }
}

/** \symbol Do
    \color #f00
 */
element EnableQDebugUtils : QDebugUtilsEnabler {
  Void behave() {
    if (setEnablingOnOne(true)) {
      EventWindow ew;
      ew[0] = Empty.instanceof;
    }
  }
}

/** \symbol Df
    \color #00f
 */
element DisableQDebugUtils : QDebugUtilsEnabler {
  Void behave() {
    if (setEnablingOnOne(false)) {
      EventWindow ew;
      ew[0] = Empty.instanceof;
    }
  }
}
