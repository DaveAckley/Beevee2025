# Wed Mar 26 11:53:16 2025 Move TRAKt definitions here
# Mon Mar 24 01:05:16 2025 Try a wittle wanguage for code constants

[Config]

[trakt.tBLOCK_FOR_SMTIMER]
  mSpeedLeft = 0
  mSpeedRight = 0
  mDoneFunc = fINCR_TIMER_CHECK

[trakt.tFIND_EAST_RIGHT]
  mSpeedLeft = 3
  mSpeedRight = -4
  mDoneFunc = fEAST_AND_ON_LINE

[trakt.tFIND_EAST_LEFT]
  mSpeedLeft = -4
  mSpeedRight = 3
  mDoneFunc = fEAST_AND_ON_LINE

[function.fEAST_AND_ON_LINE]
  code=[ oENTER0,
         oGREEN_LEVEL, 2, oCMP_GE,
         fCLOK_EDGE_FRONT, oCALL0,
         oAND,
         oRETURN1
       ]

[function.fDO_TRAKT]
  doc="run a trakt and wait till it's done"
  code=[ oENTER1,          # stack [... TN ]
         oSTART_TRAKT,     # stack [...]
         oWAIT_READY,     
         oRETURN0
       ]

[function.fINCR_TIMER_CHECK]
  code=[ oENTER0, oINCR_SMTIMER, oRETURN1 ]

[operator.oSET_SMTIMER]
  impl='''
      // stack is [ COUNT, stuff.. ]
      if (!s.pop(v[0])) return false;   // v[0] <- COUNT or fail, stack [ stuff.. ]
      mD&&s.pRStack("oSET_SMTIMER10=")&&pR(v[0]);  // DEBUG
      if (v[0] < 0) return false;       // Need non-neg!
      g.setSMTimer((Unsigned) v[0]);
      return true; 
'''

[operator.oGET_SMTIMER]
  impl='''
      // stack is [ stuff.. ]
      v[0] = (Int) g.getSMTimer();    // v[0] <- SMCOUNTER
      mD&&s.pRStack("oGET_SMTIMER10=")&&pR(v[0]);  // DEBUG
      if (!s.push(v[0])) return false;  // stack [ SMCOUNTER, stuff.. ]
      return true; 
'''

[operator.oIS_SMTIMER_DONE]
  impl='''
      // stack is [ stuff.. ]
      return !s.push(g.isSMTimerDone() ? 1 : 0);  // stack [ SMTIMERDONE, stuff.. ]
'''

[operator.oINCR_SMTIMER]
  impl='''
      // stack is [ stuff.. ]
      return s.push(g.incrSMTimer() ? 1 : 0);  // stack [ SMTIMERDONE, stuff.. ]
'''


[trakt.tFIND_LINE_LEFT]
  mSpeedLeft = 1 
  mSpeedRight = 3
  mDoneFunc = fCLOK_EDGE_FRONT
  
[trakt.tFIND_LINE_RIGHT]
  mSpeedLeft = 3
  mSpeedRight = 1
  mDoneFunc = fCLOK_EDGE_FRONT

[trakt.tTUNE_LINE]
  mSpeedMin = 1
  mSpeedMax = 2
  mDoneFunc = fCLOK_EDGE_TUNED

[trakt.tDRESS_LINE_FWD]
  mSpeedMin = 1
  mSpeedMax = 4
  mDoneFunc = fSAME_EDGE

[trakt.tDRESS_LINE_REV]
  mSpeedMin = -4
  mSpeedMax = -1
  mDoneFunc = fDIFF_EDGE

[trakt.tTURN_LEFT_TO_TICK]
  mSpeedLeft = -2
  mSpeedRight = 1
  mDoneFunc = fCLOK_TICK_FRONT

[trakt.tTURN_LEFT_TO_TOCK]
  mSpeedLeft = -2
  mSpeedRight = 1
  mDoneFunc = fCLOK_TOCK_FRONT

[trakt.tTURN_RIGHT_TO_TICK]
  mSpeedLeft = 1
  mSpeedRight = -2
  mDoneFunc = fCLOK_TICK_FRONT

[trakt.tTURN_RIGHT_TO_TOCK]
  mSpeedLeft = 1
  mSpeedRight = -2
  mDoneFunc = fCLOK_TOCK_FRONT

[trakt.tFULL_STOP]
  mSpeedMin = 0
  mSpeedMax = 0
  mDoneFunc = fSTOPPED

[trakt.tROLLING_STOP]
  mSpeedMin = 1
  mSpeedMax = 4
  mDoneFunc = fROLLING_STOPPED

[trakt.tDRIVE_SLOW]
  mSpeedMin = 8
  mSpeedMax = 20
  mDoneFunc = fSTOP_DRIVE_SLOW

[trakt.tDRIVE_FAST]
  mSpeedMin = 8
  mSpeedMax = 50
  mDoneFunc = fSTOP_DRIVE_FAST

[trakt.tFORWARD_TO_TICK]
  mSpeedMin = 4
  mSpeedMax = 8
  mDoneFunc = fCLOK_TICK_FRONT

[trakt.tFORWARD_TO_TOCK]
  mSpeedMin = 4
  mSpeedMax = 8
  mDoneFunc = fCLOK_TOCK_FRONT

[trakt.tEMERGENCY_STOP]
  mSpeedMin = 0
  mSpeedMax = 0
  mDoneFunc = fSTOPPED


[function.fTRUE]
  doc="always true"
  code = [ oENTER0, 1, oRETURN1 ]

[function.fFALSE]
  doc="always false"
  code = [ oENTER0, 0, oRETURN1 ]

[function.fOFFLINE_FRONT]
  doc="true on front not tick and not tock"
  code = [ oENTER0, oCLOK_FRONT, cCLOK_NONE, oCMP_EQ, oRETURN1 ]

[function.fHARD_OFFLINE_FRONT]
  doc="true on front not tick and not tock for quite a consecutive while"
  code = [ oENTER0, oHARD_OFFLINE_FRONT, oRETURN1 ]

[function.fCLOK_TICK_FRONT]
  doc="true on front tick"
  code = [ oENTER0, oCLOK_FRONT, cCLOK_TICK, oCMP_EQ, oRETURN1 ]

[function.fCLOK_TOCK_FRONT]
  doc="true on front tock"
  code = [ oENTER0, oCLOK_FRONT, cCLOK_TOCK, oCMP_EQ, oRETURN1 ]

[function.fCLOK_EDGE_FRONT]
  doc="true on front tick or front tock"
  code = [ oENTER0, oCLOK_FRONT, cCLOK_NONE, oCMP_NE, oRETURN1 ]

[function.fCLOK_EDGE_REAR]
  doc="true on rear tick or rear tock"
  code = [ oENTER0, oCLOK_REAR, cCLOK_NONE, oCMP_NE, oRETURN1 ]

[function.fSMALL_GREY_DEV]
  doc="true on small deviation, meaning 128+-25 == 103..153"
  code = [ oENTER0, oGREY_FCTR, oDUP, 153, oCMP_LE, oSWAP, 103, oCMP_GE, oAND, oRETURN1 ]

[function.fCLOK_EDGE_TUNED]
  doc="true on front edge and small deviation"
  code = [ oENTER0, fCLOK_EDGE_FRONT, oCALL0, fSMALL_GREY_DEV, oCALL0, oAND, oRETURN1 ]

[function.fSAME_EDGE]
  doc="true if front and back on tick or tock"
  code = [ oENTER0, fCLOK_EDGE_FRONT, oCALL0, oCLOK_REAR, oCLOK_FRONT, oCMP_EQ, oAND, oRETURN1 ]

[function.fDIFF_EDGE]
  doc="true if front and back on tick and tock or tock and tick"
  code = [ oENTER0, fCLOK_EDGE_FRONT, oCALL0, fCLOK_EDGE_REAR, oCALL0, oAND, oCLOK_REAR, oCLOK_FRONT, oCMP_NE, oAND, oRETURN1 ]

[function.fSTOPPED]
  doc="true if valid speed is 0"
  code = [ oENTER0, oVALID_SPEED, oCUR_SPEED, 0, oCMP_EQ, oAND, oRETURN1 ]

[function.fROLLING_STOPPED]
  doc="true if over an edge and valid speed is at most 4"
  code = [ oENTER0, fDIFF_EDGE, oCALL0, oVALID_SPEED, oAND, oCUR_SPEED, 4, oCMP_LE, oAND, oRETURN1 ]

[function.fSTOP_DRIVE_SLOW]
  doc="done if hard offline, or red warning"
  code = [ oENTER0, oHARD_OFFLINE_FRONT, oRED_WARNING_TRACK, oOR, oRETURN1 ]

[function.fSTOP_DRIVE_FAST]
  doc="done if hard offline, or red prewarning, or red warning"
  code = [ oENTER0, fSTOP_DRIVE_SLOW, oCALL0, oRED_PRE_WARNING, oOR, oRETURN1 ]

