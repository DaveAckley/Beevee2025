[function.fWAIT_A_WHILE]
  doc = "delay for rxtimer ARG time"
  code = [ oENTER1,           # stack is [... ARG]
           oSET_SMTIMER,     # stack is [...]
           tBLOCK_FOR_SMTIMER, fDO_TRAKT, oCALL1,
           oRETURN0
          ]
           

[function.fDRIVE_TO_ORIGIN11]
  doc = "nth attempt to drive to origin"
  code = [ oENTER0,
           5, fWAIT_A_WHILE, oCALL1,   # Wait for axons etc on startup!

         lFACE_EAST_LOOP,

           tFIND_LINE_RIGHT, fDO_TRAKT, oCALL1,    # try to start sane
           fFWD_TO_TICK, oCALL0,                   # and straighten our shoulders
           tFIND_EAST_LEFT, fDO_TRAKT, oCALL1,     # spin ccw for east
           fFWD_TO_TICK, oCALL0,                   # and restraighten our shoulders

         #   fTURN_RIGHT_TICK, oCALL0,          # fwd, dress, right [...]
         #   oGREEN_LEVEL, 2, oCMP_GE,          # green >= 2? => [ BIGGREEN ... ]
         #   aFACE_EAST_LOOP, oGOTOZ,           # loop back to fTURN_RIGHT_TICK if !BIGGREEN

           # DRIVE SLOW EAST
           tDRIVE_SLOW, fDO_TRAKT, oCALL1,      # else (is BIGGREEN, so) drive slow
           tROLLING_STOP, fDO_TRAKT, oCALL1,    # make sure we just don't fly through here
           tDRESS_LINE_REV, fDO_TRAKT, oCALL1,  # back up when drive slow ends

           # TURN WEST TO CLEAR RED WARNING
           fTURN_RIGHT_TICK, oCALL0,          # fwd, dress, right [...]
           fTURN_RIGHT_TICK, oCALL0,          # fwd, dress, right [...]      

           # TURN SOUTH AND DRIVE
           fTURN_LEFT_TICK, oCALL0,           # fwd, dress, left [...]
           tDRIVE_SLOW, oSTART_TRAKT,         # drive slow
           tROLLING_STOP, fDO_TRAKT, oCALL1,  # again, don't fly through here
           tDRESS_LINE_REV, fDO_TRAKT, oCALL1,  # back up when drive slow ends

           # SET ORIGIN
           0, oSET_XPOS,                      # declare origin when 
           0, oSET_YPOS,                      # 2nd drive slow bails

           # TURN WEST
           fTURN_RIGHT_TICK, oCALL0,          # fwd, dress, right [...]
           oWAIT_READY,  # ?? shouldn't need?

          lDIAGO,
           fTURN_RIGHT_TICK, oCALL0,          # TURN NORTH
           fTURN_LEFT_TICK, oCALL0,           # TURN WEST
           oWAIT_READY,  # ?? shouldn't need?
           aDIAGO, oGOTO,                     # and loop

           aFACE_EAST_LOOP, oGOTO,        # then try again? FSD I ask you: what next?

           oRETURN0   ## NOT REACHED
          ]

[function.fFWD_TO_TICK]
  doc = "Go forward, maintaining pos if heading is set"
  code = [ oENTER0,
           tFORWARD_TO_TICK, fDO_TRAKT, oCALL1, # fwd [...]
           oINCR_POS,                           # advance pos if heading valid
           tDRESS_LINE_FWD, fDO_TRAKT, oCALL1,  # prep [...]
           oRETURN0                             # no return value
         ]

[function.fTURN_RIGHT_TICK]
  doc = "Turn right, maintaining heading if set"
  code = [ oENTER0,
           fFWD_TO_TICK, oCALL0,
           tTURN_RIGHT_TO_TOCK, fDO_TRAKT, oCALL1,   # turn [...]
           1, oINCR_HEAD,                     # advance heading CW if valid
           oRETURN0                           # no return value
         ]

[function.fTURN_LEFT_TICK]
  doc = "Turn left, maintaining heading if set"
  code = [ oENTER0,
           fFWD_TO_TICK, oCALL0,
           tTURN_LEFT_TO_TOCK, fDO_TRAKT, oCALL1,    # turn [...]
           -1, oINCR_HEAD,                    # advance heading CCW if valid
           oRETURN0
         ]

