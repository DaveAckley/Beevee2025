[function.fDRIVE_BOX_SPIKE]
  doc = "'infinite' loop making a clockwise box"
  code = [ oENTER0,
         lLOOP,
           tFORWARD_TO_TICK, oSTART_TRAKT,
           tDRESS_LINE_FWD, oSTART_TRAKT,
           tTURN_RIGHT_TO_TOCK, oSTART_TRAKT,
           aLOOP, oGOTO,
           oRETURN0   ## NOT REACHED
           ]

[function.fDRIVE_BOX_SPIKE2]
  doc = "'infinite' loop making a bigger clockwise box"
  code = [ oENTER0,
          lLOOP,
           tFORWARD_TO_TICK, oSTART_TRAKT,
           tFORWARD_TO_TOCK, oSTART_TRAKT,
           tFORWARD_TO_TICK, oSTART_TRAKT,
           tDRESS_LINE_FWD, oSTART_TRAKT,
           tTURN_RIGHT_TO_TOCK, oSTART_TRAKT,
           aLOOP, oGOTO,
           oRETURN0 ## NOT REACHED
           ]          

[function.fDRIVE_BORDER_RIGHT]
  doc = "'infinite' loop making a clockwise box at the border"
  code = [ oENTER0,
          lLOOP,
           tDRIVE_SLOW, oSTART_TRAKT,
           tDRESS_LINE_FWD, oSTART_TRAKT, 
           tFORWARD_TO_TICK, oSTART_TRAKT,
           tTURN_RIGHT_TO_TOCK, oSTART_TRAKT,
           aLOOP, oGOTO,
           oRETURN0 ## NOT REACHED
           ]

[constant.cTRUE] 
  value = 1

[constant.cFALSE]
  value = 0

[constant.cCLOK_NONE]
  doc="clok val neither tick or tock"

[constant.cCLOK_TICK]
  doc="clok val tick"

[constant.cCLOK_TOCK]
  doc="clok val tock"

[operator.oNOP]
  impl='return true'                        
[operator.oDUP]
  impl='return s.pop(v[0]) && s.push(v[0]) && s.push(v[0])'
[operator.oDROP]
  impl='return s.pop(v[0])'
[operator.oSWAP]
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[1]) && s.push(v[0])'
[operator.oENTER0]
  doc="Start a function taking 0 arguments"
  special=true
  impl='return true'
[operator.oENTER1]
  doc="Start a function taking 1 argument"
  special=true
  impl='return true'
[operator.oENTER2]
  doc="Start a function taking 2 arguments"
  special=true
  impl='return true'
[operator.oENTER3]
  doc="Start a function taking 3 arguments"
  special=true
  impl='return true'
[operator.oGOTO]
  special=true
  impl=''' // UNCONDITIONAL ABSOLUTE GOTO: stack is [NEXTPC ...]
      return //s.pRStack("RET=") &&   // DEBUG
             s.pop(v[0])            // v0 <- nextpc
          && s.setPC(v[0])          // jump there
  '''
[operator.oGOTOZ]
  special=true
  impl=''' // CONDITIONAL ABSOLUTE GOTO: stack is [NEXTPC IFZ ...]
      return s.pRStack("IN oGOTOZ=") &&   // DEBUG
             s.pop(v[0])              // v0 <- NEXTPC  [IFZ ...]
          && s.pop(v[1])              // v1 <- IFZ  [...]
          && s.getPC(v[2])            // v2 <- .+1
          && (  (v[1] != 0             // done if IFZ non-zero
               && s.pRStack("NO JUMP OUT oGOTOZ="))
             || (s.setPC(v[0])         // or jump to NEXTPC
              && s.pRStack("JUMP OUT oGOTOZ="))
             )
  '''

[operator.oJUMP]
  special=true
  impl=''' // UNCONDITIONAL RELATIVE GOTO: stack is [PCOFFSET ...]
      return s.pRStack("oJUMP=") &&   // DEBUG
             s.pop(v[0])              // v0 <- PCOFFSET  [ ...]
          && s.getPC(v[1])            // v2 <- .+1
          && s.setPC(v[1]+v[0]-1)  // jump to .+offset
  '''

[operator.oJUMPZ]
  special=true
  impl=''' // CONDITIONAL RELATIVE GOTO: stack is [PCOFFSET IFZ ...]
      return s.pRStack("oJUMPZ=") &&   // DEBUG
             s.pop(v[0])              // v0 <- PCOFFSET  [IFZ ...]
          && s.pop(v[1])              // v1 <- condition  [...]
          && s.getPC(v[2])            // v2 <- .+1
          && (  v[1] != 0             // done if IFZ non-zero
             || s.setPC(v[2]+v[0]-1)  // jump to .+offset
             )
  '''

[operator.oRETURN0]
  doc="Exit function returning zero values"
  special=true
  impl=''' // FUNCTION RETURN0: stack is [RETADDR ...]
      return //s.pRStack("RET0=") &&   // DEBUG
             s.pop(v[0])            // v0 <- retaddr
          && s.setPC(v[0])          // jump to retaddr 
  '''

[operator.oRETURN1]
  doc="Exit function returning one value"
  special=true
  impl=''' // FUNCTION RETURN1: stack is [RETVAL RETADDR ...]
      return //s.pRStack("RET1=") &&   // DEBUG
             s.pop(v[0])            // v0 <- retval
          && s.pop(v[1])            // v1 <- retaddr
          && s.push(v[0])           // restash retval
          && s.setPC(v[1])          // jump to retaddr 
  '''

[operator.oRETURN2]
  doc="Exit function returning two values"
  special=true
  impl=''' // FUNCTION RETURN2: stack is [RETVAL2 RETVAL1 RETADDR ...]
      return s.pRStack("RET2=") &&   // DEBUG
             s.pop(v[0])            // v0 <- retval2
          && s.pop(v[1])            // v1 <- retval1
          && s.pop(v[2])            // v2 <- retaddr
          && s.push(v[1])           // restash retval1
          && s.push(v[0])           // restash retval2
          && s.setPC(v[1])          // jump to retaddr 
  '''

[operator.oCALL0]
  doc="Call a function taking 0 arguments"
  special=true
  impl=''' // FUNCTION CALL: stack is [FUNCADDR ...]
      return s.pop(v[0])            // v0 <- funcaddr
          //&& s.pRStack(nameOfFunction(v[0])) // DEBUG
          && readRAM(v[0],v[1])     // v1 <- cRAM[funcaddr]
          && v[1] == oENTER0        // calladdr is func entry point
          && s.push(s.getPCOrDie()) // save retaddr
          && s.setPC(v[0] + 1)      // jump to funcaddr + 1, stack [RETADDR ...]
  '''

[operator.oCALL1]
  doc="Call a function taking 1 argument"
  special=true
  impl=''' // FUNCTION CALL: stack is [FUNCADDR ARG ...]
      return s.pop(v[0])            // v0 <- funcaddr
          //&& s.pRStack(nameOfFunction(v[0])) // DEBUG
          && readRAM(v[0],v[1])     // v1 <- cRAM[funcaddr]
          && v[1] == oENTER1        // calladdr is func entry point
          && s.pop(v[2])            // v2 <- ARG
          && s.push(s.getPCOrDie()) // push RETADDR
          && s.push(v[2])           // push ARG
          && s.setPC(v[0] + 1)      // jump to FUNCADDR + 1, stack [ARG RETADDR ...]
  '''

[operator.oCALL2]
  doc="Call a function taking 2 argument2"
  special=true
  impl=''' // FUNCTION CALL: stack is [FUNCADDR ARG2 ARG1 ...]
      return s.pop(v[0])            // v0 <- funcaddr
          //&& s.pRStack(nameOfFunction(v[0])) // DEBUG
          && readRAM(v[0],v[1])     // v1 <- cRAM[funcaddr]
          && v[1] == oENTER2        // calladdr is func entry point
          && s.pop(v[2])            // v2 <- ARG2
          && s.pop(v[3])            // v2 <- ARG1
          && s.push(s.getPCOrDie()) // push RETADDR
          && s.push(v[3])           // push ARG1
          && s.push(v[2])           // push ARG2
          && s.setPC(v[0] + 1)      // jump to FUNCADDR + 1, stack [ARG2 ARG1 RETADDR ...]
  '''

[operator.oSTART_TRAKT]
  special=true
  impl=''' // START TRAKT: stack is [TRAKT_NUM stuff.. ]
      if (!s.getPC(v[0])) return false; // getpc or fail
      if (!s.pop(v[1])) return false;   // pop TN or fail stack [ stuff.. ]
      if (v[1] < 0) return false;       // TN unsigned or fail

      if (t.startTRAKt((TRAKt) v[1])) { // try to start our trakt
        (BeeveeParms.pNAFI_TRACING%2u == 1u)&&pR("NATR/oSTART_TRAKT:started")&&s.pRStack(nameOfTRAKt((TRAKt) v[1]));
        s.pRStack("TRAKt Started");
        return true;                    // MOVE ON (PC incrd; stack popped)
      }
      // TRAKtor not ready: Block here
      (BeeveeParms.pNAFI_TRACING%2u == 1u)&&pR("NATR/oSTART_TRAKT:blocking")&&s.pRStack(nameOfTRAKt((TRAKt) v[1]));      
      if (!s.push(v[1])) return false;  // restore stack [ TN stuff.. ]
      if (s.setPC(v[0] - 1)) return false;  // back up PC (implying BLOCKED)
      return true;                      // TRY AGAIN (PC--; no stack change)
  '''

[operator.oWAIT_READY]
  special=true
  impl=''' // WAIT READY: stack is [stuff.. ]
      if (t.isReady()) { // check if trakor is ready
        (BeeveeParms.pNAFI_TRACING%2u == 1u)&&s.pRStack("NATR/oWAIT_READY:done");
        return true;                    // MOVE ON (PC incrd)
      }
      // TRAKtor not ready: Block here
      if (!s.getPC(v[0])) return false; // getpc or fail
      if (s.setPC(v[0] - 1)) return false;  // back up PC (implying BLOCKED)
      (BeeveeParms.pNAFI_TRACING%2u == 1u)&&s.pRStack("NATR/oWAIT_READY:block");
      return true;                      // TRY AGAIN (PC--; no stack change)
  '''

# [operator.oSTART_TRAKT_TRICKY]
#   special=true
#   impl=''' // RUN TRAKT: stack is [TRAKT_NUM stuff... ]
#       return s.getPC(v[0])          // v0 <- pc + 1 
#           && s.pop(v[1])            // v1 <- TN, stack [ stuff... ]
#           && t.isCurrentTRAKt(v[1]) // assert
#           && ( isTRAKtDone(v[1],g,l,t)  // move on, stack [ stuff... ]
#             || ( s.setPC(v[0] - 1)  // or back up PC
#               && s.push(v[0])       // reset stack [TN stuff... ]
#                )
#              )
#   '''

[operator.oHARD_OFFLINE_FRONT]
  impl='return s.push(g.mHardOfflineFrontTimer.alarm() ? 1 : 0)'
[operator.oCLOK_FRONT]           # : { outs[0] = g.mNewCloks[0]; return true; } // front newclok
  impl='return s.push((Int) g.mNewCloks[0])'
[operator.oCLOK_REAR]           # : { outs[0] = g.mNewCloks[1]; return true; } // rear newclok
  impl='return s.push((Int) g.mNewCloks[1])'
[operator.oGREY_FCTR]           # : { outs[0] = g.mCenterGrey; return true; } // front center grey
  impl='return s.push(g.mCenterGrey)'
[operator.oVALID_SPEED]           # : { outs[0] = l.mSpeed8Valid ? 1 : 0; return true; } // cur speed valid
  impl='return s.push(l.mSpeed8Valid ? 1 : 0)'
[operator.oCUR_SPEED]           # : { outs[0] = l.mSpeed8 - 8; return true; } // cur speed 
  impl='return s.push(l.mSpeed8 - 8)'
[operator.oVALID_HEAD]           # : { outs[0] = l.mHeadingValid ? 1 : 0; return true; } // heading valid
  impl='return s.push(l.mHeadingValid ? 1 : 0)'
[operator.oCUR_HEAD]           # : { outs[0] = l.mHeading; return true; } // cur heading
  impl='return s.push(l.mHeading)'
[operator.oSET_HEAD] 
  impl='''
     if (!s.pop(v[0])) return false;
     if (v[0] > 3) return false;
     l.mHeadingValid = (v[0] >= 0); // negative heading means invalidate ugh
     l.mHeading = (AxialDir) v[0];
     return true
  '''
[operator.oINCR_HEAD]
  doc='[CW ...] if mHeadingValid, increment mHeading clockwise if CW > 0 else CCW'
  impl='''
     s.pRStack("IN oINCR_HEAD")&&pR(l.mHeadingValid);
     if (!s.pop(v[0])) return false;
     if (l.mHeadingValid) {
       l.mHeading = adjacentAxialDir(l.mHeading, v[0] > 0);
     }
     s.pR(l.mHeading);
     return true
  '''
[operator.oINCR_POS]
  doc='[...] if mHeadingValid, modify XPOS or YPOS based on mHeading'
  impl='''
     s.pRStack("IN oINCR_POS")&&pR(l.mHeadingValid);
     if (!l.mHeadingValid) {
       l.mPosValid[0] = false;
       l.mPosValid[1] = false;
     } else if (l.mHeading == cW) {
       if (l.mPosValid[0]) ++l.mPos[0];
     } else if (l.mHeading == cN) {
       if (l.mPosValid[1]) ++l.mPos[1];
     } else if (l.mHeading == cS) {
       if (l.mPosValid[1]) --l.mPos[1];
     } else if (l.mHeading == cE) {
       if (l.mPosValid[0]) --l.mPos[0];
     }
     return true
  '''

[operator.oSET_XPOS] 
  impl='''
     if (!s.pop(v[0])) return false;     // get x
     l.mPosValid[0] = (v[0] >= 0);
     if (l.mPosValid[0]) l.mPos[0] = (LOCZ.TileCount) v[0];
     return true
  '''
[operator.oSET_YPOS] 
  impl='''
     if (!s.pop(v[0])) return false;     // get y
     l.mPosValid[1] = (v[0] >= 0);
     if (l.mPosValid[1]) l.mPos[1] = (LOCZ.TileCount) v[0];
     return true
  '''

# Fri Mar 28 02:44:51 2025 Expose more LOCZ
[operator.oRED_WARNING_TRACK]
  impl='return s.push(l.mWarningTrack)'
[operator.oRED_PRE_WARNING]
  impl='return s.push(l.mPreWarning)'
[operator.oGREEN_LEVEL]
  impl='return s.push(l.mGreenLevel)'

[operator.oCMP_EQ]           # : { outs[0] = ins[0] == ins[1] ? 1 : 0; return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] == v[1])'
[operator.oCMP_NE]           # : { outs[0] = ins[0] != ins[1] ? 1 : 0; return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] != v[1])'
[operator.oCMP_LT]           # : { outs[0] = ins[0] <  ins[1] ? 1 : 0; return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] < v[1])'
[operator.oCMP_LE]           # : { outs[0] = ins[0] <= ins[1] ? 1 : 0; return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] <= v[1])'
[operator.oCMP_GT]           # : { outs[0] = ins[0] >  ins[1] ? 1 : 0; return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] > v[1])'
[operator.oCMP_GE]           # : { outs[0] = ins[0] >= ins[1] ? 1 : 0; return true; }
  impl='return /*s.pRStack("IN oCMP_GE") &&*/ s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] >= v[1]) /*&& s.pRStack("OUT oCMP_GE")*/ '
[operator.oMAX]           # : { outs[0] = max(ins[0],ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(max(v[0],v[1]))'
[operator.oMIN]           # : { outs[0] = min(ins[0],ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(min(v[0],v[1]))'
[operator.oADD]           # : { outs[0] = s.clampImmed(ins[0]+ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]+v[1]))'
[operator.oSUB]           # : { outs[0] = s.clampImmed(ins[0]-ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]-v[1]))'
[operator.oMUL]           # : { outs[0] = s.clampImmed(ins[0]*ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]*v[1]))'
[operator.oDIV]           # : {
  impl='return s.pop(v[1]) && s.pop(v[0]) && v[1] != 0 &&s.push(s.clampImmed(v[0]/v[1]))'
[operator.oAND]           # : { outs[0] = min(ins[0],ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) &&s.push(v[0] != 0 && v[1] != 0 ? 1 : 0)'
[operator.oOR]           # : { outs[0] = max(ins[0],ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) &&s.push(v[0] != 0 || v[1] != 0 ? 1 : 0)'
[operator.oNOT]           # : { outs[0] = ins[0] == 0 ? 1 : 0; return true; }
  impl='return s.pop(v[0]) && s.push(v[0] == 0 ? 1 : 0)'
[operator.oNEG]           # : { outs[0] = -ins[0]; return true; }
  impl='return s.pop(v[0]) && s.push(s.clampImmed(-v[0]))'

[operator.oSET_DEBUG]
  impl='''
     if (!s.pRStack("SET_DEBUG")) return false;
     if (!s.pop(v[0])) return false;
     s.setDebugOutputEnabled(v[0]!=0);
     l.setDebugOutputEnabled(v[0]!=0);
     g.setDebugOutputEnabled(v[0]!=0);
     return true
'''
