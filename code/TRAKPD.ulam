union ImmVal5 {
  typedef Unary(5u) IVUna;
  IVUna asUnary;

  typedef Unsigned(5u) IVUns;
  IVUns asUnsigned;

  typedef Int(5u) IVInt;
  IVInt asInt;

  typedef Bits(5u) IVBits;
  IVBits asBits;

  typedef Bool(5u) IVBool;
  IVBool asBool;
}

union ImmVal4 {
  typedef Unsigned(4u) IVUns;
  IVUns asImmUns;

  typedef Int(4u) IVInt;
  IVInt asImmInt;

  typedef Bits(4u) IVBits;
  IVBits asImmBits;

  typedef Bool(3u) IVBool;
  IVBool asImmBool;
}

union RegInsU {
  ASCII asASCII;                // as Unsigned(8)
  RegIns asInsn;                // as instruction
}

quark RegIns {
  typedef Unsigned(1u) WriteNotRead;
  WriteNotRead mRegInsOp;

  typedef Unsigned(2u) RegNum;
  RegNum mRegNum;
  constant RegNum cRN_SMIN = 0u; //< rw: speed min register
  constant RegNum cRN_SMAX = 1u; //< rw: speed max register
  constant RegNum cRN_SCUR = 2u; //< rw: speed current register
  constant RegNum cRN_SPAC = 3u; //< rw: special/action register

  ImmVal5 mUVal;                 //< union unsigned/int/bits/bool
}

quark SeqCore + DTU + Fail {
  typedef RegInsU SeqCoreInsn;
  SeqCoreInsn mIR;

  typedef Unsigned(7u) ActionCount;
  ActionCount mAR;

  typedef Bits(8) ActStatus;
  ActStatus mSR;
}

element TRAKPD : HOpUnary + Fail {
  //// UrSelf API
  @Override ARGB getColor(Unsigned selector) {
    ColorUtils cu;
    FPErr minfp500 = FPErr.instanceof(0).getMin();
    if (getLastError() == minfp500)
      return cu.color(0xffff0000);  // RED for invalid
    return super.getColor(selector);
  }

  //// HOpArgsT API
  virtual Int sigToSlot(SlotSig sig, Unsigned gripnum) {
    BeeveeBIMXBlock bim;
    TapIdx idx = sig.mSource;

    if (idx == bim.getTapIdxFromClassId(GTCC.classidof)) { // insns bound for TRAKPD
      mD&&pR("TRAKPDS2D/insn");
      mD&&pR(sig);
      return 0;                 // want it
    }
    return 1;                   // don't want it
  }

  //// TermHOp API
  virtual Bool execute(SlotSig & result) {
    /// REFRESH GRIPNUM
    SN sn = findXBlockSN();
    if (!ew.isAccessible(sn)) return false;
    if (!(ew[sn] is XBlock)) { die(); return false; }
    XBlock & xb = (XBlock&) ew[sn];
   
    mD&&pR("TPDX11")&&pR(xb);

    Unsigned gripnum = getGripNumber(); // our current grip
    if (gripnum != xb.getGripNumber()) {
      gripnum = xb.getGripNumber();
      setGripNumber(gripnum);
      mD&&pR("TPDX12")&&pR(self);
    }

    GripInfoMap gim(self);
    if (gripnum != gim.cGRIP_TRACK)
      return false;

    SlotSig & sig = getSlotSig(0u);
    if (!sig.isOccupied())
      return false; // ??
    ASCII val = sig.getValueRaw();
    sig.reset();

    executeSig(val);
    return false;   // true from execute() means ship result.. 
  }

  //// TRAKPD SERVICES
  Bool isWheelMode() {
    return mWheelSpeedControl;
  }

  Bool executeSig(ASCII val) {
    SpeedO spo;
    SpeedO.SpeedOp op;
    SpeedO.SpeedCode code;
    spo.unpackSpeedO(val, op, code);
    return executeOp(op,code);
  }

  Bool executeOp(SpeedO.SpeedOp op, SpeedO.SpeedCode code) {
    SpeedO spo;
    Int speed = spo.getSpeedFromCode(code);
    which (op) {
    case SpeedO.cSO_SET_MIN: 
    case SpeedO.cSO_SET_MAX:
      {
        mWheelSpeedControl = false;
        if (op == SpeedO.cSO_SET_MIN)
          mTargetMinSpeed = speed;
        else
          mTargetMaxSpeed = speed;
        break;
      }
    case SpeedO.cSO_SET_LEFT: 
    case SpeedO.cSO_SET_RIGHT:
      {
        mWheelSpeedControl = true;
        if (op == SpeedO.cSO_SET_LEFT)
          mTargetMinSpeed = speed; // ? Use min for left in wheel mode??
        else
          mTargetMaxSpeed = speed; // ? And max for right?????
        break;
      }
    }
    return true;
  }
  
  //// XXX HOT HOT HOT ULTRAHACK WARNING HOT HOT HOT XXX
  //// here we're trying to send a signal 'backwards' down
  //// an incoming axon. we expect it will fail if there
  //// is any branching on the path, but otherwise ???
  Void maybeForwardGrey(Int vl,Int vc,Int vr) {
    mD&&pR("MYBFG10");

    EventWindow ew;
    SN axonsn = findMatchingAxonEnd(true); // LOOK FOR **INBOUND** FROM GTCC
    if (!ew.isAccessible(axonsn)) return;  // nope

    mD&&pR("MYBFG11")&&pR(axonsn);
    Atom & a = ew[axonsn];
    if (!a is AxonEnd) return;  // WTF?

    AxonEnd & ae = (AxonEnd&) a;

    AxonIdx aidx = ae.getRemoteAxonIdx();
    TapIdx ti = ae.getAxonTap(aidx);
    mD&&pR("MYBFG12")&&pR(aidx)&&pR(ti);

    if (ti != BeeveeBIMXBlock.cTAPIDX_GTCC) return; // "?
    SlotSig & oss = ae.getEndSlotSig(false); // get **outbound** slot of axon
    mD&&pR("MYBFG13")&&pR(oss);

    if (oss.isOccupied()) return;

    Unsigned dd = abs(vl-vr);    // dist btwn left and right
    Unsigned ld = abs(vl-vc);    // dist btwn left and center
    Unsigned rd = abs(vr-vc);    // dist btwn right and center
    Int c = (Int) ld - (Int) rd; // <0 center too left (rd too big), >0 center too right (ld too big)
    ASCII val = (ASCII) (c/2 + 127); // <127 center too left, >127 center too right
    oss.setOccupied(val,BeeveeBIMXBlock.cTAPIDX_TRAKPD);  // with lub from us

    mD&&pR("MYBFG14")&&pR(oss);
  }

  Bool mWheelSpeedControl = false;

  typedef FixedPoint(7u,9u) FPErr;
  FPErr mLastError;
  FPErr mIntegralError;

  typedef FixedPoint(7u,0u) FP30; // opps no frac at the inn
  FP30 mTargetMaxSpeed = { .mFP = (FP30.FP) (4u<<FP30.cFRAC_BITS) };
  FP30 mTargetMinSpeed = { .mFP = (FP30.FP) (1u<<FP30.cFRAC_BITS) };

  typedef FP30 MotorSpeeds[2];
  
  // SeqCore mPU;

  FPErr getKP(FPErr maxspeed, FPErr maxerror) {
    return maxspeed/maxerror;   //< DEFAULT VALUE
  }
  FPErr getKI(FPErr maxspeed, FPErr maxerror) {
    return FPErr.instanceof(1,100);   //< DEFAULT VALUE 0.01
  }
  FPErr getKD(FPErr maxspeed, FPErr maxerror) {
    return getKP(maxspeed,maxerror)*FPErr.instanceof(4);   //< DEFAULT VALUE: kD = 4*kP
  }

  FPErr getLastError() { return mLastError; }
  Void setLastError(FPErr error) { mLastError = error; }

  FPErr getIntegralError() { return mIntegralError; }
  Void setIntegralError(FPErr error) { mIntegralError = error; }

  FPErr updateError(FPErr thisError, Unsigned pctNew) {
    Int ipct = (Int) pctNew;
    FPErr fracN(ipct,100);
    FPErr fracO(100-ipct,100);
    mLastError = mLastError*fracO + thisError*fracN;
    return mLastError;
  }

  Void update(FPErr linePos, MotorSpeeds speeds) {
    speeds[0].setFraction(3,5);
    speeds[1].setFraction(-5,3);
  }
}

/**
   \color #000
   \symbol Ks
*/
element PDSET + DTU {
  Void behave() {
    EventWindow ew;
    for (SN sn = 1u; sn <= 40u; ++sn) {
      if (!ew.isAccessible(sn)) continue;
      Atom & a = ew[sn];
      if (a as TRAKPD) {
        Random random;
        TRAKPD.FP30 minspeed(random.between(-4,30),2);
        TRAKPD.FP30 spread(random.between(0,30),3);
        TRAKPD.FP30 maxspeed(minspeed+spread);
        a.mTargetMinSpeed = minspeed;
        a.mTargetMaxSpeed = maxspeed;
      }
    }
    ew[0] = Empty.instanceof;
  }
}


