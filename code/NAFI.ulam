quark ProgramCounter + Fail {
  //// ProgramCounter API
  virtual Bool getPC(Unsigned & curpc) ;  //< WARNING! DO NOT CALL pRStack inside getPC! pRStack calls getPC!

  virtual Bool setPC(Unsigned newpc) ;

  //// ProgramCounter SERVICES
  Bool getPC(Int &intpc) {
    Unsigned pc;
    if (!getPC(pc)) return false;
    if (pc > (Unsigned) Int.maxof) return false; // yeahright
    intpc = (Int) pc;
    return true;
  }

  Bool setPC(Int intpc) {
    if (intpc < 0) fail(__FILE__,__LINE__,__FUNC__);
    return setPC((Unsigned) intpc);
  }
  Unsigned getPCOrDie() {
    Unsigned ret;
    if (!getPC(ret)) fail(__FILE__,__LINE__,__FUNC__);
    return ret;
  }
  Void setPCOrDie(Unsigned newpc) {
    if (!setPC(newpc)) fail(__FILE__,__LINE__,__FUNC__);
  }
}

quark PCUnsigned : ProgramCounter {
  Unsigned mPC;
  @Override Bool getPC(Unsigned & curpc) {
    curpc = mPC;
    return true;
  }
  @Override Bool setPC(Unsigned newpc) {
    mPC = newpc;
    return true;
  }
}

/** Not A Forth Interpreter
 * Abstract base class for stack-based interpreters
 */
quark NAFI + ProgramCounter + CodeMethods {
  //// NAFI API
  virtual Void reset() ;
  virtual Unsigned stackSize() ;
  virtual Bool isEmpty() ;
  virtual Bool isFull() ;
  virtual Bool push(FOC op) ;
  virtual Bool pop(FOC & op) ;
  virtual Bool printStackTo(ByteStreamWriter & bsw) ;

  virtual Bool getPC(Unsigned & curpc) ;
  virtual Bool setPC(Unsigned newpc) ;

  virtual Bool canBlock() { return false; } //< no by default; AtomNAFI says yes

  //// NAFI SERVICES
  Bool pRStack(String msg) { return pRStack(msg, "", ""); }
  Bool pRStack(String m1, String m2) { return pRStack(m1, m2, ""); }

  Bool pRStack(String m1, String m2, String m3) {
    ByteStreamLogger bsl;
    bsl.printf("%s%s%s: ",m1,m2,m3);
    Unsigned pc;
    Bool ret = printStackTo(bsl);
    if (!ret) bsl.printf(" XXX");

    if (getPC(pc)) {
      String src;
      if (!readRAMSource((Int) pc,src)) src = "??";
      bsl.printf(" @%dC: %s",pc,src);
    } else
      bsl.printf(" @--");
    bsl.printf("\n");
    return ret;
  }

  Bool push(Bool b) { return push(b ? 1 : 0); }

  Bool push(Unsigned u) {
    if (u > (Unsigned) FOC.maxof) return false;
    return push((FOC) u);
  }

  Bool evalOp(Int op, Int & result, MetroState & ms) {
    (BeeveeParms.pNAFI_TRACING>0u)&&pRStack("NATR/evalOP")&&pR(op)&&pR(nameOfOperator(op));
    //XXX    if (evaluateThisOperatorOnly(op,self,g,l,t,e)) {
    if (evaluateThisOperatorOnly(op,ms)) {
      (BeeveeParms.pNAFI_TRACING>0u)&&pRStack("NATR/evalOP done");
      return pop(result);
    }
    return false;
  }

  Bool evalFunction(Int initpc, Int & result, MetroState & ms) {
    (BeeveeParms.pNAFI_TRACING>0u)&&pRStack("NATR/evalFunction")&&pR(initpc)&&pR(nameOfFunction(initpc));
    mD&&pR("EVFN10")&&pR(initpc)&&pR(nameOfFunction(initpc));
    if (!setPC(initpc))
      return false;
    Int v;
    if (!readRAM(initpc,v)) return false;
    mD&&pR("EVFN11")&&pR(v);
    // MULTIPLE oENTERs NOW..    if (v != oENTER) return false;
    push(1);                    // fake return address
    mD&&pRStack("EVFN12PRE-EO-LOOP")&&pR(nameOfOperator(v));
    (BeeveeParms.pNAFI_TRACING>0u)&&pRStack("NATR/evalFunction START");
    Unsigned pc;
    while (evaluateOperator(ms) && getPC(pc) && pc > 1u) { // pc == 1: returned to top level
      (BeeveeParms.pNAFI_TRACING>0u)&&pRStack("NATR/evalFunction LOOP");
      mD&&pRStack("EVN13IN-EO-LOOP")&&pR(pc);
    }
    mD&&pRStack("EVFN14POST-EO-LOOP")&&pR(pc);
    if (pc == 1u) {
      pop(result);
      mD&&pR("EVFN15-EO-RESULT")&&pR(result);
      (BeeveeParms.pNAFI_TRACING>0u)&&pRStack("NATR/evalFunction done")&&pR(result);
      return true;
    } // else evaluateOperator failed
    (BeeveeParms.pNAFI_TRACING>0u)&&pRStack("NATR/evalFunction fail")&&pR(self);
    /*mD&&*/pRStack("EVFN16FAIL")&&pR(initpc)&&pR(self);
    return false;
  }

  Int clampImmed(Int in) {
    if (in < cFOC_MIN_IMMEDIATE) return cFOC_MIN_IMMEDIATE;
    if (in > cFOC_MAX_IMMEDIATE) return cFOC_MAX_IMMEDIATE;
    return in;
  }
}



