transient FunctionValues + DTU + QDebugUtils + Fail {
  constant FOC cFOC_NONE = Int.minof;
  constant FOC cFOC_CLOK_FRONT = cFOC_NONE + 1;
  constant FOC cFOC_CLOK_REAR = cFOC_CLOK_FRONT + 1;
  constant FOC cFOC_GREY_FCTR = cFOC_CLOK_REAR + 1;
  constant FOC cFOC_VALID_SPEED = cFOC_GREY_FCTR + 1;
  constant FOC cFOC_CUR_SPEED = cFOC_VALID_SPEED + 1;
  constant FOC cFOC_VALID_HEAD = cFOC_CUR_SPEED + 1;
  constant FOC cFOC_CUR_HEAD = cFOC_VALID_HEAD + 1;
  
  constant FOC cFOC_MAX_RESERVED = Int.minof / 2;
  constant FOC cFOC_MIN_IMMEDIATE = cFOC_MAX_RESERVED + 1;
  constant FOC cFOC_MAX_IMMEDIATE = Int.maxof / 2;  //< top half reserved for nothing except symmetry

  Bool getFunctionValue(Int predvalidx, Int & result, GTCC & g, TRAKtor & t, LOCZ & l) {
    which (predvalidx) {
    case cFOC_NONE:        { return false; }
    case cFOC_CLOK_FRONT:  { result = g.mNewCloks[0]; return true; }
    case cFOC_CLOK_REAR:   { result = g.mNewCloks[1]; return true; }
    case cFOC_GREY_FCTR:   { result = g.mCenterGrey; return true; }
    case cFOC_VALID_SPEED: { result = l.mSpeed8Valid ? 1 : 0; return true; } 
    case cFOC_CUR_SPEED:   {
      if (l.mSpeed8Valid) { result = (Int) l.mSpeed8 - 8; return true; }
      return false;
    }
    case cFOC_VALID_HEAD:  { result = l.mHeadingValid ? 1 : 0; return true; }
    case cFOC_CUR_HEAD:    {
      if (l.mHeadingValid) { result = l.mHeading; return true; }
      return false;
    }
    }
    if (predvalidx >= cFOC_MIN_IMMEDIATE &&
        predvalidx <= cFOC_MAX_IMMEDIATE) {
      result = predvalidx;
      return true;
    }
    return false;
  }
}

transient FunctionOps + DTU + QDebugUtils + Fail {
  constant Unsigned cFOC_NOP = 0u;

  constant Unsigned cFOC_CMP_EQ = 1u;
  constant Unsigned cFOC_CMP_NE = 2u;
  constant Unsigned cFOC_CMP_LT = 3u;
  constant Unsigned cFOC_CMP_LE = 4u;
  constant Unsigned cFOC_CMP_GT = 5u;
  constant Unsigned cFOC_CMP_GE = 6u;

  constant Unsigned cFOC_MAX = 7u;
  constant Unsigned cFOC_MIN = 8u;

  constant Unsigned cFOC_ADD = 9u;
  constant Unsigned cFOC_SUB = 10u;
  constant Unsigned cFOC_MUL = 11u;
  constant Unsigned cFOC_DIV = 12u;

  constant Unsigned cFOC_AND = 13u;
  constant Unsigned cFOC_OR =  14u;

  constant Unsigned cFOC_NOT = 15u;
  constant Unsigned cFOC_NEG = 16u;

  constant Arities cOP_ARITIES[] = {
    { .mIn = 0, .mOut = 0 }, // cFOC_NOP = 0u;

    { .mIn = 2, .mOut = 1 }, // cFOC_CMP_EQ = 1u;
    { .mIn = 2, .mOut = 1 }, // cFOC_CMP_NE = 2u;
    { .mIn = 2, .mOut = 1 }, // cFOC_CMP_LT = 3u;
    { .mIn = 2, .mOut = 1 }, // cFOC_CMP_LE = 4u;
    { .mIn = 2, .mOut = 1 }, // cFOC_CMP_GT = 5u;
    { .mIn = 2, .mOut = 1 }, // cFOC_CMP_GE = 6u;

    { .mIn = 2, .mOut = 1 }, // cFOC_MAX = 7u;
    { .mIn = 2, .mOut = 1 }, // cFOC_MIN = 8u;

    { .mIn = 2, .mOut = 1 }, // cFOC_ADD = 9u;
    { .mIn = 2, .mOut = 1 }, // cFOC_SUB = 10u;
    { .mIn = 2, .mOut = 1 }, // cFOC_MUL = 11u;
    { .mIn = 2, .mOut = 1 }, // cFOC_DIV = 12u;

    { .mIn = 2, .mOut = 1 }, // cFOC_AND = 13u;
    { .mIn = 2, .mOut = 1 }, // cFOC_OR =  14u;

    { .mIn = 1, .mOut = 1 }, // cFOC_NOT = 15u;
    { .mIn = 1, .mOut = 1 }, // cFOC_NEG = 16u;
  };
  


  Bool isImmediate(Int i) {
    return
      i >= FunctionValues.cFOC_MIN_IMMEDIATE &&
      i <= FunctionValues.cFOC_MAX_IMMEDIATE;
  }
      
  Bool evaluateBinOp(Unsigned predidx, Int a1, Int a2, Int & result) {
    which (predidx) {
    case cFOC_CMP_EQ: { result = (a1 == a2 ? 1 : 0); return true; }
    case cFOC_CMP_NE: { result = (a1 != a2 ? 1 : 0); return true; }
    case cFOC_CMP_LT: { result = (a1 <  a2 ? 1 : 0); return true; }
    case cFOC_CMP_LE: { result = (a1 <= a2 ? 1 : 0); return true; }
    case cFOC_CMP_GT: { result = (a1 >  a2 ? 1 : 0); return true; }
    case cFOC_CMP_GE: { result = (a1 >= a2 ? 1 : 0); return true; }

    case cFOC_MAX: {result = a1 < a2 ? a2 : a1; return true; }
    case cFOC_MIN: {result = a1 > a2 ? a2 : a1; return true; }

    case cFOC_ADD: {result = a1 + a2; return isImmediate(result); }
    case cFOC_SUB: {result = a1 - a2; return isImmediate(result); }
    case cFOC_MUL: {result = a1 * a2; return isImmediate(result); }
    case cFOC_DIV: {
      if (a2 == 0) return false;
      result = a1 / a2;
      return isImmediate(result);
    }

    case cFOC_AND: { result = (a1 == 0) ? a1 : a2; return true; }
    case cFOC_OR:  { result = (a1 != 0) ? a1 : a2; return true; }
    }
  }
}
