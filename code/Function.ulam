use NAFI;

@Concrete
transient Function : NAFI {
  constant Unsigned cSTACK_SIZE = 10u; // gimme a break (max possible 250-something)
  Int mStack[cSTACK_SIZE];
  Unsigned mStackFF = 0u;       //< first free pos on stack

  Unsigned mPC;                 //< program counter

  //// NAFI API
  @Override Void reset() {
    mStackFF = 0u;
    mPC = 0u;
  }

  @Override Unsigned stackSize() { return cSTACK_SIZE; }
  @Override Bool isEmpty() { return mStackFF == 0u; }
  @Override Bool isFull() { return mStackFF >= cSTACK_SIZE - 1u; }

  @Override Bool push(FOC op) {
    if (!isFull()) {
      mStack[mStackFF++] = op;
      (BeeveeParms.pNAFI_TRACING>=2u)&&pRStack("fNATR/pushed");
      return true;
    }
    (BeeveeParms.pNAFI_TRACING>=2u)&&pRStack("fNATR/pushFailedOn")&&pR(op)&& pR(nameOfOperator(op));
    return false;
  }

  @Override Bool pop(FOC & op) {
    if (!isEmpty()) {
      op = mStack[--mStackFF];
      (BeeveeParms.pNAFI_TRACING>=2u)&&pRStack("fNATR/popped")&&pR(op)&&pR(nameOfOperator(op));
      return true;
    }
    (BeeveeParms.pNAFI_TRACING>=2u)&&pRStack("fNATR/popFailed");
    return false;
  }

  @Override Bool getPC(Unsigned & curpc) {
    curpc = mPC;
    //// WARNING! CANNOT CALL pRStack inside getPC! pRStack callsg etPC!
    //(BeeveeParms.pNAFI_TRACING>=2u)&&pR("fNATR/getPC")&&pR(curpc);
    return true;
  }
  @Override Bool setPC(Unsigned newpc) {
    (BeeveeParms.pNAFI_TRACING>=2u)&&pRStack("fNATR/setPC")&&pR(mPC)&&pR(newpc);
    mPC = newpc;
    return true;
  }

  @Override Bool printStackTo(ByteStreamWriter & bsw) {
    //// WARNING! CANNOT CALL pRStack inside printStackTo! pRStack calls printStackTo!
    bsw.print(" Fb[");
    Bool first = true;
    //    for (Int i = (Int) mStackFF; --i >= 0; ) {
    for (Int i = -1; ++i < (Int) mStackFF; ) {
      if (first) first = false;
      else bsw.print(" ");
      Int s = mStack[i];
      String n = nameOfOperatorOrNull(s); // try op first
      //if (!(Bool) n) n = nameOfFunctionOrNull(s); // then try func
      if ((Bool) n) {
        bsw.print(n);
      }
      bsw.print("#");
      bsw.print(s);             // include decimal anyway
    }
    bsw.print("]Ft");
    return true;
  }

}

