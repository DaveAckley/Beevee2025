quark FunctionOpCodes + DTU {
  typedef Int FOC;
  constant FOC cFOC_BASE_VAL = Int.minof + 1;
  constant FOC cFOC_DONE = cFOC_BASE_VAL + 1; //< ToS is result
  constant FOC cFOC_CLOK_FRONT = cFOC_DONE + 1;
  constant FOC cFOC_CLOK_REAR = cFOC_CLOK_FRONT + 1;
  constant FOC cFOC_GREY_FCTR = cFOC_CLOK_REAR + 1;
  constant FOC cFOC_GREY_CDEV = cFOC_GREY_FCTR + 1;
  constant FOC cFOC_VALID_SPEED = cFOC_GREY_CDEV + 1;
  constant FOC cFOC_CUR_SPEED = cFOC_VALID_SPEED + 1;
  constant FOC cFOC_VALID_HEAD = cFOC_CUR_SPEED + 1;
  constant FOC cFOC_CUR_HEAD = cFOC_VALID_HEAD + 1;
  
  constant FOC cFOC_NOP = cFOC_CUR_HEAD + 1;
  constant FOC cFOC_CMP_EQ = cFOC_NOP + 1;
  constant FOC cFOC_CMP_NE = cFOC_CMP_EQ + 1;
  constant FOC cFOC_CMP_LT = cFOC_CMP_NE + 1;
  constant FOC cFOC_CMP_LE = cFOC_CMP_LT + 1;
  constant FOC cFOC_CMP_GT = cFOC_CMP_LE + 1;
  constant FOC cFOC_CMP_GE = cFOC_CMP_GT + 1;
  constant FOC cFOC_MAX = cFOC_CMP_GE + 1;
  constant FOC cFOC_MIN = cFOC_MAX + 1;
  constant FOC cFOC_ADD = cFOC_MIN + 1;
  constant FOC cFOC_SUB = cFOC_ADD + 1;
  constant FOC cFOC_MUL = cFOC_SUB + 1;
  constant FOC cFOC_DIV = cFOC_MUL + 1;
  constant FOC cFOC_AND = cFOC_DIV + 1;
  constant FOC cFOC_OR =  cFOC_AND + 1;
  constant FOC cFOC_NOT = cFOC_OR + 1;
  constant FOC cFOC_NEG = cFOC_NOT + 1;

  constant FOC cFOC_LAST_DEFINED = cFOC_NOT;

  constant FOC cFOC_MAX_RESERVED = Int.minof/2; // (LAST_DEFINED..MAX_RESERVED] -> future ops ha

  constant FOC cFOC_MIN_IMMEDIATE = cFOC_MAX_RESERVED + 1;
  constant FOC cFOC_MAX_IMMEDIATE = Int.maxof/2 - 1; // for no reason but symmetry

  Bool isImmediate(FOC op) {
    return op >= cFOC_MIN_IMMEDIATE && op <= cFOC_MAX_IMMEDIATE;
  }

