use NAFI;

@Concrete
transient Function : NAFI {
  constant Unsigned cSTACK_SIZE = 100u; // gimme a break (max possible 250-something)
  Int mStack[cSTACK_SIZE];
  Unsigned mStackFF = 0u;       //< first free pos on stack

  Unsigned mPC;                 //< program counter

  //// NAFI API
  @Override Unsigned stackSize() { return cSTACK_SIZE; }
  @Override Bool isEmpty() { return mStackFF == 0u; }
  @Override Bool isFull() { return mStackFF >= cSTACK_SIZE - 1u; }

  @Override Bool push(FOC op) {
    if (!isFull()) {
      mStack[mStackFF++] = op;
      return true;
    }
    return false;
  }

  @Override Bool pop(FOC & op) {
    if (!isEmpty()) {
      op = mStack[--mStackFF];
      return true;
    }
    return false;
  }

  @Override Bool getPC(Unsigned & curpc) {
    curpc = mPC;
    return true;
  }
  @Override Bool setPC(Unsigned newpc) {
    mPC = newpc;
    return true;
  }

  @Override Bool printStackTo(ByteStreamWriter & bsw) {
    bsw.print(" <");
    Bool first = true;
    for (Int i = (Int) mStackFF; --i >= 0; ) {
      if (first) first = false;
      else bsw.print(" ");
      Int s = mStack[i];
      String n = nameOfOperatorOrNull(s); // try op first
      //if (!(Bool) n) n = nameOfFunctionOrNull(s); // then try func
      if ((Bool) n) {
        bsw.print(n);
      }
      bsw.print("#");
      bsw.print(s);             // include decimal anyway
    }
    bsw.print("<");
    return true;
  }

}

