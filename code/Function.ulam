    { .mIn = 0u, .mOut = 1u },      // cFOC_CLOK_REAR
    { .mIn = 0u, .mOut = 1u },      // cFOC_GREY_FCTR
    { .mIn = 0u, .mOut = 1u },      // cFOC_GREY_CDEV
