}

transient FunctionBlock(Unsigned cSLOTS) + FunctionOpCodes {
  Int mOps[cSLOTS];
  Bool eval(Function & stack, GTCC & g, LOCZ & l, TRAKtor & t) {
    for (Unsigned pc = 0u; pc < cSLOTS; ++pc) {
      Int op = mOps[pc];
      if (op == cFOC_DONE) return true; // "answer on top of stack"
      if (!stack.eval(op,g,t,l)) break;
    }
    return false;               // "eval failed"
  }
}

transient Function + FunctionOpCodes + CodeConstants + QDebugUtils {
  constant Unsigned cSTACK_SIZE = 100u; // gimme a break (max possible 250-something)
  Int mStack[cSTACK_SIZE];
  Unsigned mStackFF = 0u;       //< first free pos on stack

  Bool isEmpty() { return mStackFF == 0u; }

  Bool isFull() { return mStackFF >= cSTACK_SIZE - 1u; }

  Bool push(FOC op) {
    if (!isFull()) {
      mStack[mStackFF++] = op;
      return true;
    }
    return false;
  }

  Bool push(Bool b) { return push(b ? 1 : 0); }

  Bool pop(FOC & op) {
    if (!isEmpty()) {
      op = mStack[--mStackFF];
      return true;
    }
    return false;
  }

  Bool evalOp(Int op, Int & result, GTCC & g, LOCZ & l, TRAKtor & t) {
    if (evaluateThisOperatorOnly(op,self,g,l,t)) {
      return pop(result);
    }
    return false;
  }

  Bool evalFunction(Int pc, Int & result, GTCC & g, LOCZ & l, TRAKtor & t) {
    mD&&pR("EVFN10")&&pR(pc)&&pR(nameOfFunction(pc));
    Int v;
    if (!readRAM(pc,v)) return false;
    mD&&pR("EVFN11")&&pR(v);
    if (v != oENTER) return false;
    push(1);                    // fake return address
    mD&&pR("EVFN12")&&pR(nameOfOperator(v));
    while (evaluateOperator(pc,self,g,l,t) && pc > 1) { // pc == 1: returned to top level
      mD&&pRStack("EVN13")&&pR(pc);
    }
    mD&&pRStack("EVFN14")&&pR(pc);
    if (pc == 1) {
      pop(result);
      mD&&pR("EVFN15")&&pR(result);
      return true;
    } // else evaluateOperator failed
    mD&&pRStack("EVFN16")&&pR(self);
    return false;
  }

  Bool pRStack(String msg) {
    ByteStreamLogger buf;
    buf.forceOutput(true);
    buf.print(msg);
    buf.print(" <");
    Bool first = true;
    for (Int i = (Int) mStackFF; --i >= 0; ) {
      if (first) first = false;
      else buf.print(" ");
      Int s = mStack[i];
      String n = nameOfOperatorOrNull(s); // try op first
      //if (!(Bool) n) n = nameOfFunctionOrNull(s); // then try func
      if ((Bool) n) {
        buf.print(n);
      }
      buf.print("#");
      buf.print(s);             // include decimal anyway
    }
    buf.print("<\n");
    return true;
  }

  Int clampImmed(Int in) {
    if (in < cFOC_MIN_IMMEDIATE) return cFOC_MIN_IMMEDIATE;
    if (in > cFOC_MAX_IMMEDIATE) return cFOC_MAX_IMMEDIATE;
    return in;
  }

  /*
  Bool doOp(FOC op, Int ins[3], Int outs[3], GTCC & g, TRAKtor & t, LOCZ & l) {
    Int i1 = ins[0], i2 = ins[1], i3 = ins[2];
    Int & o1 = outs[0], & o2 = outs[1], & o3 = outs[2];
    which (op) {
    case cFOC_CLOK_FRONT: { outs[0] = g.mNewCloks[0]; return true; } // front newclok
    case cFOC_CLOK_REAR: { outs[0] = g.mNewCloks[1]; return true; } // rear newclok
    case cFOC_GREY_FCTR: { outs[0] = g.mCenterGrey; return true; } // front center grey
    case cFOC_GREY_CDEV: { outs[0] = (Int) abs(128-g.mCenterGrey); return true; } // front center grey distance from 128
    case cFOC_VALID_SPEED: { outs[0] = l.mSpeed8Valid ? 1 : 0; return true; } // cur speed valid
    case cFOC_CUR_SPEED: { outs[0] = l.mSpeed8 - 8; return true; } // cur speed 
    case cFOC_VALID_HEAD: { outs[0] = l.mHeadingValid ? 1 : 0; return true; } // heading valid
    case cFOC_CUR_HEAD: { outs[0] = l.mHeading; return true; } // cur heading

    case cFOC_NOP: { return true; }
    case cFOC_CMP_EQ: { outs[0] = ins[0] == ins[1] ? 1 : 0; return true; }
