[function.fWAIT_A_WHILE]
  doc = "delay for some time"
  code = [ oENTER1,           # stack is [... COUNT]
           oSET_GSCOUNTER,    # GSC = COUNT, [... ]
         lWAIT_LOOP,
           tBLOCK_FOR_SMTIMER, oSTART_TRAKT, oWAIT_READY,
           oDECR_GSCOUNTER,  # [..., GSC]
           aWAIT_LOOP, oGOTON,  # gsc!=0 -> wait loop [...]
           oRETURN0
          ]
           
[function.fDRIVE_TO_ORIGIN14]
  doc = "nth**nth attempt to drive to origin"
  code = [ oENTER0,
           4, fWAIT_A_WHILE, oCALL1,   # Wait for axons etc on startup!

         lFIRST_FIND_LINE,
           oRESET_HEAD,                            # forget any old heading/pos info
           4, oSET_GSCOUNTER,                      # init give-up counter
         lTURN_LOOP,
           fFWD_ONE_SQUARE, oCALL0,                # straighten up, move ahead
           fEAST_AND_ON_LINE, oCALL0,              # check if done
           aIT_WORKED, oGOTON,                     # we is
           fTURN_LEFT, oCALL0,                     # we ain't. turn left
           oDECR_GSCOUNTER, aTURN_LOOP, oGOTON,    # loop til counter == 0

         lESCAPE_RETRY,                            # here when counter expires
           tDRIVE_AWHILE, oSTART_TRAKT, oWAIT_READY,       # go somewhere else
           aFIRST_FIND_LINE, oGOTO,                # and try again

         lIT_WORKED,                               # we are facing east and on line
           # DRIVE SLOW EAST
           tDRIVE_SLOW, oSTART_TRAKT, oWAIT_READY,      # else (is BIGGREEN, so) drive slow
           tROLLING_STOP, oSTART_TRAKT, oWAIT_READY,    # make sure we just don't fly through here

           tTOUCH_RED, oSTART_TRAKT, oWAIT_READY,  # NOW TOUCH RED!
           tDONT_TOUCH_RED, oSTART_TRAKT, oWAIT_READY,  # NOW BACK OFF!
           # SET X ORIGIN!
           0, oSET_XPOS,  
           tDRESS_LINE_REV_XI, oSTART_TRAKT, oWAIT_READY,  # back up away from allred


           # Sat Apr 19 03:53:08 2025 Hoping we don't need this
           #  now, with the new eyes-following-turns stuff
           # TURN WEST TO CLEAR RED WARNING
#           fTURN_RIGHT_TICK, oCALL0,          # fwd, dress, right [...]
#           fTURN_RIGHT_TICK, oCALL0,          # fwd, dress, right [...]      

           # TURN SOUTH AND DRIVE
           fTURN_RIGHT_XI, oCALL0,   # face S
           fTURN_RIGHT, oCALL0,      # face W (clear warnings?)
           fFWD_ONE_SQUARE_ONLY, oCALL0,  # get further off edge
           fTURN_LEFT, oCALL0,      # face S again

           tDRIVE_SLOW, oSTART_TRAKT, oWAIT_READY,     # drive slow
           tROLLING_STOP, oSTART_TRAKT, oWAIT_READY,   # again, don't fly through here

           tTOUCH_RED, oSTART_TRAKT, oWAIT_READY,  # NOW TRY TO TOUCH RED! SPIKE2
           tDONT_TOUCH_RED, oSTART_TRAKT, oWAIT_READY,  # NOW BACK OFF!
           # SET Y ORIGIN!
           0, oSET_YPOS,
           tDRESS_LINE_REV_XI, oSTART_TRAKT, oWAIT_READY,  # back up away from allred

           # TURN WEST AND DRIVE
           fTURN_RIGHT, oCALL0,               # fwd, dress, right [...]
           tDRIVE_SLOW, oSTART_TRAKT, oWAIT_READY,    # drive slow
           tROLLING_STOP, oSTART_TRAKT, oWAIT_READY,   # again, don't fly through here

           tTOUCH_RED, oSTART_TRAKT, oWAIT_READY,  # NOW TRY TO TOUCH RED! SPIKE2
           tDONT_TOUCH_RED, oSTART_TRAKT, oWAIT_READY,  # NOW BACK OFF!
           tDRESS_LINE_REV_XI, oSTART_TRAKT, oWAIT_READY, # back up when drive slow ends

           # SET GRID WIDTH!
           oGET_XPOS, oSET_GRID_WIDTH,        

           # TURN NORTH AND DRIVE
           fTURN_RIGHT_XI, oCALL0,                # TURN NORTH
           tDRIVE_SLOW, oSTART_TRAKT, oWAIT_READY,    # drive slow
           tROLLING_STOP, oSTART_TRAKT, oWAIT_READY,   # again, don't fly through here
           tTOUCH_RED, oSTART_TRAKT, oWAIT_READY,  # NOW TRY TO TOUCH RED! SPIKE2

           tDRESS_LINE_REV_XI, oSTART_TRAKT, oWAIT_READY, # back up when drive slow ends

           # SET GRID HEIGHT!
           oGET_YPOS, oSET_GRID_HEIGHT,        

           # PICK MIDDLE OF GRID AS DEST
           oGET_GRID_WIDTH, 2, oDIV, oSET_DEST_X,      
           oGET_GRID_HEIGHT, 2, oDIV, oSET_DEST_Y,     
           1, oSET_DEST_EXISTS,        

           #### GO THERE!

          lBEEVEE_UBER_ALLES,
           fDRIVE_TO_DEST, oCALL0,
           1, fWAIT_A_WHILE, oCALL1,
           0, oSET_DEST_EXISTS, # You Have Arrived
           2, fWAIT_A_WHILE, oCALL1,
           
           # PICK RANDOM GRID LOC AS DEST
           2, oGET_GRID_WIDTH, oRAND_BETWEEN, oSET_DEST_X,        
           2, oGET_GRID_HEIGHT, oRAND_BETWEEN, oSET_DEST_Y,        
           1, oSET_DEST_EXISTS,        
           aBEEVEE_UBER_ALLES, oGOTO,          

           oRETURN0   ## NOT REACHED
          ]

[function.fDRIVE_TO_DEST]
  doc = """
  Reduce distance between XYPOS and XYDEST to zero ho ho. Theory of
  operation, version 0: See if moving on the current heading will
  reduce total distance. If so, go forward a square, if not, turn
  left. Repeat until distance is zero, then clear dest exists.
  """
  code = [ oENTER0,
          lLOOP,
           oGET_DEST_EXISTS, aSTEPW, oGOTON, oRETURN0, # if no dest, done
          lSTEPW,  # split on heading
           oCUR_HEAD, 0, oCMP_EQ, aWEST, oGOTON,
           oCUR_HEAD, 1, oCMP_EQ, aNORTH, oGOTON,
           oCUR_HEAD, 2, oCMP_EQ, aSOUTH, oGOTON,
           # FALL THROUGH - oCUR_HEAD == 3
          lEAST,
           oGET_DEST_X, oGET_XPOS, oSUB, -2, oCMP_LT, aGO, oGOTON,
           oGET_DEST_X, oGET_XPOS, oSUB, 0, oCMP_LT, aSLOW, oGOTON, aTURN, oGOTO,
          lWEST,
           oGET_DEST_X, oGET_XPOS, oSUB, 2, oCMP_GT, aGO, oGOTON,
           oGET_DEST_X, oGET_XPOS, oSUB, 0, oCMP_GT, aSLOW, oGOTON, aTURN, oGOTO,
          lSOUTH,
           oGET_DEST_Y, oGET_YPOS, oSUB, -2, oCMP_LT, aGO, oGOTON,
           oGET_DEST_Y, oGET_YPOS, oSUB, 0, oCMP_LT, aSLOW, oGOTON, aTURN, oGOTO,
          lNORTH,
           oGET_DEST_Y, oGET_YPOS, oSUB, 2, oCMP_GT, aGO, oGOTON,
           oGET_DEST_Y, oGET_YPOS, oSUB, 0, oCMP_GT, aSLOW, oGOTON,
           # FALL THROUGH

          lTURN, fTURN_LEFT, oCALL0, aLOOP, oGOTO,

           # DRIVE HE SAID
          lSLOW,
#           tDRESS_LINE_FWD, oSTART_TRAKT, oWAIT_READY,  # here to slow down?
#           tDRESS_LINE_REV, oSTART_TRAKT, oWAIT_READY,  
           fFWD_ONE_SQUARE_ONLY, oCALL0,
           tDRESS_LINE_FWD, oSTART_TRAKT, oWAIT_READY,
           # FALL THROUGH

          lGO, fFWD_ONE_SQUARE_ONLY, oCALL0, # advance one square
           oGET_DEST_X, oGET_XPOS, oSUB, 0, oCMP_NE, aLOOP, oGOTON, # loop if dx != 0
           oGET_DEST_Y, oGET_YPOS, oSUB, 0, oCMP_NE, aLOOP, oGOTON, # loop if dy != 0
           oRETURN0,
         ]

[function.fFWD_ONE_SQUARE]
  doc = "Go forward from tick to tock or vv, then get onto that square"
  code = [ oENTER0,
           fFWD_ONE_SQUARE_ONLY, oCALL0,
           tDRESS_LINE_FWD, oSTART_TRAKT, oWAIT_READY,
           oRETURN0
         ]

[function.fFWD_ONE_SQUARE_ONLY]
  doc = "Go forward from tick to tock or vv"
  code = [ oENTER0,
          lAGAIN,
           oCLOK_FRONT, cCLOK_TICK, oCMP_EQ, aFIND_TOCK, oGOTON, # jump ahead if front tick
           oCLOK_FRONT, cCLOK_TOCK, oCMP_EQ, aFIND_TICK, oGOTON, # jump ahead if front tock
           ### INVALIDATE POS/HEAD HERE?
           tFIND_LINE_RIGHT, oSTART_TRAKT, oWAIT_READY,               # otherwise get a front clock
           aAGAIN, oGOTO,                                     # and try again
          lFIND_TOCK, fFAST_FWD_TO_TOCK, oCALL0, oRETURN0,
          lFIND_TICK, fFAST_FWD_TO_TICK, oCALL0, oRETURN0,
         ]

[function.fTURN_LEFT]
  doc = "Turn left from tick to tock or vv"
  code = [ oENTER0,
          lAGAIN,
           tDRESS_LINE_FWD, oSTART_TRAKT, oWAIT_READY,              # hope to be squared up
           oCLOK_FRONT, cCLOK_TICK, oCMP_EQ, aTURN_TO_TOCK, oGOTON, # jump ahead if front tick
           oCLOK_FRONT, cCLOK_TOCK, oCMP_EQ, aTURN_TO_TICK, oGOTON, # jump ahead if front tock
           tFIND_LINE_RIGHT, oSTART_TRAKT, oWAIT_READY,             # otherwise get a front clock
           aAGAIN, oGOTO,                                           # and try again

          lTURN_TO_TOCK,
           tTURN_L_TO_TOCK, oSTART_TRAKT, oWAIT_READY,     
           -1, oINCR_HEAD,             
           aDRESS, oGOTO,

          lTURN_TO_TICK, 
           tTURN_L_TO_TICK, oSTART_TRAKT, oWAIT_READY,     
           -1, oINCR_HEAD,    
           # FALL THROUGH

          lDRESS,
           tDRESS_LINE_FWD, oSTART_TRAKT, oWAIT_READY, 
           oRETURN0
         ]

[function.fTURN_RIGHT_XI]
  doc = "Minimal right turn from tick to tock or vv with XI"
  code = [ oENTER0,
           oCLOK_FRONT, cCLOK_TICK, oCMP_EQ, aTURN_TO_TOCK, oGOTON, # jump ahead if front tick

          lTURN_TO_TICK, 
           tTURN_R_TO_TICK_XI, oSTART_TRAKT, oWAIT_READY,
           1, oINCR_HEAD,      
           oRETURN0,

          lTURN_TO_TOCK,
           tTURN_R_TO_TOCK_XI, oSTART_TRAKT, oWAIT_READY,     
           1, oINCR_HEAD,  
           oRETURN0
           ]


[function.fTURN_RIGHT]
  doc = "Turn right from tick to tock or vv"
  code = [ oENTER0,
          lAGAIN,
           tDRESS_LINE_FWD, oSTART_TRAKT, oWAIT_READY,              # hope to be squared up
           oCLOK_FRONT, cCLOK_TICK, oCMP_EQ, aTURN_TO_TOCK, oGOTON, # jump ahead if front tick
           oCLOK_FRONT, cCLOK_TOCK, oCMP_EQ, aTURN_TO_TICK, oGOTON, # jump ahead if front tock
           tFIND_LINE_LEFT, oSTART_TRAKT, oWAIT_READY,              # otherwise get a front clock
           aAGAIN, oGOTO,                                           # and try again

          lTURN_TO_TOCK,
           tTURN_R_TO_TOCK, oSTART_TRAKT, oWAIT_READY,     
           1, oINCR_HEAD,  
           aDRESS, oGOTO,

          lTURN_TO_TICK, 
           tTURN_R_TO_TICK, oSTART_TRAKT, oWAIT_READY,
           1, oINCR_HEAD,      
           # FALL THROUGH

          lDRESS,
           tDRESS_LINE_FWD, oSTART_TRAKT, oWAIT_READY,
           oRETURN0
         ]

[function.fFWD_TO_TICK]
  doc = "Go forward, maintaining pos if heading is set"
  code = [ oENTER0,
           tFORWARD_TO_TICK, oSTART_TRAKT, oWAIT_READY, # fwd [...]
           oINCR_POS,                           # advance pos if heading valid
           tDRESS_LINE_FWD, oSTART_TRAKT, oWAIT_READY,  # prep [...]
           oRETURN0                             # no return value
         ]

[function.fFWD_TO_TOCK]
  doc = "Go forward, maintaining pos if heading is set"
  code = [ oENTER0,
           tFORWARD_TO_TOCK, oSTART_TRAKT, oWAIT_READY, # fwd [...]
           oINCR_POS,                           # advance pos if heading valid
           tDRESS_LINE_FWD, oSTART_TRAKT, oWAIT_READY,  # prep [...]
           oRETURN0                             # no return value
         ]

[function.fFAST_FWD_TO_TICK]
  doc = "Go forward, maintaining pos if heading is set"
  code = [ oENTER0,
           tFORWARD_TO_TICK, oSTART_TRAKT, oWAIT_READY, # fwd [...]
           oINCR_POS,                           # advance pos if heading valid
#FASTER           tFAST_DRESS_LINE_FWD, oSTART_TRAKT, oWAIT_READY,  # prep [...]
           oRETURN0                             # no return value
         ]

[function.fFAST_FWD_TO_TOCK]
  doc = "Go forward, maintaining pos if heading is set"
  code = [ oENTER0,
           tFORWARD_TO_TOCK, oSTART_TRAKT, oWAIT_READY, # fwd [...]
           oINCR_POS,                           # advance pos if heading valid
#PUSSYCAT           tFAST_DRESS_LINE_FWD, oSTART_TRAKT, oWAIT_READY,  # prep [...]
           oRETURN0                             # no return value
         ]

[function.fTURN_RIGHT_FROM_TICK]
  doc = "Turn right from tick to tock, maintaining heading if set"
  code = [ oENTER0,
           tTURN_R_TO_TOCK, oSTART_TRAKT, oWAIT_READY,   # turn [...]
           1, oINCR_HEAD,                     # advance heading CW if valid
           oRETURN0                           # no return value
         ]

[function.fTURN_RIGHT_FROM_TOCK]
  doc = "Turn right from tock to tick, maintaining heading if set"
  code = [ oENTER0,
           tTURN_R_TO_TICK, oSTART_TRAKT, oWAIT_READY,   # turn [...]
           1, oINCR_HEAD,                     # advance heading CW if valid
           oRETURN0                           # no return value
         ]

[function.fTURN_LEFT_FROM_TICK]
  doc = "Turn left from tick to tock, maintaining heading if set"
  code = [ oENTER0,
           tTURN_L_TO_TOCK, oSTART_TRAKT, oWAIT_READY,    # turn [...]
           -1, oINCR_HEAD,                    # advance heading CCW if valid
           oRETURN0
         ]

[function.fTURN_LEFT_FROM_TOCK]
  doc = "Turn left tock to tick, maintaining heading if set"
  code = [ oENTER0,
           tTURN_L_TO_TICK, oSTART_TRAKT, oWAIT_READY,    # turn [...]
           -1, oINCR_HEAD,                    # advance heading CCW if valid
           oRETURN0
         ]

[constant.cTRUE] 
  value = 1

[constant.cFALSE]
  value = 0

[constant.cCLOK_NONE]
  doc="clok val neither tick or tock"

[constant.cCLOK_TICK]
  doc="clok val tick"

[constant.cCLOK_TOCK]
  doc="clok val tock"

[operator.oNOP]
  impl='return true'                        
[operator.oDUP]
  impl='return s.pop(v[0]) && s.push(v[0]) && s.push(v[0])'
[operator.oDROP]
  impl='return s.pop(v[0])'
[operator.oSWAP]
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[1]) && s.push(v[0])'
[operator.oENTER0]
  doc="Start a function taking 0 arguments"
  special=true
  impl='return true'
[operator.oENTER1]
  doc="Start a function taking 1 argument"
  special=true
  impl='return true'
[operator.oENTER2]
  doc="Start a function taking 2 arguments"
  special=true
  impl='return true'
[operator.oENTER3]
  doc="Start a function taking 3 arguments"
  special=true
  impl='return true'
[operator.oGOTO]
  special=true
  impl=''' // UNCONDITIONAL ABSOLUTE GOTO: stack is [..., NEXTPC]
      return //s.pRStack("RET=") && // DEBUG
             s.pop(v[0])            // v0 <- nextpc
          && s.setPC(v[0])          // jump there
  '''
[operator.oGOTOZ]
  special=true
  impl=''' // CONDITIONAL ABSOLUTE GOTO: stack is [..., IFZ, NEXTPC]
      return //bs.pRStack("IN oGOTOZ=") &&   // DEBUG
             s.pop(v[0])              // v0 <- NEXTPC  [..., IFZ]
          && s.pop(v[1])              // v1 <- IFZ  [...]
          && s.getPC(v[2])            // v2 <- .+1
          && ( ((v[1] != 0)             // done if IFZ non-zero
          //       && s.pRStack("NO JUMP OUT oGOTOZ=")
          )
             || (s.setPC(v[0])         // or jump to NEXTPC
          //       && s.pRStack("JUMP OUT oGOTOZ=")
          )
             )
  '''

[operator.oGOTON]
  special=true
  impl=''' // CONDITIONAL ABSOLUTE GOTO: stack is [..., IFNZ, NEXTPC]
      return //s.pRStack("IN oGOTON=") &&   // DEBUG
             s.pop(v[0])              // v0 <- NEXTPC  [..., IFNZ]
          && s.pop(v[1])              // v1 <- IFNZ  [...]
          && s.getPC(v[2])            // v2 <- .+1
          && (  ((v[1] == 0)          // done if IFNZ zero
          //   && s.pRStack("NO JUMP OUT oGOTON=")
          )
             || (s.setPC(v[0])         // or jump to NEXTPC
          //  && s.pRStack("JUMP OUT oGOTON=")
          )
             )
  '''

[operator.oJUMP]
  special=true
  impl=''' // UNCONDITIONAL RELATIVE GOTO: stack is [..., PCOFFSET]
      return s.pRStack("oJUMP=") &&   // DEBUG
             s.pop(v[0])              // v0 <- PCOFFSET  [...]
          && s.getPC(v[1])            // v2 <- .+1
          && s.setPC(v[1]+v[0]-1)  // jump to .+offset
  '''

[operator.oJUMPZ]
  special=true
  impl=''' // CONDITIONAL RELATIVE GOTO: stack is [PCOFFSET IFZ ...]
      return s.pRStack("oJUMPZ=") &&   // DEBUG
             s.pop(v[0])              // v0 <- PCOFFSET  [IFZ ...]
          && s.pop(v[1])              // v1 <- condition  [...]
          && s.getPC(v[2])            // v2 <- .+1
          && (  v[1] != 0             // done if IFZ non-zero
             || s.setPC(v[2]+v[0]-1)  // jump to .+offset
             )
  '''

[operator.oRETURN0]
  doc="Exit function returning zero values"
  special=true
  impl=''' // FUNCTION RETURN0: stack is [RETADDR ...]
      return //s.pRStack("RET0=") &&   // DEBUG
             s.pop(v[0])            // v0 <- retaddr
          && s.setPC(v[0])          // jump to retaddr 
  '''

[operator.oRETURN1]
  doc="Exit function returning one value"
  special=true
  impl=''' // FUNCTION RETURN1: stack is [RETVAL RETADDR ...]
      return //s.pRStack("RET1=") &&   // DEBUG
             s.pop(v[0])            // v0 <- retval
          && s.pop(v[1])            // v1 <- retaddr
          && s.push(v[0])           // restash retval
          && s.setPC(v[1])          // jump to retaddr 
  '''

[operator.oRETURN2]
  doc="Exit function returning two values"
  special=true
  impl=''' // FUNCTION RETURN2: stack is [RETVAL2 RETVAL1 RETADDR ...]
      return s.pRStack("RET2=") &&   // DEBUG
             s.pop(v[0])            // v0 <- retval2
          && s.pop(v[1])            // v1 <- retval1
          && s.pop(v[2])            // v2 <- retaddr
          && s.push(v[1])           // restash retval1
          && s.push(v[0])           // restash retval2
          && s.setPC(v[1])          // jump to retaddr 
  '''

[operator.oCALL0]
  doc="Call a function taking 0 arguments"
  special=true
  impl=''' // FUNCTION CALL: stack is [FUNCADDR ...]
      return s.pop(v[0])            // v0 <- funcaddr
          //&& s.pRStack(nameOfFunction(v[0])) // DEBUG
          && readRAM(v[0],v[1])     // v1 <- cRAM[funcaddr]
          && v[1] == oENTER0        // calladdr is func entry point
          && s.push(s.getPCOrDie()) // save retaddr
          && s.setPC(v[0] + 1)      // jump to funcaddr + 1, stack [RETADDR ...]
  '''

[operator.oCALL1]
  doc="Call a function taking 1 argument"
  special=true
  impl=''' // FUNCTION CALL: stack is [FUNCADDR ARG ...]
      return s.pop(v[0])            // v0 <- funcaddr
          //&& s.pRStack(nameOfFunction(v[0])) // DEBUG
          && readRAM(v[0],v[1])     // v1 <- cRAM[funcaddr]
          && v[1] == oENTER1        // calladdr is func entry point
          && s.pop(v[2])            // v2 <- ARG
          && s.push(s.getPCOrDie()) // push RETADDR
          && s.push(v[2])           // push ARG
          && s.setPC(v[0] + 1)      // jump to FUNCADDR + 1, stack [ARG RETADDR ...]
  '''

[operator.oCALL2]
  doc="Call a function taking 2 argument2"
  special=true
  impl=''' // FUNCTION CALL: stack is [FUNCADDR ARG2 ARG1 ...]
      return s.pop(v[0])            // v0 <- funcaddr
          //&& s.pRStack(nameOfFunction(v[0])) // DEBUG
          && readRAM(v[0],v[1])     // v1 <- cRAM[funcaddr]
          && v[1] == oENTER2        // calladdr is func entry point
          && s.pop(v[2])            // v2 <- ARG2
          && s.pop(v[3])            // v2 <- ARG1
          && s.push(s.getPCOrDie()) // push RETADDR
          && s.push(v[3])           // push ARG1
          && s.push(v[2])           // push ARG2
          && s.setPC(v[0] + 1)      // jump to FUNCADDR + 1, stack [ARG2 ARG1 RETADDR ...]
  '''

[operator.oSTART_TRAKT]
  special=true
  impl=''' // START TRAKT: stack is [TRAKT_NUM stuff.. ]
      if (!s.getPC(v[0])) return false; // getpc or fail
      if (!s.pop(v[1])) return false;   // pop TN or fail stack [ stuff.. ]
      if (v[1] < 0) return false;       // TN unsigned or fail

      if (t.startTRAKt(ms, (TRAKt) v[1])) { // try to start our trakt
        (BeeveeParms.pNAFI_TRACING%2u == 1u)&&pR("NATR/oSTART_TRAKT:started")&&s.pRStack(nameOfTRAKt((TRAKt) v[1]));
        s.pRStack("TRAKt ",nameOfTRAKt((TRAKt) v[1])," started");
        return true;                    // MOVE ON (PC incrd; stack popped)
      }
      // TRAKtor not ready: Block here
      (BeeveeParms.pNAFI_TRACING%2u == 1u)&&pR("NATR/oSTART_TRAKT:blocking")&&s.pRStack(nameOfTRAKt((TRAKt) v[1]));      
      if (!s.push(v[1])) return false;  // restore stack [ TN stuff.. ]
      if (s.setPC(v[0] - 1)) return false;  // back up PC (implying BLOCKED)
      return true;                      // TRY AGAIN (PC--; no stack change)
  '''

[operator.oWAIT_READY]
  special=true
  impl=''' // WAIT READY: stack is [stuff.. ]
      if (t.isReady()) { // check if trakor is ready
        (BeeveeParms.pNAFI_TRACING%2u == 1u)&&s.pRStack("NATR/oWAIT_READY:done");
        return true;                    // MOVE ON (PC incrd)
      }
      // TRAKtor not ready: Block here
      if (!s.getPC(v[0])) return false; // getpc or fail
      if (s.setPC(v[0] - 1)) return false;  // back up PC (implying BLOCKED)
      (BeeveeParms.pNAFI_TRACING%2u == 1u)&&s.pRStack("NATR/oWAIT_READY:block");
      return true;                      // TRY AGAIN (PC--; no stack change)
  '''

# [operator.oSTART_TRAKT_TRICKY]
#   special=true
#   impl=''' // RUN TRAKT: stack is [TRAKT_NUM stuff... ]
#       return s.getPC(v[0])          // v0 <- pc + 1 
#           && s.pop(v[1])            // v1 <- TN, stack [ stuff... ]
#           && t.isCurrentTRAKt(v[1]) // assert
#           && ( isTRAKtDone(v[1],g,l,t)  // move on, stack [ stuff... ]
#             || ( s.setPC(v[0] - 1)  // or back up PC
#               && s.push(v[0])       // reset stack [TN stuff... ]
#                )
#              )
#   '''

[operator.oALLRED]
  impl='return s.push(g.mAllRed ? 1 : 0)'        

[operator.oHARD_OFFLINE_FRONT]
  impl='return s.push(g.mHardOfflineFrontTimer.alarm() ? 1 : 0)'
[operator.oCLOK_FRONT]           # : { outs[0] = g.mNewCloks[0]; return true; } // front newclok
  impl='return s.push((Int) g.mNewCloks[0])'
[operator.oCLOK_REAR]           # : { outs[0] = g.mNewCloks[1]; return true; } // rear newclok
  impl='return s.push((Int) g.mNewCloks[1])'
[operator.oGREY_FCTR]           # : { outs[0] = g.mCenterGrey; return true; } // front center grey
  impl='return s.push(g.mCenterGrey)'
[operator.oVALID_SPEED]           # : { outs[0] = l.mSpeed8Valid ? 1 : 0; return true; } // cur speed valid
  impl='return s.push(l.mSpeed8Valid ? 1 : 0)'
[operator.oCUR_SPEED]           # : { outs[0] = l.mSpeed8 - 8; return true; } // cur speed 
  impl='return s.push(l.mSpeed8 - 8)'
[operator.oVALID_HEAD]           # : { outs[0] = l.mHeadingValid ? 1 : 0; return true; } // heading valid
  impl='return s.push(l.mHeadingValid ? 1 : 0)'
[operator.oCUR_HEAD]           # : { outs[0] = l.mHeading; return true; } // cur heading
  impl='return s.push(l.mHeading)'
[operator.oRESET_HEAD]
  impl='''
     l.mHeadingValid = false;
     l.mPosValid[0] = false;
     l.mPosValid[1] = false;
     return true    
  '''
[operator.oSET_HEAD] 
  impl='''
     if (!s.pop(v[0])) return false;
     if (v[0] > 3) return false;
     l.mHeadingValid = (v[0] >= 0); // negative heading means invalidate ugh
     l.mHeading = (AxialDir) v[0];
     return true
  '''
[operator.oINCR_HEAD]
  doc='[CW ...] if mHeadingValid, increment mHeading clockwise if CW > 0 else CCW'
  impl='''
     s.pRStack("IN oINCR_HEAD",l.mHeadingValid ? "(valid)" : "(invalid)");
     if (!s.pop(v[0])) return false;
     if (l.mHeadingValid) {
       l.mHeading = adjacentAxialDir(l.mHeading, v[0] > 0);
     }
     s.pR(l.mHeading);
     return true
  '''
[operator.oINCR_POS]
  doc='[...] if mHeadingValid, modify XPOS or YPOS based on mHeading'
  impl='''
     s.pRStack("IN oINCR_POS valid=",
       l.mHeadingValid ? "+h" : "-h",
       l.mPosValid[1] ? "+p" : "-p");
     if (!l.mHeadingValid) {
       l.mPosValid[0] = false;
       l.mPosValid[1] = false;
     } else if (l.mHeading == cW) {
       if (l.mPosValid[0]) ++l.mPos[0];
     } else if (l.mHeading == cN) {
       if (l.mPosValid[1]) ++l.mPos[1];
     } else if (l.mHeading == cS) {
       if (l.mPosValid[1]) --l.mPos[1];
     } else if (l.mHeading == cE) {
       if (l.mPosValid[0]) --l.mPos[0];
     }
     return true
  '''

[operator.oGET_XPOS] 
  doc='return [... XPOSOR0] if mPosValid[0], return XPOS, else 0'
  impl='''
     if (l.mPosValid[0]) v[0] = (Int) l.mPos[0];
     else v[0] = 0;
     if (!s.push(v[0])) return false;   // get x
     return true
  '''

[operator.oGET_YPOS] 
  doc='return [... YPOSOR0] if mPosValid[1], return YPOS, else 0'
  impl='''
     if (l.mPosValid[1]) v[0] = (Int) l.mPos[1];
     else v[0] = 0;
     if (!s.push(v[0])) return false;   // get y
     return true
  '''

[operator.oSET_XPOS] 
  impl='''
     if (!s.pop(v[0])) return false;     // get x
     l.mPosValid[0] = (v[0] >= 0);
     if (l.mPosValid[0]) l.mPos[0] = (LOCZ.TileCount) v[0];
     return true
  '''
[operator.oSET_YPOS] 
  impl='''
     if (!s.pop(v[0])) return false;     // get y
     l.mPosValid[1] = (v[0] >= 0);
     if (l.mPosValid[1]) l.mPos[1] = (LOCZ.TileCount) v[0];
     return true
  '''

[operator.oSET_GRID_WIDTH] 
  impl='''
     if (!s.pop(v[0])) return false;     // get w
     h.mGridSize[0] = (ASCII) v[0];
     return true
  '''
[operator.oSET_GRID_HEIGHT] 
  impl='''
     if (!s.pop(v[0])) return false;     // get h
     h.mGridSize[1] = (ASCII) v[0];
     return true
  '''

[operator.oGET_GRID_WIDTH] 
  doc='return [... GRIDWIDTHOR0]'
  impl='return s.push((Int) h.mGridSize[0])'

[operator.oGET_GRID_HEIGHT] 
  doc='return [... GRIDHEIGHTOR0]'
  impl='return s.push((Int) h.mGridSize[1])'

[operator.oGET_DEST_EXISTS] 
  doc='return [... DESTTORF]'
  impl='return s.push(h.mDestinationExists ? 1 : 0)'

[operator.oSET_DEST_EXISTS] 
  doc='take [... DESTEXISTSNZ ]'
  impl='''
     if (!s.pop(v[0])) return false;     // get bool
     h.mDestinationExists = (v[0] != 0);
     return true
'''

[operator.oGET_DEST_X] 
  doc='return [... DESTXOR255]'
  impl='return s.push((Int) (h.mDestinationExists ? h.mDestination[0] : ASCII.maxof))'

[operator.oGET_DEST_Y] 
  doc='return [... DESTYOR255]'
  impl='return s.push((Int) (h.mDestinationExists ? h.mDestination[1] : ASCII.maxof))'

[operator.oSET_DEST_X] 
  doc='take [... DESTX]'
  impl='''
     if (!s.pop(v[0])) return false;     // get bool
     h.mDestination[0] = (ASCII) v[0];
     return true
'''

[operator.oSET_DEST_Y] 
  doc='return [... DESTY]'
  impl='''
     if (!s.pop(v[0])) return false;     // get bool
     h.mDestination[1] = (ASCII) v[0];
     return true
'''

# Fri Mar 28 02:44:51 2025 Expose more LOCZ
[operator.oRED_WARNING_TRACK]
  impl='return s.push(l.mWarningTrack)'
[operator.oRED_PRE_WARNING]
  impl='return s.push(l.mPreWarning)'
[operator.oGREEN_LEVEL]
  impl='return s.push(l.mGreenLevel)'

[operator.oCMP_EQ]           # : { outs[0] = ins[0] == ins[1] ? 1 : 0; return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] == v[1])'
[operator.oCMP_NE]           # : { outs[0] = ins[0] != ins[1] ? 1 : 0; return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] != v[1])'
[operator.oCMP_LT]           # : { outs[0] = ins[0] <  ins[1] ? 1 : 0; return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] < v[1])'
[operator.oCMP_LE]           # : { outs[0] = ins[0] <= ins[1] ? 1 : 0; return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] <= v[1])'
[operator.oCMP_GT]           # : { outs[0] = ins[0] >  ins[1] ? 1 : 0; return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] > v[1])'
[operator.oCMP_GE]           # : { outs[0] = ins[0] >= ins[1] ? 1 : 0; return true; }
  impl='return /*s.pRStack("IN oCMP_GE") &&*/ s.pop(v[1]) && s.pop(v[0]) && s.push(v[0] >= v[1]) /*&& s.pRStack("OUT oCMP_GE")*/ '
[operator.oMAX]           # : { outs[0] = max(ins[0],ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(max(v[0],v[1]))'
[operator.oMIN]           # : { outs[0] = min(ins[0],ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(min(v[0],v[1]))'
[operator.oADD]           # : { outs[0] = s.clampImmed(ins[0]+ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]+v[1]))'
[operator.oSUB]           # : { outs[0] = s.clampImmed(ins[0]-ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]-v[1]))'
[operator.oMUL]           # : { outs[0] = s.clampImmed(ins[0]*ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) && s.push(s.clampImmed(v[0]*v[1]))'
[operator.oDIV]           # : {
  impl='return s.pop(v[1]) && s.pop(v[0]) && v[1] != 0 &&s.push(s.clampImmed(v[0]/v[1]))'
[operator.oAND]           # : { outs[0] = min(ins[0],ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) &&s.push(v[0] != 0 && v[1] != 0 ? 1 : 0)'
[operator.oOR]           # : { outs[0] = max(ins[0],ins[1]); return true; }
  impl='return s.pop(v[1]) && s.pop(v[0]) &&s.push(v[0] != 0 || v[1] != 0 ? 1 : 0)'
[operator.oNOT]           # : { outs[0] = ins[0] == 0 ? 1 : 0; return true; }
  impl='return s.pop(v[0]) && s.push(v[0] == 0 ? 1 : 0)'
[operator.oNEG]           # : { outs[0] = -ins[0]; return true; }
  impl='return s.pop(v[0]) && s.push(s.clampImmed(-v[0]))'

[operator.oSET_DEBUG]
  impl='''
     //if (!s.pRStack("SET_DEBUG")) return false;
     if (!s.pop(v[0])) return false;
     s.setDebugOutputEnabled(v[0]!=0);
     l.setDebugOutputEnabled(v[0]!=0);
     g.setDebugOutputEnabled(v[0]!=0);
     return true
'''
