[Config]

[trakt.tTOUCH_RED]  # "ALLRED" meaning 255x3 on front grey sensors
  mSpeedMin = 4
  mSpeedMax = 8
  mSetTimerTo = 1
  mLeftEyePos = -60
  mRightEyePos = -60
  mDoneFunc = fTIME_OR_ALLRED

[trakt.tDONT_TOUCH_RED]  # "ALLRED" meaning 255x3 on front grey sensors
  mSpeedLeft = -2        # use direct speed control since ALLRED aint tock or tick
  mSpeedRight = -2
  mSetTimerTo = 1
  mLeftEyePos = -60
  mRightEyePos = -60
  mDoneFunc = fTIME_OR_NOTALLRED

[function.fTIME_OR_NOTALLRED]
  code=[ oENTER0,                               
         oINCR_SMTIMER, aDONE, oGOTON,   # done if time expired
         oALLRED, aDONE, oGOTOZ,         # done if allred is 0
         0, oRETURN1,                    # else not done
        lDONE,
         1, oRETURN1
       ]

[function.fTIME_OR_ALLRED]
  code=[ oENTER0,                               
         oINCR_SMTIMER, aDONE, oGOTON,   # done if time expired
         oALLRED, aDONE, oGOTON,         # done if allred
         0, oRETURN1,                    # else not done
        lDONE,
         1, oRETURN1
       ]


[trakt.tDRIVE_AWHILE]
  mSpeedLeft = 16
  mSpeedRight = 20
  mSetTimerTo = 2
  mLeftEyePos = 0
  mRightEyePos = 0
  mDoneFunc = fTIME_OR_GREEN

[operator.oRAND_BETWEEN]
  impl=''' // stack is [... LO HI ]
      if (!s.pop(v[0])) return false;   // v[0] <- HI or fail, stack [ ... LO ]
      if (!s.pop(v[1])) return false;   // v[1] <- LO or fail, stack [ ... ]
      {
        Random random;
        v[2] = (Int) random.between(v[1],v[0]);
      }
      if (!s.push(v[2])) return false;  // stack [ ... RAND# ]
      return true
'''

[operator.oIS_EVENT_AN_EDGE]
  impl=''' // EVENT OPERATOR
      // stack is [ stuff.. ]
      return
        s.push((e == cTKTR_FRONT_TICK ||
                e == cTKTR_FRONT_TOCK ||
                e == cTKTR_REAR_TICK ||
                e == cTKTR_REAR_TOCK) ? 1 : 0)  // stack [ stuff.. EVENTISEDGE ]
'''

[trakt.tBLOCK_FOR_SMTIMER]
  mSpeedLeft = 0
  mSpeedRight = 0
  mSetTimerTo = 6
  mDoneFunc = fINCR_TIMER_CHECK

[function.fEAST_AND_ON_LINE]
  code=[ oENTER0,
         oGREEN_LEVEL, 2, oCMP_GE,
         fCLOK_EDGE_FRONT, oCALL0,
         oAND,
         oRETURN1
       ]

# [function.fDO_TRAKT]
#   doc="run a trakt and wait till it's done"
#   code=[ oENTER1,          # stack [... TN ]
#          oSTART_TRAKT,     # stack [...]
#          oWAIT_READY,     
#          oRETURN0
#        ]

[operator.oGET_GSCOUNTER]
  impl='''
      // stack is [ ... ]
      v[0] = (Int) l.mGeneralStateCounter;    // v[0] <- general state counter
      /*mD&&*/s.pRStack("oGET_GSCOUNTER=")&&pR(v[0]);  // DEBUG
      if (!s.push(v[0])) return false;  // stack [ ..., GSCOUNTER ]
      return true
'''

[operator.oDECR_GSCOUNTER]
  impl='''
      // stack is [ ... ]
      v[0] = (Int) --l.mGeneralStateCounter;    // v[0] <- --general state counter
      /*mD&&*/s.pRStack("oDECR_GSCOUNTER=")&&pR(l);  // DEBUG
      if (!s.push(v[0])) return false;  // stack [ ..., GSCOUNTER ]
      return true
'''

[operator.oSET_GSCOUNTER]
  impl='''
      // stack is [ ..., NEWGSCOUNTER ]
      if (!s.pop(v[0])) return false;   // v[0] <- NEWGS or fail, stack [ ... ]
      if (v[0] < 0) return false;       // Need non-neg!
      l.mGeneralStateCounter = (LOCZ.GSCounter) v[0];
      /*mD&&*/s.pRStack("oSET_GSCOUNTER=")&&pR(l);  // DEBUG
      return true
'''

[function.fTIMER_DONE]
  code=[ oENTER0, oIS_SMTIMER_DONE, oRETURN1 ]

[function.fINCR_TIMER_CHECK]
  code=[ oENTER0, oINCR_SMTIMER, oRETURN1 ]

[function.fTIME_OR_GREEN]
  code=[ oENTER0,                       # [... ]
         oINCR_SMTIMER,                 # [... 0/1 ]
         oGREEN_LEVEL, 2, oCMP_GE,      # [... 0/1 g>2 ]
         oOR,                           # [... time-or-green ]
         oRETURN1
       ]

[operator.oSET_SMTIMER]
  impl='''
      // stack is [ ..., COUNT ]
      if (!s.pop(v[0])) return false;   // v[0] <- COUNT or fail, stack [ ... ]
      mD&&s.pRStack("oSET_SMTIMER10=")&&pR(v[0]);  // DEBUG
      if (v[0] < 0) return false;       // Need non-neg!
      g.setSMTimer((Unsigned) v[0]);
      return true
'''

[operator.oGET_SMTIMER]
  impl='''
      // stack is [ stuff.. ]
      v[0] = (Int) g.getSMTimer();    // v[0] <- SMCOUNTER
      mD&&s.pRStack("oGET_SMTIMER10=")&&pR(v[0]);  // DEBUG
      if (!s.push(v[0])) return false;  // stack [ SMCOUNTER, stuff.. ]
      return true
'''

[operator.oIS_SMTIMER_DONE]
  impl='''
      // stack is [ stuff.. ]
      return s.push(g.isSMTimerDone() ? 1 : 0)  // stack [ SMTIMERDONE, stuff.. ]
'''

[operator.oINCR_SMTIMER]
  impl='''
      // stack is [ stuff.. ]
      return s.push(g.incrSMTimer() ? 1 : 0) /*&& s.pRStack("oINSMT")*/ // stack [ SMTIMERDONE, stuff.. ]
'''

[trakt.tFIND_LINE_LEFT]
  mSpeedLeft = 1 
  mSpeedRight = 3
  mLeftEyePos = 2
  mRightEyePos = -2
  mDoneFunc = fCLOK_EDGE_FRONT
  
[trakt.tFIND_LINE_RIGHT]
  mSpeedLeft = 3
  mSpeedRight = 1
  mLeftEyePos = -2
  mRightEyePos = 2
  mDoneFunc = fCLOK_EDGE_FRONT

[trakt.tTUNE_LINE]
  mSpeedMin = 1
  mSpeedMax = 2
  mLeftEyePos = -2
  mRightEyePos = -2
  mDoneFunc = fCLOK_EDGE_TUNED

[trakt.tDRESS_LINE_FWD]
  mSpeedMin = 1
  mSpeedMax = 4
  mLeftEyePos = -2
  mRightEyePos = -2
  mDoneFunc = fSAME_EDGE

[trakt.tFAST_DRESS_LINE_FWD]
