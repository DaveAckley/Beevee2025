[trakt.tFULL_STOP]
  mSpeedMin = 0
  mSpeedMax = 0
  mLeftEyePos = -3
  mRightEyePos = -3
  mDoneFunc = fSTOPPED

[trakt.tROLLING_STOP]
  mSpeedMin = 1
  mSpeedMax = 4
  mLeftEyePos = 2
  mRightEyePos = 2
  mDoneFunc = fROLLING_STOPPED

[trakt.tDRIVE_SLOW]
  mSpeedMin = 8
  mSpeedMax = 20
  mDoneFunc = fSTOP_DRIVE_SLOW
  mEventFunction = fEF_COUNT_TILE

[function.fEF_COUNT_TILE]
   doc="EVENT FUNCTION: increment pos on front tick/tock events"
   code=[ oENTER0,
          1, oSET_DEBUG,   # leave debugging off for now
          oIS_EVENT_FRONT_EDGE,
          aDONE, oGOTOZ,
          oINCR_POS,
        lDONE,
          0, oSET_DEBUG,
          oRETURN0 ]

[operator.oIS_EVENT_FRONT_EDGE]
  impl=''' // EVENT OPERATOR
      // stack is [ stuff.. ]
      return
        s.push((e == cTKTR_FRONT_TICK ||
                e == cTKTR_FRONT_TOCK) ? 1 : 0)  // stack [ stuff.. EVENTISFRONTEDGE ]
'''



[trakt.tDRIVE_FAST]
  mSpeedMin = 8
  mSpeedMax = 50
  mDoneFunc = fSTOP_DRIVE_FAST

[trakt.tFORWARD_TO_TICK]
  mSpeedMin = 4
  mSpeedMax = 50
  mDoneFunc = fCLOK_TICK_FRONT

[trakt.tFORWARD_TO_TOCK]
  mSpeedMin = 4
  mSpeedMax = 30
  mDoneFunc = fCLOK_TOCK_FRONT

[trakt.tEMERGENCY_STOP]
  mSpeedMin = 0
  mSpeedMax = 0
  mLeftEyePos = -4
  mRightEyePos = -4
  mDoneFunc = fSTOPPED

[function.fTRUE]
  doc="always true"
  code = [ oENTER0, 1, oRETURN1 ]

[function.fFALSE]
  doc="always false"
  code = [ oENTER0, 0, oRETURN1 ]

[function.fOFFLINE_FRONT]
  doc="true on front not tick and not tock"
  code = [ oENTER0, oCLOK_FRONT, cCLOK_NONE, oCMP_EQ, oRETURN1 ]

[function.fHARD_OFFLINE_FRONT]
  doc="true on front not tick and not tock for quite a consecutive while"
  code = [ oENTER0, oHARD_OFFLINE_FRONT, oRETURN1 ]

[function.fCLOK_TICK_FRONT]
  doc="true on front tick"
  code = [ oENTER0, oCLOK_FRONT, cCLOK_TICK, oCMP_EQ, oRETURN1 ]

[function.fCLOK_TOCK_FRONT]
  doc="true on front tock"
  code = [ oENTER0, oCLOK_FRONT, cCLOK_TOCK, oCMP_EQ, oRETURN1 ]

[function.fCLOK_EDGE_FRONT]
  doc="true on front tick or front tock"
  code = [ oENTER0, oCLOK_FRONT, cCLOK_NONE, oCMP_NE, oRETURN1 ]

[function.fCLOK_EDGE_REAR]
  doc="true on rear tick or rear tock"
  code = [ oENTER0, oCLOK_REAR, cCLOK_NONE, oCMP_NE, oRETURN1 ]

[function.fSMALL_GREY_DEV]
  doc="true on small deviation, meaning 128+-25 == 103..153"
  code = [ oENTER0, oGREY_FCTR, oDUP, 153, oCMP_LE, oSWAP, 103, oCMP_GE, oAND, oRETURN1 ]

[function.fCLOK_EDGE_TUNED]
  doc="true on front edge and small deviation"
  code = [ oENTER0, fCLOK_EDGE_FRONT, oCALL0, fSMALL_GREY_DEV, oCALL0, oAND, oRETURN1 ]

[function.fSAME_EDGE]
  doc="true if front and back on tick or tock"
  code = [ oENTER0, fCLOK_EDGE_FRONT, oCALL0, oCLOK_REAR, oCLOK_FRONT, oCMP_EQ, oAND, oRETURN1 ]

[function.fDIFF_EDGE]
  doc="true if front and back on tick and tock or tock and tick"
  code = [ oENTER0, fCLOK_EDGE_FRONT, oCALL0, fCLOK_EDGE_REAR, oCALL0, oAND, oCLOK_REAR, oCLOK_FRONT, oCMP_NE, oAND, oRETURN1 ]

[function.fSTOPPED]
  doc="true if valid speed is 0"
  code = [ oENTER0, oVALID_SPEED, oCUR_SPEED, 0, oCMP_EQ, oAND, oRETURN1 ]

[function.fROLLING_STOPPED]
  doc="true if over an edge and valid speed is at most 4"
  code = [ oENTER0, fDIFF_EDGE, oCALL0, oVALID_SPEED, oAND, oCUR_SPEED, 4, oCMP_LE, oAND, oRETURN1 ]

[function.fSTOP_DRIVE_SLOW]
  doc="done if hard offline, or red warning"
  code = [ oENTER0, oHARD_OFFLINE_FRONT, oRED_WARNING_TRACK, oOR, oRETURN1 ]

[function.fSTOP_DRIVE_FAST]
  doc="done if hard offline, or red prewarning, or red warning"
  code = [ oENTER0, fSTOP_DRIVE_SLOW, oCALL0, oRED_PRE_WARNING, oOR, oRETURN1 ]

