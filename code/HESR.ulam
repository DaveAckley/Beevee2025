/** Hidden eyestalk position receiver
   \symbol EY
   \color #08d
 */
@Concrete
element HESR : TermHiddenIO + CodeConstants {
  Bool mResetRequested = false;
  
  typedef FixedPoint(20,10) Frac;
  Frac mAvgEyePos[2];  //< 0 : MLEY, 1 : MREY

  Void updateFrac(Frac & avg, Int val) {
    avg = avg*Frac.instanceof(7,8) + Frac.instanceof(val,8);
  }

  Int getMaxDev() { // Farthest from zero
    Int p0 = mAvgEyePos[0].abs().randomRound();
    Int p1 = mAvgEyePos[1].abs().randomRound();
    if (p0 > p1) return p0;
    return p1;
  }

  Bool sendSignals() {
    EventWindow ew;
    SN xbsn = findXBlockSN();
    if (!ew.isAccessible(xbsn)) return false;

    Bool ret = true;
    Atom & axb = ew[xbsn];
    XBlock & xb = (XBlock&) axb;
    FourWaySlots & fws = (FourWaySlots&) axb;

    AxialDir ad = sn2AxialDir(xbsn);
    SlotSig & oss = fws.getSlotSig(ad);
    if (oss.isOccupied()) return true;

    Int dev = getMaxDev();
    ASCII val = intToSignedAscii(dev);
    oss.setOccupied(val,BeeveeBIMXBlock.cTAPIDX_HESR);

    return true;
  }

  Bool recvSignals() {
    mD&&pR("HNFRC10");
    EventWindow ew;

    Bool ret = true;

    mD&&pR("HNFRC12")&&pR(ret);

    /// RECV A SIGNAL IF WE CAN
    {
      SN axonsn = findMatchingAxonEnd(true); // look for inbound from MxEY
      if (ew.isAccessible(axonsn)) {
        mD&&pR("HESCR10")&&pR(axonsn);
        Atom & ae = ew[axonsn];
        if (ae as AxonEnd) {
          SlotSig iss;
          if (tryRecvSig(ae, iss)) {
            mD&&pR("HESCR11 DO SOMETHING")&&pR(iss);
            Int val = signedAsciiToInt(iss.mValue);
            if (iss.mSource == BeeveeBIMXBlock.cTAPIDX_MLEY) {
              updateFrac(mAvgEyePos[0],val);
            } else if (iss.mSource == BeeveeBIMXBlock.cTAPIDX_MREY) {
              updateFrac(mAvgEyePos[1],val);
            } else {
              pR("HESCR12WHATWHAT")&&pR(iss);
            }
          }
        }
      }
    }

    mD&&pR("HNFRC16")&&pR(ret);
    return ret;
  }
  @Override Void behave() {
    mD&&pR("HESRBEHAVE10");

    if (!recvSignals()) {
      mD&&pR("IN SIGNALING FAILED");
      return;
    }

    if (!sendSignals()) {
      mD&&pR("OUT SIGNALING FAILED");
      return;
    }

    /// AND DO NORMAL BUSINESS
    mD&&pR("HESRBEHAVE12");

    return super.behave();
  }

  /*
  Bool maybeMakeRandomSignal(ASCII & val) {
    Random random;
    if (random.oddsOf(4,5)) return false;
    EyePacket p;
    Bool doleft = random.oneIn(2u);
    p.mSignal.mSigFmt = doleft ? EyeSignal.cISIGFMT_LEYE : EyeSignal.cISIGFMT_REYE;
    p.mSignal.mSigData = (EyeSignal.ISigData) mLastKnownEyePos[doleft ? 0 : 1];
    val = p.mData;
    mD&&pR("MMRSG11")&&pR(doleft)&&pR(p)&&pR(val);
    return true; 
  }
  */

  @Override RouteDir getHiddenRouteDir(XBlock & gs) {
    return cNONE_TO_NONE;
  }

}
