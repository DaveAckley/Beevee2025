  Bool mapio(Int vl, Int vc, Int vr, Int & trackingError) {  //< trackingError set in -32..32 (now) I think
    Bool old = mD;
    //mD = true;

    mD&&pR("TRAKTKMPO10")&&pR(vl)&&pR(vc)&&pR(vr);

    Unsigned dd = abs(vl-vr);    // dist btwn left and right
    Unsigned ld = abs(vl-vc);    // dist btwn left and center
    Unsigned rd = abs(vr-vc);    // dist btwn right and center

    mD&&pR("TKMPO11")&&pR(dd)&&pR(ld)&&pR(rd);

    // trackingError: >0 center too left (rd too big), <0 center too right (ld too big)
    //   dividing by eight to reduce max from 256ish to 32ish, to help fixed point
    trackingError = ((Int) rd - (Int) ld)/8;
    Unsigned ac = abs(trackingError);
    Bool valid;
   
    mD&&pR("TKMPO12")&&pR(trackingError)&&pR(ac)&&pR(valid);

    constant Unsigned cTHRESH = 200u;
    if (dd < cTHRESH) {          // CASE: L+R are similar (so not tracking)
      valid = false;
      mD&&pR("TKMPO13")&&pR(trackingError)&&pR(valid);
    } else {
      valid = true;
      mD&&pR("TKMPO14")&&pR(trackingError)&&pR(valid);
    }
   
    mD&&pR("TKMPO17")&&pR(trackingError)&&pR(valid);
    mD = old;

    return valid;
  }

  Bool maybeSendRedSignal() {
    SlotSig & sl = getSlotSig(0u);
    SlotSig & sc = getSlotSig(1u);
    SlotSig & sr = getSlotSig(2u);
    mD&&pR("MBESRS10")&&pR(self);

    if (!sl.isOccupied() || !sc.isOccupied() || !sr.isOccupied())
      return false;

    Unsigned vl = sl.getValueRaw();
    Unsigned vc = sc.getValueRaw();
    Unsigned vr = sr.getValueRaw();
    Bool allRedGrey =
      vl == ASCII.maxof &&
      vc == ASCII.maxof &&
      vr == ASCII.maxof;

    Random random;
    Bool sendIt = (mLastAllRedSigTrue != allRedGrey) || random.oneIn(8);
    ASCII val = allRedGrey ? 1u : 0u;
    if (sendIt) {
      Bool sent = trySendSig(val,GTCC.classidof);
      if (sent) 
        mLastAllRedSigTrue = allRedGrey;
      /*mD&&*/pR(allRedGrey ? "MBESRS11 TRUE" : "MBESRS11 FALSE");
    }
    return false;
  }


  Bool executeTRACK(Unsigned gripnum, GripInfoMap & gim, GripInfo & gin, XBlock & xb, TRAKPD & pd) {
    SlotSig & sl = getSlotSig(0u);
    SlotSig & sc = getSlotSig(1u);
    SlotSig & sr = getSlotSig(2u);
    mD&&pR("EXTRCK10")&&pR(self);

    if (!sl.isOccupied() || !sc.isOccupied() || !sr.isOccupied())
      return false; // ??

    Int vl = (Int) sl.getValueRaw();
    Int vc = (Int) sc.getValueRaw();
    Int vr = (Int) sr.getValueRaw();

    mD&&pR("EXTRCK11");

    constant Int cMAX_ERR = 2*32; // let's say full +- range, not abs(err)..
    //Sat Feb  1 12:13:56 2025     constant Int cMAX_CAL_SPEED = 3;  // max for calibration purposes
    //Sat Mar  1 22:02:34 2025 constant Int cMAX_CAL_SPEED = 4;  // bigger for harder corrections
    // constant Int cMAX_CAL_SPEED = 5;  // bigger for harder corrections
    //FPErr maxerror(cMAX_ERR);
    //FPErr maxcalspeed(9,2); // ==4.5 Sun Mar  2 00:43:51 2025 Let's split the difference. 

    FPErr minfp500 = FPErr.instanceof(0).getMin(); // used as a flag only

    // Sun Mar  2 12:27:54 2025 Tuning attempt #1,000,000,000,004
    //    FPErr kP( 6,128);           // ~.047
    FPErr kP( 5,128);           // ~.039
    FPErr kI( 1,128);           // ~.008
    //    FPErr kD(24,128);           // ~.188
    FPErr kD(50,128);           // ~.391

    Int trackingError = 0;
    Bool inputsValid = mapio(vl,vc,vr,trackingError);

    if (inputsValid) pd.maybeForwardGrey(vl,vc,vr);

    FPErr rawerr(trackingError);     // -32..32
    FPErr abserr(rawerr.abs());      // abserr in sensor error space
    mD&&pR("EXTRCK12")&&pR(trackingError)&&pR(inputsValid)&&pR(rawerr)&&pR(abserr);

    FPErr lasterr = pd.getLastError();
    FPErr integralerr = pd.getIntegralError();

    mD&&pR("EXTRCK13")&&pR(lasterr)&&pR(integralerr);
    if (inputsValid) {
      if (lasterr == minfp500) {   // if 'previously invalid' flag
        lasterr = rawerr;          // just use current error now
        pd.setLastError(rawerr);   // and remember that for next time
        mD&&pR("EXTRCK14")&&pR(pd);
        //pd.setIntegralError(FPErr.instanceof(0)); // and leave the integral alone
      } else {
        pd.updateError(rawerr,100u); // update last error for next time when running valid
        FPErr scalederr(rawerr);
        // Sat Mar  1 22:50:31 2025 let's drive harder.. vs:
        // Sun Mar  2 14:39:42 2025 nah let's not
        scalederr /= FPErr.instanceof(32);      // make error integration range -1 -> 1
        //        scalederr /= FPErr.instanceof(64);      // make error integration range -0.5 -> 0.5
        //scalederr /= FPErr.instanceof(10);      // make error integration range -3.2 -> 3.2
        // scalederr /= FPErr.instanceof(8);      // make error integration range -4 -> 4
        // scalederr /= FPErr.instanceof(6);      // make error integration range -5.3 -> 5.3
        integralerr = integralerr + scalederr;
        // FPErr maxIntErr(32), minIntErr(-32); let's way reduce windup
        // FPErr maxIntErr(10), minIntErr(-10);
        constant Int cINTEGRAL_ERROR_RANGE = 5;
        FPErr maxIntErr(cINTEGRAL_ERROR_RANGE), minIntErr(-cINTEGRAL_ERROR_RANGE);
        if (integralerr > maxIntErr) integralerr = maxIntErr;
        else if (integralerr < minIntErr) integralerr = minIntErr;

        pd.setIntegralError(integralerr);
        mD&&pR("EXTRCK15")&&pR(pd)&&pR(scalederr)&&pR(integralerr);
      }
    } else {
      pd.setLastError(minfp500);   // flag invalid inputs for next time
      lasterr = rawerr;          // and use current error for now
      mD&&pR("EXTRCK16")&&pR(pd);
    }
    
    mD&&pR("EXTRCK17")&&pR(lasterr);
    FPErr adj = kP*rawerr + kI*integralerr + kD*(rawerr - lasterr); // adj in motor speed space
    constant Int cMAX_ADJ_NUM = 25;
    constant Int cMAX_ADJ_DEN = 10;  // 2.5  -> +-5 max swing

    FPErr maxAdj(cMAX_ADJ_NUM,cMAX_ADJ_DEN), minAdj(-cMAX_ADJ_NUM,cMAX_ADJ_DEN);
    if (adj > maxAdj) adj = maxAdj;
    else if (adj < minAdj) adj = minAdj;

    Int curMinTargetSpeed = pd.mTargetMinSpeed.randomRound();
    Int curMaxTargetSpeed = max(curMinTargetSpeed,pd.mTargetMaxSpeed.randomRound());
    //   if (curTargetSpeed > targetSpeed) ++targetSpeed;
    //   else if (curTargetSpeed < targetSpeed) --targetSpeed;
   
    FPErr curspeed(mSpeed);
    mD&&pR("EXTRCK18")&&pR(curMinTargetSpeed)&&pR(curMaxTargetSpeed)&&pR(pd);

    //   FPErr curtarget(targetSpeed);

    if (true) {
      ByteStreamLogger log;
      log.print("IV"); log.print(inputsValid); log.print(" ");
      if (inputsValid) {
        log.print("kP:"); kP.printTo(log); log.print(" ");
        log.print("kI:"); kI.printTo(log); log.print(" ");
        log.print("kD:"); kD.printTo(log); log.print(" ");
        //   log.print("TS:"); curtarget.printTo(log); log.print(" ");
        log.print("RE:"); rawerr.printTo(log); log.print(" ");
        log.print("IE:"); integralerr.printTo(log); log.print(" ");
        log.print("LE:"); lasterr.printTo(log); log.print(" ");
      }
      log.print("AJ:"); adj.printTo(log); log.print(" ");
      log.print("CS:"); curspeed.printTo(log); log.print(" ");
      log.print("CG:"); log.print(vc); log.print(" ");
      log.print("\n");
    }

    FPErr target[2];
    Bool smallErr = inputsValid && (abserr < FPErr.instanceof(12));

    mD&&pR("EXTRCK19")&&pR(smallErr);

    Bool goright = false;
    if (mTurnState == cTURN_STATE_LEFT || (goright = (mTurnState == cTURN_STATE_RIGHT))) {
      mD&&pR("EXTRCK210")&&pR(mTurnCounter);
      if (--mTurnCounter == mTurnCounter.minof) {
        mTurnState = cTURN_STATE_WAIT;
        mTurnCounter = mTurnCounter.maxof;
      } else {
        adj = goright ? -8 : +8;
      }
      curspeed = 4;
      target[0] = curspeed + adj;
      target[1] = curspeed - adj;
      mD&&pR("EXTRCK211")&&pR(target[0])&&pR(target[1]);
    } else {
      Bool doRandom = true;
      mD&&pR("EXTRCK212")&&pR(mTurnState);
      if (mTurnState == cTURN_STATE_WAIT) {
        doRandom = false;
        if (random.oneIn(3u) &&  // slow the count..
            --mTurnCounter == mTurnCounter.minof) 
          mTurnState = cTURN_STATE_IDLE;
      }
      mD&&pR("EXTRCK213")&&pR(mTurnState);
      
      // stay in bounds whether inputs valid or not
      mD&&pR("EXTRCK214")&&pR(mSpeed)&&pR(curMaxTargetSpeed)&&pR(curMinTargetSpeed);
      if (mSpeed > curMaxTargetSpeed) --mSpeed;
      else if (mSpeed < curMinTargetSpeed) ++mSpeed;

      mD&&pR("EXTRCK215")&&pR(mSpeed);
      constant Unsigned cSPEED_UP_ODDS = 10u;
      constant Unsigned cSLOW_DOWN_ODDS = cSPEED_UP_ODDS/2u; // twice as quick to slow down vs speed up
      
      if (inputsValid) {
        //       if (mSpeed < cTRACKING_SPEED && smallErr && random.oneIn(30u)) ++mSpeed;
        // if (mSpeed < curMaxTargetSpeed && smallErr && random.oneIn(5u)) ++mSpeed;
        if (mSpeed < curMaxTargetSpeed && smallErr && random.oneIn(cSPEED_UP_ODDS)) ++mSpeed; // don't speed up too fast or wheels won't stick
        target[0] = curspeed + adj;
        target[1] = curspeed - adj;
        mD&&pR("EXTRCK216")&&pR(mSpeed)&&pR(curspeed)&&pR(adj);
      } else {
        // XXX DO NOT GET DISTRACTED FOR NOW..
        if (false && doRandom && random.oneIn(15u)) { // maybe get distracted when not tracking
          Int choice = random.between(-1,1);
          if (choice == 0) 
            tryChangeGripNumber(random.oneIn(2u) ?
                                GripInfoMap.GripInfoMap.cGRIP_BV2BY :
                                GripInfoMap.GripInfoMap.cGRIP_NORED);
          else {
            mTurnCounter = mTurnCounter.maxof;
            mTurnState = (choice > 0) ? cTURN_STATE_LEFT : cTURN_STATE_RIGHT;
          }
          mD&&pR("EXTRCK217")&&pR(mTurnCounter)&&pR(mTurnState);
          return false;
        } else {
          if (!smallErr && random.oneIn(cSLOW_DOWN_ODDS)) 
            mSpeed  = (MySpeed) max(curMinTargetSpeed,mSpeed-1u);
          mD&&pR("EXTRCK218")&&pR(mSpeed)&&pR(curMinTargetSpeed);
          FPErr amt(curMinTargetSpeed,2); // half min?
          target[0] = curspeed+amt;
          target[1] = curspeed-amt;
          mD&&pR("EXTRCK219")&&pR(amt)&&pR(target[0])&&pR(target[1]);
        }
      }
    }
    ASCII lsb = intToSignedAscii(target[0].randomRound());
    ASCII rsb = intToSignedAscii(target[1].randomRound());
    mD&&pR("EXTRCK220")&&pR(lsb)&&pR(rsb);

    {
      Bool old = mD;
      //mD = true;
      mD&&pR("TKEX10")&&pR(inputsValid)&&pR(trackingError)&&pR(mSpeed)
        &&pR("TKEX11")&&pR(target[0])&&pR(target[1])&&pR(lsb)&&pR(rsb);
      mD = old;
    }
   
    driveBothMotors(lsb, rsb);

    //mSpeed = (MySpeed) curtarget.randomRound(); // XXX
    mD&&pR("EXTRCK221")&&pR(self);
    return false;
  }

  Void driveBothMotors(ASCII left, ASCII right) {
    SN axonsnL = findMatchingAxonEndWithClassId(MLRF.classidof);
    SN axonsnR = findMatchingAxonEndWithClassId(MRRF.classidof);
    if (axonsnL != SN.maxof && axonsnR != SN.maxof) { // special checks if both axons in
      AxonEnd & axonL = (AxonEnd&) ew[axonsnL];
      SlotSig & osL = axonL.getEndSlotSig(false); // get outbound
      if (osL.isOccupied()) return;               // don't ship either..

      AxonEnd & axonR = (AxonEnd&) ew[axonsnR];
      SlotSig & osR = axonR.getEndSlotSig(false); // get outbound
      if (osR.isOccupied()) return;               // ..unless both can ship
    }
    trySendSig(left,MLRF.classidof);
    trySendSig(right,MRRF.classidof);
    trySendSig(makeSpeedSig(),LOCZ.classidof);
  }

  ASCII makeSpeedSig() {
    LOCZPacket p;
    p.mSignal.mSigFmt = LOCZSignal.cSIGFMT_CSP8;
    p.mSignal.mSigData.mData = (LOCZSigData.Data) (mSpeed+8);
    return p.mData;
  }

  Void tryChangeGripNumber(Unsigned newgripnum) {
    EventWindow ew;
    MinXPick emptypick;         // Look for an empty
    for (SN sn = 1u; sn < 41u; ++sn) {
      if (!ew.isAccessible(sn)) continue;
      if (!(ew[sn] is Empty)) continue;
      C2D csn = ew.getCoord(sn);
      emptypick.update(sn,csn.length());
    }
    if (emptypick.hasPick()) {
      setGripNumber(newgripnum);
      SendGrip sg(newgripnum);
      SN esn = emptypick.getIdxSN();
      ew[esn] = sg.atomof;
    }
  }
}

