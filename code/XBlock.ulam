  TapIdx mTaps[4] = { cTAPIDX_NONE }; // [AxialDir] -> [0] W, [1] N, [2] S, [3] E
  SlotSig mSlotSigs[2];

  //// INTENDER API
  virtual ClassId getIntentionClass() { return XBlockState.classidof; }

  //// URSELF API  
  @Override
  Void behave() { pursueIntention(); }
}
*/

/** \color #231
    \symbol K1
*/
element KillXBlock + DTU {
  Void behave() {
    EventWindow ew;
    for (SN sn = 1u; sn <= 8u; ++sn) {
      if (!ew.isAccessible(sn)) continue;
      Atom & a = ew[sn];
      if (a as XBlock) a.setDie();
    }
    ew[0] = Empty.instanceof;
  }
}
