/** TOCK DRIVER. TOCK is a clock driver with internal state for
    counting, sigh.
    \symbol TK
    \color #0ff
 */
element TOCK : TermSensor + Once + Fail {
  constant Unsigned cBITS = 20u;
  typedef Unsigned(cBITS) ClockState;
  ClockState mClockState;
  ClockState incr() {
    if (mClockState == mClockState.maxof)
      mClockState = mClockState.minof;
    else ++mClockState;
    return mClockState;
  }

  EyePacket mEyePosSig[2];
  typedef RXTimer(3u,5u,1u) EyePosTimer;
  EyePosTimer mEyePosTimer;

  Void resetEyePackets() {
    EyePacket p;
    p.mSignal.mSigFmt = EyeSignal.cISIGFMT_LEYE;
    mEyePosSig[0] = p;
    p.mSignal.mSigFmt = EyeSignal.cISIGFMT_REYE;
    mEyePosSig[1] = p;
  }

  Bool getEyestalkSignal(ASCII & val) {
    if (mEyePosTimer.countAlarm()) resetEyePackets();
    Random random;
    Bool sendleft = random.oneIn(2);
    Int idx = sendleft ? 0 : 1;
    val = mEyePosSig[idx].mData;
    return true;
  }

  // 'static' method for GripInfo to call to map getSig values during
  // switching
  ASCII switchSigVal(GripInfo& gi, ASCII rawvalue, ClassId forDest) {
    Bool tumblecw = getSigState(rawvalue,14u);
    Bool sigleft = (forDest == MLRF.classidof);

    Int val;
    val = 25;    // left or right
    return gi.intToSignedAscii(val);
  }

  constant Unsigned cSIG_SHIFT_DIST = 7u;
  ASCII getSig() {
    Bits bits = mClockState;
    return (ASCII) ((bits>>cSIG_SHIFT_DIST)&0x7f); // 0x7f for positive doh
  }

  Bool getSigState(ASCII val, Unsigned idx) {
    return getBitsState(((Bits)val)<<cSIG_SHIFT_DIST, idx);
  }

  Bool getState(Unsigned idx) {
    return getBitsState((Bits) mClockState, idx);
  }

  Bool getBitsState(Bits bits, Unsigned idx) {
    if (idx >= cBITS) return false;
    return 0u != (bits & (1u<<idx));
  }

  @Override Void renderGraphics() {
    Drawable drawable;
    if (!drawable.canDraw()) return;

    ARGB col = getColor(0u);
    Int(16) cSIZE = 1024 + 200;
    drawable.fillRectangle(C2D.instanceof(-cSIZE/2,-cSIZE/2), 
                           C2D.instanceof(cSIZE,cSIZE),
                           col);
  }

  @Override virtual ARGB getColor(Unsigned selector) {
    ARGB ret;
    Bool clockf = getState(4u);
    Bool clockm = getState(7u);
    Bool clocks = getState(11u);

    ColorUtils cu;
    return cu.color(clocks ? 0xdd : 0x00,
                    clockm ? 0xdd : 0x00,
                    clockf ? 0xdd : 0x00);
  } 

  Void maybeForwardEyeStalks() {
    mD&&pR("MYBFES10");

    EventWindow ew;
    SN axonsn = findMatchingAxonEnd(true); // look for inbound from hinfo
    if (!ew.isAccessible(axonsn)) return;  // nope

    mD&&pR("MYBFES11")&&pR(axonsn);
    Atom & a = ew[axonsn];
    if (!a is AxonEnd) return;  // WTF?

    AxonEnd & ae = (AxonEnd&) a;

    AxonIdx aidx = ae.getRemoteAxonIdx();
    TapIdx ti = ae.getAxonTap(aidx);
    mD&&pR("MYBFES12")&&pR(aidx)&&pR(ti);

    if (ti != BeeveeBIMXBlock.cTAPIDX_HINFO) return; // "?
    SlotSig & iss = ae.getEndSlotSig(true); // get inbound slot of axon
    mD&&pR("MYBFES13")&&pR(iss);

    if (iss.isOccupied()) {
      EyePacket p;
      p.mData = iss.mValue;
      iss.reset();

      Unsigned idx;
      if (p.mSignal.mSigFmt == EyeSignal.cISIGFMT_LEYE)
        idx = 0u;
      else if (p.mSignal.mSigFmt == EyeSignal.cISIGFMT_REYE)
        idx = 1u;
      else {
        pR("MYBFES14 UNREC")&&pR(p.mSignal);
        return;
      }
      mEyePosSig[idx] = p;
      mEyePosTimer.reset();
      mD&&pR("MYBFES15 GOTX")&&pR(p)&&pR(idx)&&pR(mEyePosSig[idx]);
    }
  }

  @Override
  Void behave() {
    Random random;
    if (new() || random.oneIn(10000u))
      mClockState = (ClockState) random.bits(cBITS);

    incr();
    mD&&pR("TOCKSNBV10")&&pR(mClockState);

    SN xblocksn = findXBlockSN();
    mD&&pR("TOCKSNBV1010")&&pR(xblocksn);
    if (!ew.isAccessible(xblocksn)) return;

    Atom & a = ew[xblocksn];

    Unsigned gripnum;
    if (a as XBlock) {
      gripnum = a.getGripNumber();
    } else fail(__FILE__,__LINE__);

    mD&&pR("TOCKSNBV11")&&pR(a);
    if (a as FourWaySlots) {
      mD&&pR("TOCKSNBV1110");
      if (true /*a.hasSymmetry() DITCHING SYMMETRY*/) {
        AxialDir adout = sn2AxialDir(xblocksn);
        AxialDir adin = oppositeAxialDir(adout);
        mD&&pR("TOCKSNBV1111")&&pR(adin)&&pR(adout);
        SlotSig & iss = a.getSlotSig(adin); // check incoming to us
        SlotSig & oss = a.getSlotSig(adout); // check outgoing from us
        mD&&pR("TOCKSNBV1112")&&pR(iss)&&pR(oss);
        if (iss.isOccupied()) {
          // OK TO DISCARD HERE IN XBLOCK BECAUSE HINFO ONLY ARRIVES BY AXON
          iss.reset();          // discard input to us
          mD&&pR("TOCKSNBV1113")&&pR(iss)&&pR(oss);
        }
        /// TOCK IS ONLY RESPONSIBLE FOR EYESTALKS WHEN TRACKING!
        if (gripnum == BeeveeGrips.cGRIPIDX_TRACK && !oss.isOccupied()) {
          mD&&pR("TOCKSNBV1114")&&pR(iss);
          BeeveeBIMXBlock bim;
          TapIdx tapidx = bim.getTapIdx(self);

          ASCII val;
          if (getEyestalkSignal(val)) {
            oss.setOccupied(val,tapidx);
            mD&&pR("TOCKSNBV12")&&pR(oss);
          }
        }
      }
    } else {                    // ??
      mD&&pR("TOCKSNBV13");
      ew[0] = Empty.instanceof;
      return;
    }
    mD&&pR("TOCKSNBV14");
    maybeForwardEyeStalks();
  }

}
